  abstract = {The rovibrational spectra of triacetylene (C 6H 2) were recorded for the {$\nu$} 11 band in high resolution by FTIR spectroscopy. The assignments for the hot-band system ( v11, v13) = (1, 1) \textleftarrow{} (0, 1) have been fully revised, and reliable molecular parameters have been determined including the rotational and vibrational l-type doubling constants. The assignments have been confirmed by a simulation of the absorption profile in the Q-branch region. The intensity perturbation caused by the l-type resonance in the ( v11, v13) = (1, 1) state has been observed and discussed.},
  annotation = {ADS Bibcode: 1994JMoSp.167..176H}
