@article{Cernicharo:2024:L13a,
  title = {More Sulphur in {{TMC-1}}: {{Discovery}} of the {{NC}}{\textsubscript{3}}{{S}} and {{HC}}{\textsubscript{3}}{{S}} Radicals with the {{QUIJOTE}} Line Survey},
