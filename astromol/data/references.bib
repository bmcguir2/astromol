@article{Monje:2011:L21,
  title = {Discovery of {{Hydrogen Fluoride}} in the {{Cloverleaf Quasar}} at z = 2.56},
  author = {Monje, R. R. and Phillips, T. G. and Peng, R. and Lis, D. C. and Neufeld, D. A. and Emprechtinger, M.},
  year = 2011,
