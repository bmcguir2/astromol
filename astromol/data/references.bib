  shorttitle = {Millimeter-Wave Spectroscopy of Vibrationally-Excited {{NaCCH}} ( {{X}}{$\sim$} {{1$\Sigma$}}+) and {{MgCCH}} ( {{X}}{$\sim$} {{2$\Sigma$}}+)},
