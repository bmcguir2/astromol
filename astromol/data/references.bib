@article{Johnson:1952:687,
  title = {The {{Microwave Spectrum}} of {{Ketene}}},
  author = {Johnson, H. R. and Strandberg, M. W. P.},
  year = 1952,
  month = apr,
  journal = {Journal of Chemical Physics},
  volume = {20},
  pages = {687--695},
  publisher = {AIP},
  issn = {0021-9606},
  doi = {10.1063/1.1700517},
  urldate = {2025-04-14},
  abstract = {The microwave absorption spectra of the ketene molecules H21C212O16, H1D2C212O16, and D22C212O16 have been investigated. Reciprocal moments of inertia have been determined for each from the measurements. The centrifugal distortion theory of Hillger and Strandberg has been found valid for both Q and R branches. The structure has been calculated and dipole moment measured; results check and extend the accuracy of values previously determined by other methods. Intensities of satellites of the lightest molecule corresponding to the lowest three vibrational fundamentals have also been measured and changes in the average reciprocal moments determined. The vibrational frequencies have been calculated and found different from values reported in the literature by infrared workers. References and suggestions for further work are given.},
  annotation = {ADS Bibcode: 1952JChPh..20..687J}
}

