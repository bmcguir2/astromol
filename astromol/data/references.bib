@article{Kirchhoff:1972:333,
  title = {On the Calculation and Interpretation of Centrifugal Distortion Constants: {{A}} Statistical Basis for Model Testing: {{The}} Calculation of the Force Field},
  shorttitle = {On the Calculation and Interpretation of Centrifugal Distortion Constants},
  author = {Kirchhoff, William H.},
