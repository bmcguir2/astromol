  publisher = {APS},
  issn = {1536-6065},
  doi = {10.1103/PhysRev.98.1837},
  urldate = {2025-04-16},
  abstract = {CS was produced by an electrical discharge through CS2 and continuously flowed through a conventional Stark spectrometer. The J=0--{$>$}1 transitions of the isotopic species C12S32, C12S33, C12S34, and C13S32 were observed in their vibrational ground states. C12S32 was also observed in its first excited vibrational state. The spectra yield the following molecular constants: In Mc/sec, Be(C12S32)=24 584.352+/-0.015, Be(C12S33)=24 381.011+/-0.027, Be(C12S34)=24 190.198+/-0.014, Be(C13S32)=23 205.215+/-0.020, {$\alpha$}(C12S32)=+177.544+/-0.026, eqQ(C12S33)=+12.835+/-0.026, Dipole moment = 1.97 +/-0.02 Debye units, Equilibrium bond distance = 1.5349+/-0.0002 A, Where Be=equilibrium rotational constant, {$\alpha$}=vibration-rotation interaction constant, and eqQ=electric quadrupole coupling constant. The mass ratios calculated from the above Be values are: S32/S34 = 0.941246+/-22, S32/S33=0.9696909+/-32, and C12/C13=0.9228447 +/-20. Nuclear magnetic interactions of S33 were also detected. The coefficient C of the CI.J coupling term was found to have the value 0.019+/-0.015 Mc/sec.},
  annotation = {ADS Bibcode: 1955PhRv...98.1837M}
}

@article{Mohamed:2005:234301,
  title = {Rotational Spectra of the Carbon-Chain Radicals {{HC}}{\textsubscript{5}}{{O}}, {{HC}}{\textsubscript{6}}{{O}}, and {{HC}}{\textsubscript{7}}{{O}}},
