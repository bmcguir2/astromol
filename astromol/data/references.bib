  year = 1986,
  month = mar,
  journal = {Astronomy and Astrophysics},
  volume = {157},
  pages = {L17-L20},
  issn = {0004-6361},
  urldate = {2025-04-14},
  abstract = {The authors report the discovery of a new "non terrestrial" molecule in the envelope of the carbon star IRC +10216. This molecule is linear or slightly asymmetric and must have an odd number of electrons; its electronic ground state is very probably split by spin-rotation interaction, i.e. must be 2{$\Sigma$} if the molecule is linear. The rotation and spin-doubling constants are found to be 5966.8 MHz and \textpm 15.1 MHz, respectively. The most likely candidates for such a radical are HSiCC (or its isomer HCCSi) and HSCC.},
  keywords = {Astrophysics,Carbon Stars,Electron Spin,Extraterrestrial Matter,Free Radicals,Ground State,Infrared Stars,Interstellar Matter,Molecular Clouds,Stellar Composition,Stellar Envelopes},
  annotation = {ADS Bibcode: 1986A\&A...157L..17G},
  file = {/Users/brett/Zotero/storage/R3BWTRQM/Guelin et al. - 1986 - A new free radical in IRC +10216..pdf}
}

@article{Guelin:1990:L9,
