  author = {Xue, Ci and Willis, Eric R. and Loomis, Ryan A. and Kelvin Lee, Kin Long and Burkhardt, Andrew M. and Shingledecker, Christopher N. and Charnley, Steven B. and Cordiner, Martin A. and Kalenskii, Sergei and McCarthy, Michael C. and Herbst, Eric and Remijan, Anthony J. and McGuire, Brett A.},
