@article{McCarthy:1994:L127,
  title = {A {{Millimeter-Wave Study}} and {{Astronomical Search}} for the {{HCCCS Radical}}},
  author = {McCarthy, M. C. and Vrtilek, J. M. and Gottlieb, E. W. and Tao, F. -M. and Gottlieb, C. A. and Thaddeus, P.},
  year = 1994,
  month = aug,
  journal = {The Astrophysical Journal},
  volume = {431},
  pages = {L127},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1086/187489},
  urldate = {2025-04-10},
  abstract = {The HCCCS radical in its (2)Pi electronic ground state has been studied in the millimeter-wave region. The standard Hamiltonian for an isolated (2)Pi state fits the laboratory measurements of more than 65 lines between 70 and 281 GHz to high accuracy and allows the astronomically most interesting lines in the radio spectrum to be predicted to an uncertainty of 0.2 km/sec or better. The identification was confirmed by the detection of DCCCS with constants within 0.2\% to those predicted from HCCCS. Ab initio calculations of HCCCS at the CAS SCF, MP2, MP4, and QCISD levels of theory have also been performed; at the highest level of theory, a bent and a linear isomer are predicted to be within 1.25 kcal/mol in energy. The HCCCS radical may be a good candidate for detection in molecular clouds as well as circumstellar shells, because members of the CnS series are abundant in TMC-1. A search for the (2)Pi1/2 J, F = 2.5, 3 approaches 1.5, 2 transition in TMC-1 indicates that the HCCCS column density is less than, or equal to, that of CCCS.},
  keywords = {Atomic and Molecular Physics,Dipole Moments,Interstellar Space,ISM: MOLECULES,LINE: IDENTIFICATION,MOLECULAR DATA,Molecular Interactions,MOLECULAR PROCESSES,RADIO LINES: ISM,Radio Spectra,Spectrometers,Stellar Magnetic Fields},
  annotation = {ADS Bibcode: 1994ApJ...431L.127M},
  file = {/Users/brett/Zotero/storage/QJFFLZHG/McCarthy et al. - 1994 - A Millimeter-Wave Study and Astronomical Search for the HCCCS Radical.pdf}
}

@article{McCarthy:1996:L31,
  title = {Laboratory Detection of the {{C}}{\textsubscript{8}}{{H}} Radical.},
  author = {McCarthy, M. C. and Travers, M. J. and Kovacs, A. and Gottlieb, C. A. and Thaddeus, P.},
  year = 1996,
  month = may,
  journal = {Astronomy and Astrophysics},
  volume = {309},
  pages = {L31-L33},
  issn = {0004-6361},
  urldate = {2025-04-15},
  abstract = {The C\_8\_H radical has been detected in an argon-acetylene discharge, conclusively confirming the identification by Cernicharo and Guelin in the accompanying Letter of their new linear molecule in IRC+10216. In addition to the ground \textasciicircum 2PI\_3/2\_ rotational ladder, the \textasciicircum 2PI\_1/2\_ ladder 19cm\textasciicircum -1\textasciicircum{} above ground has been detected, and the entire fine structure-rotational spectrum calculated. The standard \textasciicircum 2PI Hamiltonian fits the laboratory measurements of more than 30 radio lines between 80 and 100GHz to high accuracy; yields precise values for the rotational, fine structure, and lambda-doubling constants; and allows the astronomically most interesting lines in the radio spectrum to be predicted to an uncertainty of 0.1km/s or better.},
  keywords = {ISM: MOLECULES,LINE: IDENTIFICATION,MOLECULAR DATA,RADIO LINES: ISM,TECHNIQUES: SPECTROSCOPIC},
  annotation = {ADS Bibcode: 1996A\&A...309L..31M},
  file = {/Users/brett/Zotero/storage/7KYI5XRF/McCarthy et al. - 1996 - Laboratory detection of the C_8_H radical..pdf}
}

