@article{Brown:1985:188,
  title = {The Microwave and Far-Infrared Spectra of the {{SiH}} Radical},
  author = {Brown, J. M. and Curl, R. F. and Evenson, K. M.},
  year = 1985,
  month = may,
  journal = {The Astrophysical Journal},
  volume = {292},
  pages = {188--191},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1086/163145},
  urldate = {2025-04-10},
  abstract = {Consideration of Si's cosmic abundance leads to the expectation that the related molecule SiH may be detected in extraterrestrial sources. A tabulation is presented of frequencies, wavelengths, and line strengths for SiH molecule transitions at microwave and far-IR wavelengths, on the basis of an analysis of its laser magnetic resonance spectrum. It is hoped that the frequencies presented will be useful to both laboratory spectroscopists and astrophysicists.},
