@article{Mader:1974:164,
  title = {Microwave {{Spectrum}} of {{Ethyl Cyanide}}; R0-{{Structure}}, {{Nitrogen Quadrupole Coupling Constants}} and {{Rotation-Torsion-Vibration Interaction}}},
  author = {M{\"a}der, H. and Heise, H. M. and Dreizler, H.},
