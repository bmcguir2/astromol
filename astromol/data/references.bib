@article{Murtz:1998:9744,
  title = {Measurement of High-Frequency Rotational Transitions of {{H}}{\textsubscript{2}}{{O}}{\textsuperscript{+}} in Its Ground State by Far-Infrared Laser Magnetic Resonance ({{LMR}}) Spectroscopy},
  author = {M{\"u}rtz, P. and Zink, L. R. and Evenson, K. M. and Brown, J. M.},
  year = 1998,
  month = dec,
  journal = {Journal of Chemical Physics},
  volume = {109},
  pages = {9744--9752},
  publisher = {AIP},
  issn = {0021-9606},
  doi = {10.1063/1.477644},
  urldate = {2025-04-16},
  abstract = {Thirteen new rotational transitions of H2O+ in the (0,0,0) level of the X{$\sim$} 2B1 state have been measured in the wavenumber region between 80 and 200 cm-1 (50 and 120 {$\mu$}m) by far-infrared laser magnetic resonance (LMR) spectroscopy. LMR data measured previously between 25 and 90 cm-1 (110 and 400 {$\mu$}m), as well as optical and infrared combination differences, have been combined with the new LMR data in a weighted least-squares analysis using an A-reduced expression of the rotational-fine structure Hamiltonian. Thirty-two molecular constants were simultaneously determined, some sextic centrifugal distortion parameters and some quartic and sextic spin-rotation parameters for the first time. From this improved set of molecular parameters, very accurate calculations of rotational term values and zero-field predictions of the 111-000 transition, including hyperfine structure, have been performed. Moreover, the electronic g-tensors and the hyperfine coupling constants are consistent with ab initio calculations which had been carried out for these constants.},
  keywords = {31.15.Ar,31.30.Gs,33.15.Pw,33.20.Ea,33.35.+r,Ab initio calculations,Electron resonance and relaxation,Fine and hyperfine structure,Hyperfine interactions and isotope effects Jahn-Teller effect,Infrared spectra},
  annotation = {ADS Bibcode: 1998JChPh.109.9744M}
}

@article{Namiki:1998:176,
