}

@article{Cernicharo:1991:L39,
  title = {Astronomical {{Detection}} of {{H}}{\textsubscript{2}}{{CCC}}},
  author = {Cernicharo, J. and Gottlieb, C. A. and Guelin, M. and Killian, T. C. and Paubert, G. and Thaddeus, P. and Vrtilek, J. M.},
