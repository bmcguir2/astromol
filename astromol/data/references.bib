}

@article{Hincelin:2011:A61,
  title = {Oxygen Depletion in Dense Molecular Clouds: A Clue to a Low {{O}}{\textsubscript{2}} Abundance?},
  shorttitle = {Oxygen Depletion in Dense Molecular Clouds},
  author = {Hincelin, U. and Wakelam, V. and Hersant, F. and Guilloteau, S. and Loison, J. C. and Honvault, P. and Troe, J.},
  year = 2011,
