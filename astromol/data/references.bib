@article{vanDishoeck:2003:L1,
  title = {Detection of {{DCO}}{\textsuperscript{+}} in a Circumstellar Disk},
  author = {{van Dishoeck}, E. F. and Thi, W. -F. and {van Zadelhoff}, G. -J.},
  year = 2003,
