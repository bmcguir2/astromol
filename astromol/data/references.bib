@article{Cordiner:2017:187,
  title = {Deep {{K-band Observations}} of {{TMC-1}} with the {{Green Bank Telescope}}: {{Detection}} of {{HC}}{\textsubscript{7}}{{O}}, {{Nondetection}} of {{HC}}{\textsubscript{11}}{{N}}, and a {{Search}} for {{New Organic Molecules}}},
  shorttitle = {Deep {{K-band Observations}} of {{TMC-1}} with the {{Green Bank Telescope}}},
  author = {Cordiner, M. A. and Charnley, S. B. and Kisiel, Z. and McGuire, B. A. and Kuan, Y. -J.},
  year = 2017,
  month = dec,
  journal = {The Astrophysical Journal},
  volume = {850},
  pages = {187},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.3847/1538-4357/aa970c},
  urldate = {2025-04-11},
  abstract = {The 100 m Robert C. Byrd Green Bank Telescope K-band (KFPA) receiver was used to perform a high-sensitivity search for rotational emission lines from complex organic molecules in the cold interstellar medium toward TMC-1 (cyanopolyyne peak), focussing on the identification of new carbon-chain-bearing species as well as molecules of possible prebiotic relevance. We report a detection of the carbon-chain oxide species HC7O and derive a column density of (7.8+/- 0.9)\texttimes{} \textbraceleft 10\textbraceright 11 cm-2. This species is theorized to form as a result of associative electron detachment reactions between oxygen atoms and C7H-, and/or reaction of C6H2 + with CO (followed by dissociative electron recombination). Upper limits are given for the related HC6O, C6O, and C7O molecules. In addition, we obtained the first detections of emission from individual 13C isotopologues of HC7N, and derive abundance ratios HC7N/HCCC13CCCCN = 110 \textpm{} 16 and HC7N/HCCCC13CCCN = 96 \textpm{} 11, indicative of significant 13C depletion in this species relative to the local interstellar elemental 12C/13C ratio of 60-70. The observed spectral region covered two transitions of HC11N, but emission from this species was not detected, and the corresponding column density upper limit is 7.4\texttimes{} \textbraceleft 10\textbraceright 10 \textbraceleft\textbraceleft cm\textbraceright\textbraceright -2 (at 95\% confidence). This is significantly lower than the value of 2.8\texttimes{} \textbraceleft 10\textbraceright 11 \textbraceleft\textbraceleft cm\textbraceright\textbraceright -2 previously claimed by Bell et al. and confirms the recent nondetection of HC11N in TMC-1 by Loomis et al. Upper limits were also obtained for the column densities of malononitrile and the nitrogen heterocycles quinoline, isoquinoline, and pyrimidine.},
  keywords = {Astrophysics - Astrophysics of Galaxies,ISM: abundances,ISM: lines and bands,ISM: molecules,radio lines: ISM},
  annotation = {ADS Bibcode: 2017ApJ...850..187C},
  file = {/Users/brett/Zotero/storage/BRMQJE33/Cordiner et al. - 2017 - Deep K-band Observations of TMC-1 with the Green Bank Telescope Detection of HC7O, Nondetection of.pdf}
}

