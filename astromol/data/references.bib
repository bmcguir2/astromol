  urldate = {2025-04-10},
  abstract = {Eight bands of the A1{$\Pi$}-X1{$\Sigma$}+ system of CH+ have been photographed in emission from a hollow cathode discharge lamp using a high resolution spectrograph. Bands involving the {$\nu$}" = 2 and {$\nu$}" = 3 levels of the ground state have been observed for the first time. The simultaneous analysis of the eight bands yields improved molecular constants for the CH+ molecule. The excited state constants show small irregularities in their variation with {$\nu$}, but the ground state constants are regular and the principal constants in cm-1 are: {$\omega$}e = 2857.56, {$\omega$}e{$\chi$}e = 59.32 Be = 14.1766(3), {$\alpha$}e = 0.4939(4), 103De = 1.373(3), where the error limits are 1{$\sigma$}.},
