@article{McGuire:2017:L28,
  title = {Detection of {{Interstellar HC}}{\textsubscript{5}}{{O}} in {{TMC-1}} with the {{Green Bank Telescope}}},
  author = {McGuire, Brett A. and Burkhardt, Andrew M. and Shingledecker, Christopher N. and Kalenskii, Sergei V. and Herbst, Eric and Remijan, Anthony J. and McCarthy, Michael C.},
  year = 2017,
  month = jul,
  journal = {The Astrophysical Journal},
  volume = {843},
  pages = {L28},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.3847/2041-8213/aa7ca3},
  urldate = {2025-04-15},
  abstract = {We report the detection of the carbon-chain radical HC5O for the first time in the interstellar medium toward the cold core TMC-1 using the 100 m Green Bank Telescope. We observe four hyperfine components of this radical in the J=17/2\textbackslash to 15/2 rotational transition that originates from the \textbraceleft\textbraceright 2\textbraceleft\textbraceleft\textbraceleft\textbackslash Pi \textbraceright\textbraceright\textbraceright 1/2 fine structure level of its ground state and calculate an abundance of n/\textbraceleft n\textbraceright\textbraceleft H2\textbraceright =1.7\texttimes{} \textbraceleft 10\textbraceright -10, assuming an excitation temperature of \textbraceleft T\textbraceright\textbraceleft ex\textbraceright =7 K. No indication of HC3O, HC4O, or HC6O, is found in these or archival observations of the source, while we report tentative evidence for HC7O. We compare calculated upper limits and the abundance of HC5O to predictions based on (1) the abundance trend of the analogous HC n N family in TMC-1 and (2) a gas-grain chemical model. We find that the gas-grain chemical model well reproduces the observed abundance of HC5O, as well as the upper limits of HC3O, HC6O, and HC7O, but HC4O is overproduced. The prospects for astronomical detection of both shorter and longer HC n O chains are discussed.},
  keywords = {astrochemistry,Astrophysics - Astrophysics of Galaxies,ISM: individual objects: TMC-1,ISM: molecules},
  annotation = {ADS Bibcode: 2017ApJ...843L..28M},
  file = {/Users/brett/Zotero/storage/7AQFYC3T/McGuire et al. - 2017 - Detection of Interstellar HC5O in TMC-1 with the Green Bank Telescope.pdf}
}

@article{McGuire:2017:L46,
