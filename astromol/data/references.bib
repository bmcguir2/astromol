  issn = {0004-6361},
  urldate = {2025-04-14},
  abstract = {The detection in the carbon star envelope IRC + 10216 of CP, a radical isostructural with CN is reported. Contrary to the latter, which is essentially observed in the outer layers of the envelope, CP seems confined to the inner envelope and is unlikely to result from photochemistry. Its abundance, which is similar to, or larger than that of HCP, seems also too high to result from thermoequilibrium reactions in the relatively cool atmosphere of the central star.},
