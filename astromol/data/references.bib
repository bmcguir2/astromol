  volume = {87},
  pages = {1159--1168},
  issn = {0026-8976},
  doi = {10.1080/00268979600100771},
  urldate = {2025-04-15},
  abstract = {The microwave spectrum of urea has been recorded in the frequency range 8-19 GHz using a laser ablation molecular beam Fourier transform microwave spectrometer. The analysis of the nuclear quadrupole hyperfine splitting caused by two equivalent 14N nuclei yields the quadrupole coupling constants {$\chi$}aa = 2{$\cdot$}205(26) MHz and {$\chi$}bb = 1{$\cdot$}8884(29) MHz. Seven different transitions transitions are reported. Distortion analysis is made with these seven plus 41 transitions previously published. We determine the rotational constants A = 11233{$\cdot$}3161(87) MHz, B = 10369{$\cdot$}4074(88) MHz, and C = 5416{$\cdot$}6392(86) MHz and Watson's A reduced centrifugal distortion constants {$\Delta$}J = 10{$\cdot$}58(37) kHz, {$\Delta$}JK = -20{$\cdot$}982(53) kHz, {$\Delta$}K = 10{$\cdot$}80(29) kHz, {$\Delta$}J = 0{$\cdot$}2208(43) kHz, and {$\delta$}K = -14{$\cdot$}6439(73) kHz.},
  annotation = {ADS Bibcode: 1996MolPh..87.1159K}
}

