  abstract = {Certain of the pure rotational lines of methyl cyanide and methyl isocyanide have been measured and the following molecular properties have been obtained. The moments of inertia, IB, \texttimes{} 10-4 g cm2, are: for C12H3C12N14, 91.2034; for C12H3C13N14, 91.2486; for C12D3C12N14, 106.7666; for C12D3C13N14, 106.8948; for C12H3N14C12, 83.4550; for C12H3N14C13, 86.5277; for C12D3N14C12, 97.7579; and for C12D3N14C13, 101.3391. The molecular dimensions are: for CH3CN, dCH=1.092A, dCC=1.460A, dCN=1.158A, and {$\angle$} HCH=109{$^\circ$}8' for CH3NC, dCH=1.094A, dCN=1.427A, dNC=1.167A, and {$\angle$} HCH=109{$^\circ$}46'. The nuclear coupling for N14 is -4.35 Mc/sec. in CH3CN and is {$<\vert$}0.5\textbar{} in CH3NC.},
  annotation = {ADS Bibcode: 1950PhRv...79...54K}
}

@article{Kewley:1963:418,
  title = {The Millimeter Wave Spectra of Isocyanic and Isothiocyanic Acids},
  author = {Kewley, Roger and Sastry, K. V. L. N. and Winnewisser, Manfred},
  year = 1963,
  month = jan,
  journal = {Journal of Molecular Spectroscopy},
  volume = {10},
  pages = {418--441},
  issn = {0022-2852},
  doi = {10.1016/0022-2852(63)90188-7},
  urldate = {2025-04-14},
  abstract = {An investigation of the mm-wave rotational spectra of the very slightly asymmetric tops HNCS, DNCS, HNCO and DNCO has been carried out in the frequency range 80 000-190 000 Mc/sec. Several R-branch, a-type, transitions were observed for each molecule and the rotational constants A0, B0, and C0 were determined for the four species containing the most abundant isotopes of N, C, O, or S. B0 and C0 were also found for HNCS 34. The centrifugal distortion constant DJ was obtained for each abundant form. The constants are HNCS: A 0 = 1 483 000 \textpm{} 167 000 Mc/sec, B 0 = 5883.42 \textpm{} 0.02 Mc/sec, C 0 = 5845.62 \textpm{} 0.02 Mc/sec, D j = 1.17 \textpm{} 0.05 Kc/sec; DNCS: A 0 = 723 400 \textpm{} 25 000 Mc/sec, B 0 = 5500.51 \textpm{} 0.05 Mc/sec, C 0 = 5445.26 \textpm{} 0.05 Mc/sec, D j = 1.22 \textpm{} 0.31 Kc/sec; HNCS 34: B 0 = 5744.81 \textpm{} 0.20 Mc/sec, C 0 = 5708.73 \textpm{} 0.20 Mc/sec; HNCO: A 0 = 956 400 \textpm{} 50 000 Mc/sec, B 0 = 11 071.02 \textpm{} 0.05 Mc/sec, C 0 = 10 910.58 \textpm{} 0.05 Mc/sec, D j = 3.5 \textpm{} 0.5 Kc/sec; DNCO: A 0 = 534 500 \textpm{} 70 000 Mc/sec, B 0 = 10 313.61 \textpm{} 0.05 Mc/sec, C 0 = 10 079.67 \textpm{} 0.05 Mc/sec, D j = 2.9 \textpm{} 0.5 Kc/sec. The centrifugal distortion K-pattern is different in character for each of the four molecules. Agreement between calculation and experiment is obtained for HNCO and DNCO with the additional constants; HNCO; DJK = +837 Kc/sec, HJJK = -0.056 Kc/sec, HJKK = +2.81 Kc/sec. DNCO: DJK = -227.1 Kc/sec, HJJK = +0.15 Kc/sec, HJKK = -5.61 Kc/sec, HJJJ = 0, utilizing the expression given by Costain. This expression gives a poor fit for DNCS and no fit for HNCS, and at present no treatment has been found to fit or explain satisfactorily the K-patterns for these two molecules. An improved molecular structure has been calculated for HNCS the structural parameters being revised to r(HN) = 0.988 7 \textpm{} 0.003 A, r(NC) = 1.216 4 \textpm{} 0.007 A, r(CS) = 1.560 5 \textpm{} 0.003 A {$<$} HNC = 134{$^\circ$}59' \textpm{} 10'. A number of lines due to rotational transitions of vibrationally excited molecules were also observed and are assigned to the states v5 = 1 and v6 = 1 for HNCS and HNCO and probably, in addition, v4 = 1 for DNCS.},
  annotation = {ADS Bibcode: 1963JMoSp..10..418K}
}

