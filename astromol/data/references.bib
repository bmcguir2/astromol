@article{Ohishi:1996:L61,
  title = {Detection of a {{New Interstellar Molecular Ion}}, {{H}}{\textsubscript{2}}{{COH}}{\textsuperscript{+}} ({{Protonated Formaldehyde}})},
  author = {Ohishi, Masatoshi and Ishikawa, Shin-Ichi and Amano, Takayoshi and Oka, Hidehiko and Irvine, William M. and Dickens, James E. and Ziurys, L. M. and Apponi, A. J.},
  year = 1996,
