  pages = {229--231},
  issn = {0004-6361},
  urldate = {2025-04-11},
  abstract = {Summary. The t10 - t11 transitions of the A and E internal rotation states of methyl formate (HCOOCH3) have been observed in emission toward Sgr B 2. Both the A- and E-states were clearly detected with essentially the same intensity and the same radial velocity. The mean values are : TAL=OOSO+O009 K, AVL=23.4+ 3.0km s- , VLsR= +59.0+t. . The t8 cm K-doublet of HCOOCH3 is probably inverted and amplifies the background continuum radiation; thus, the total column density may be much less than that derived on the assumption of spontaneous emission. In addition, a search for monothioformic acid in the cis-configuration toward Sgr B 2 has yielded an upper limit of TAL {$<$}0.027 K for the 2i 1-212 transition. Key words: interstellar molecules - galactic center - maser - methyl formate},
  keywords = {Astrophysics,Background Radiation,Continuous Radiation,Electron Transitions,Formates,Formic Acid,Galactic Nuclei,Interstellar Masers,Interstellar Space,Methyl Compounds,Molecular Excitation,Molecular Rotation,Polyatomic Molecules,Radial Velocity,Spontaneous Emission},
  annotation = {ADS Bibcode: 1975A\&A....45..229C},
  file = {/Users/brett/Zotero/storage/AHIKM3NE/Churchwell and Winnewisser - 1975 - Observations of methyl formate in the galactic center..pdf}
}

@article{Churchwell:1977:969,
