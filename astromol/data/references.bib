@article{Wong:1983:89,
  title = {Study of the Torsion-Rotation {{Hamiltonian}} for Symmetric Tops Using the Millimeter Wave Spectrum of Methyl Silane},
  author = {Wong, Man and Ozier, Irving and Meerts, W. Leo},
  year = 1983,
  month = nov,
  journal = {Journal of Molecular Spectroscopy},
  volume = {102},
  pages = {89--111},
  issn = {0022-2852},
  doi = {10.1016/0022-2852(83)90230-8},
  urldate = {2025-04-17},
  abstract = {The torsion-rotation Hamiltonian for symmetric tops has been tested in methyl silane by combining recent anticrossing molecular beam measurements in the ground torsional state ( v = 0) with pure rotational spectra taken for v as high as 4. The earlier microwave data set which consisted of J = 1 \textleftarrow{} 0 and 2 \textleftarrow{} 1 has been greatly extended by studying millimeter transitions for J = 4 \textleftarrow{} 3, 5 \textleftarrow{} 4, and 13 \textleftarrow{} 12. An analysis of the 72 rotational frequencies for v {$\leq$} 2 and the 15 anticrossing data for v = 0 yielded an excellent fit using 14 rotational, torsional, and distortion constants including the effective values for the A rotational constant and the barrier height V3. No satisfactory fit could be obtained when the data set was extended to include measurements for ( v = 3) or ( v = 4). For each of these higher torsional levels, the difference between the observed frequencies and the predictions based on the best ( v {$\leq$} 2) constants can be expressed in terms of a shift {$\delta$}Bv in the B rotational constant, where {$\delta$}Bv is a smooth function of the torsional energy. This disagreement is of particular interest because it may result from the fact that the molecule passes from hindered to free rotation as v is increased from 2 to 4. The possibility of perturbation by a low-lying vibrational level is considered briefly. The information contained in the different types of spectra is discussed; the redundancy relations are treated and a Fourier expansion of the diagonal torsional matrix elements is introduced. For 12CH 329SiH 3, 12CH 330SiH 3, and 13CH 328SiH 3 pure rotational spectra for v = 0 were studied briefly in natural abundance. The results were combined with existing data for two deuterated symmetric rotors to obtain a structure based only on symmetric top rotational constants.},
  annotation = {ADS Bibcode: 1983JMoSp.102...89W}
}

@article{Woods:1975:1269,
  title = {Laboratory Microwave Spectrum of {{HCO}}{\textsuperscript{+}}},
  author = {Woods, R. Claude and Dixon, Thomas A. and Saykally, Richard J. and Szanto, Peter G.},
  year = 1975,
  month = nov,
  journal = {Physical Review Letters},
  volume = {35},
  pages = {1269--1272},
  publisher = {APS},
  issn = {0031-9007},
  doi = {10.1103/PhysRevLett.35.1269},
  urldate = {2025-04-17},
  abstract = {The J=0--{$>$}1 rotational transition of the HCO+ ion has been observed with the same apparatus used earlier for detection of CO+. A discharge in various mixtures of hydrogen and carbon monoxide cooled to near liquid-nitrogen temperature was employed in a slow-flow system. The frequency we have obtained is 89 188.545+/-0.020 MHz, but because of the ion drift velocity in the dc discharge this exceeds, by an unknown but small amount, the true rest frequency. This observation confirms the long-standing contention that the radio astronomical X-ogen line is in fact due to HCO+.},
  annotation = {ADS Bibcode: 1975PhRvL..35.1269W}
}

@article{Woods:1983:583,
  title = {The [{{HCO}}{\textsuperscript{+}}]/[{{HOC}}{\textsuperscript{+}}] Abundance Ratio in Molecular Clouds.},
  author = {Woods, R. C. and Gudeman, C. S. and Dickman, R. L. and Goldsmith, P. F. and Huguenin, G. R. and Irvine, W. M. and Hjalmarson, A. and Nyman, L. -A. and Olofsson, H.},
  year = 1983,
  month = jul,
  journal = {The Astrophysical Journal},
  volume = {270},
  pages = {583--588},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1086/161150},
  urldate = {2025-04-17},
  abstract = {Using the recently determined rest frequency of its first rotational transition, a sensitive search has been made for the J = 1 yields 0 transition of HOC(+) in 14 interstellar sources. A line having a frequency and shape consistent with optically thin emission due to this species was detected toward Sgr B2; this spectral feature is provisionally identified as being due to HOC(+). Comparison with the 1 yields 0 transition of H(C-18)O(+) in this source yields an isomeric abundance ratio HCO(+)/HOC(+) of about 330, if the detected line is in fact due to HOC(+). Independent of, and consistent with, this conclusion, comparisons with isotopically substituted HCO(+) in the other clouds searched show that HCO(+) is at least two orders of magnitude more abundant than HOC(+). This large ratio places interesting constraints on the fractional abundance of related species.},
  keywords = {Abundance,Astrophysics,Brightness Temperature,Interstellar Chemistry,Interstellar Matter,Molecular Clouds,Molecular Ions,Positive Ions},
  annotation = {ADS Bibcode: 1983ApJ...270..583W},
  file = {/Users/brett/Zotero/storage/L78ETPI2/Woods et al. - 1983 - The  abundance ratio in molecular clouds..pdf}
}

@article{Woon:2002:541,
  title = {Modeling {{Gas-Grain Chemistry}} with {{Quantum Chemical Cluster Calculations}}. {{I}}. {{Heterogeneous Hydrogenation}} of {{CO}} and {{H}}{\textsubscript{2}}{{CO}} on {{Icy Grain Mantles}}},
  author = {Woon, David E.},
  year = 2002,
  month = apr,
  journal = {The Astrophysical Journal},
  volume = {569},
  pages = {541--548},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1086/339279},
  urldate = {2025-04-17},
  abstract = {Formaldehyde (H2CO) and methanol (CH3OH) are thought to be produced in the interstellar medium by the successive hydrogenation of carbon monoxide (CO) on grain surfaces. In the gas phase, the steps in which H adds to CO and H2CO possess modest barriers and are too inefficient to account for the observed abundances. Recent laboratory work has confirmed that formaldehyde and methanol are formed when H atoms are deposited on CO ice at 12 K. The present study employs ab initio quantum chemical calculations to investigate the impact of water ice on the sequential hydrogenation of CO. The most favorable pathway is CO--{$>$}HCO (formyl radical)--{$>$}H2CO--{$>$}CH3O (methoxy radical)--{$>$}CH3OH. There is sufficient reaction energy in the final step to fragment CH3OH into methyl and hydroxyl radicals, which can be hydrogenated to yield methane and water, as observed in the experimental work. The emphasis here was on the two steps with barriers, H+CO and H+H2CO, with both addition and abstraction considered for the latter. Calculations with up to four explicit water molecules were performed, as well as further modeling to incorporate bulk effects. While ice was found to have a nearly negligible impact on H+CO--{$>$}HCO, it modestly enhances the addition reaction H+H2CO--{$>$}CH3O and hinders the abstraction reaction H+H2CO--{$>$}H2+HCO. The deuterium-substituted reactions D+CO--{$>$}DCO and D+H2CO--{$>$}CDH2O were found to be slightly favored over the corresponding H reactions, particularly in the latter case. Overall, the energetics are not favorable: water ice is evidently not a good catalytic substrate for H+CO or H+H2CO addition reactions at very cold temperatures.},
  keywords = {ISM: Molecules,Molecular Processes},
  annotation = {ADS Bibcode: 2002ApJ...569..541W},
  file = {/Users/brett/Zotero/storage/HAXY9ITN/Woon - 2002 - Modeling Gas-Grain Chemistry with Quantum Chemical Cluster Calculations. I. Heterogeneous Hydrogenat.pdf}
}

@article{Wootten:1986:L15,
  title = {A Search for Interstellar {{H}}{\textsubscript{3}}{{O}}{\textsuperscript{+}}.},
  author = {Wootten, A. and Boulanger, F. and Bogey, M. and Combes, F. and Encrenaz, P. J. and Gerin, M. and Ziurys, L.},
  year = 1986,
  month = sep,
  journal = {Astronomy and Astrophysics},
  volume = {166},
  pages = {L15-L18},
  publisher = {EDP},
  issn = {0004-6361},
  urldate = {2025-04-17},
  abstract = {The P(2,1) line of H3O+, a key species in ion-molecule chemistry, has been sought in the interstellar medium and in Halley's Comet. In OMC1 and Sgr B2, a line was detected which may possibly be attributed to H3O+. Verification of this identification must be accomplished through observation of the P(3,2) line at 364 GHz, or detection of isotopic variants. If the detected line arises from H3O+, it could be possible to deduce a fractional abundance X(H3O+) in OMC1 and in Sgr B2 of {$\equiv$}10-9 and a production rate in Comet Halley of Q(H3O+) {$<$} 1028s-1. These results would place H3O+ among the more abundant molecular ions in the interstellar gas in agreement with theoretical predictions.},
  keywords = {Abundance,Astrophysics,Halley'S Comet,Interstellar Gas,Line Spectra,Molecular Ions,Positive Ions,Water},
  annotation = {ADS Bibcode: 1986A\&A...166L..15W},
  file = {/Users/brett/Zotero/storage/GUTRYNZU/Wootten et al. - 1986 - A search for interstellar H3O+..pdf}
}

@article{Wootten:1991:L79,
  title = {Detection of {{Interstellar H}}{\textsubscript{3}}{{O}}{\textsuperscript{+}}: {{A Confirming Line}}},
  shorttitle = {Detection of {{Interstellar H 3O}} +},
  author = {Wootten, Alwyn and Mangum, J. G. and Turner, B. E. and Bogey, M. and Boulanger, F. and Combes, F. and Encrenaz, P. J. and Gerin, M.},
  year = 1991,
  month = oct,
  journal = {The Astrophysical Journal},
  volume = {380},
  pages = {L79},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1086/186178},
  urldate = {2025-04-17},
  abstract = {Observations are reported from a line coincident in frequency with the (J, K) = (3, 2)-(2, 2) 364.797427 GHz transition which is argued to arise from H3O(+). Two lines of this ion lie at frequencies accessible to earth-bound telescopes, and both were detected. Mapping shows that the emission extends over about 1 pc in Sgr B2 but lies concentrated to the core (about 0.07 pc in OMC-1. The source of the emission is identified as H3O(+), and it is found that the abundance X(H3O/+/) is approximately equal to 1 x 10 exp -9 - 5 x 10 exp -9. It is concluded that the abundance of H3O(+) is in reasonable agreement with chemical models, and that the H2O/H3O(+) ratio lies at the low end of the range of predictions of chemical models. It is inferred that the size of the emission regions are limited by the size of regions where substantial release of water from grain surfaces has occurred.},
  keywords = {Abundance,ABUNDANCES,Astronomical Spectroscopy,Astrophysics,Cosmic Dust,Electron Transitions,Emission Spectra,Hydronium Ions,Interstellar Chemistry,Interstellar Matter,INTERSTELLAR: ABUNDANCES},
  annotation = {ADS Bibcode: 1991ApJ...380L..79W},
  file = {/Users/brett/Zotero/storage/FRHS7ZXC/Wootten et al. - 1991 - Detection of Interstellar H 3O + A Confirming Line.pdf}
}

@article{Wyrowski:2010:A26,
  title = {First Interstellar Detection of {{OH}}{\textsuperscript{+}}},
  author = {Wyrowski, F. and Menten, K. M. and G{\"u}sten, R. and Belloche, A.},
  year = 2010,
  month = jul,
  journal = {Astronomy and Astrophysics},
  volume = {518},
  pages = {A26},
  issn = {0004-6361},
  doi = {10.1051/0004-6361/201014364},
  urldate = {2025-04-17},
  abstract = {The Atacama Pathfinder Experiment (APEX) 12 m telescope was used to observe the N = 1-0, J = 0-1 ground-state transitions of OH+ at 909.1588 GHz with the CHAMP+ heterodyne array receiver. Two blended hyperfine structure transitions were detected in absorption against the strong continuum source Sagittarius B2(M) and in several pixels offset by 18\textasciiacute\textasciiacute. Both absorption from Galactic center gas and absorption from diffuse clouds in intervening spiral arms in a velocity range from -116 to 38.5 km s-1 is observed. The total OH+ column density of absorbing gas is 2.4 \texttimes{} 1015 cm-2. A column density local to Sgr B2(M) of 2.6 \texttimes{} 1014 cm-2 is found. On the intervening line-of-sight, the column density per unit velocity interval is in the range of 1 to 40 \texttimes{} 1012 cm-2/(km s-1). OH+ is found to be on average more abundant than other hydrides, such as SH+ and CH+. Abundance ratios of OH and atomic oxygen to OH+ are found in the range of 101-2 and 103-4, respectively. The detected absorption of a continuous velocity range on the line-of-sight shows OH+ to be an abundant component of diffuse clouds.},
  keywords = {astrochemistry,Astrophysics - Astrophysics of Galaxies,ISM: abundances,ISM: molecules},
  annotation = {ADS Bibcode: 2010A\&A...518A..26W},
  file = {/Users/brett/Zotero/storage/FSP3I5NR/Wyrowski et al. - 2010 - First interstellar detection of OH+.pdf}
}

@article{Wyse:1970:3887,
  title = {Millimeter and {{Submillimeter Wave Spectrum}} and {{Molecular Constants}} of {{Aluminum Monofluoride}}},
  author = {Wyse, F. C. and Gordy, Walter and Pearson, Edwin F.},
  year = 1970,
  month = apr,
  journal = {Journal of Chemical Physics},
  volume = {52},
  pages = {3887--3889},
  publisher = {AIP},
  issn = {0021-9606},
  doi = {10.1063/1.1673587},
  urldate = {2025-04-17},
  abstract = {Rotational transitions of 27Al19F have been measured in the millimeter and submillimeter wave regions to frequencies of 461 Gc/sec. Vibrational states up to {$\upsilon$} = 4 were observed. From analysis of the data the following Dunham rotational constants were obtained: Y01 = 16 562.930 \textpm{} 0.006 Mc/sec, Y11 = - 149.420 \textpm{} 0.009 Mc/sec, Y21 = 0.515 \textpm{} 0.004 Mc/sec, Y31 = 1.4 \textpm{} 0.6 kc/sec, Y02 = - 31.37 \textpm{} 0.02 kc/sec, and Y12 = 0.046 \textpm{} 0.014 kc/sec. The Dunham potential constants found are: a0 = 2.9167 \textpm{} 0.0019 \texttimes{} 105, a1 = - 3.1850 \textpm{} 0.0009, a2 = 6.82 \textpm{} 0.06, and a3 = - 11.6 \textpm{} 0.6 cm-1. The nuclear quadrupole coupling constants obtained are: eqQ(27Al) = - 37.59 \textpm{} 0.25 Mc/sec for {$\upsilon$} = 0 and eqQ(27Al) = - 37.14 \textpm{} 0.6 Mc/sec for the {$\upsilon$} = 1 vibrational state. Vibrational constants derived are {$\omega$}e = 802.85 \textpm{} 0.25 cm-1 and {$\omega$}exe = 4.86 \textpm{} 0.06 cm-1. The equilibrium internuclear distance re = 1.65436 \textpm{} 0.00002 \AA{} was obtained.},
  annotation = {ADS Bibcode: 1970JChPh..52.3887W}
}

@article{Wyse:1972:1106,
