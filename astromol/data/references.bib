  doi = {10.1086/182645},
  urldate = {2025-04-17},
  abstract = {We have detected emission from the luminous carbon star IRC +10216 at 114.222 GHz, which is the frequency of the J = 1{$\rightarrow$}0 rotational transition from the first excited vibrational state of CO. Assuming that this tentative identification is correct, the transition originates from a level at an energy corresponding to 3100 K above the ground state. The emission is probably a maser situated close to the stellar surface pumped by absorption of 2.3 {$\mu$}m stellar photons in the CO v = 0{$\rightarrow$}2 band. The similarity of the line width to that of CO v = 0, J = 1{$\rightarrow$}0 suggests there is little change in the outflow velocity of the circumstellar shell between the v = 1 and v = 0 emitting regions; and therefore most of the radial acceleration must occur very close to the star. The v = 2 and v = 3 states were not detected.},
  keywords = {Astrophysics,Carbon Monoxide,Carbon Stars,Carbon Stars:Masers,Carbon Stars:Mass Loss,Circumstellar Shells,Interstellar Masers,Lasing,Microwave Emission,Molecular Excitation,Molecular Rotation,Spectral Line Width,Stellar Envelopes,Stellar Mass Ejection,Stellar Rotation,Thermal Emission,Vibrational Spectra},
  annotation = {ADS Bibcode: 1978ApJ...220L.103S},
  file = {/Users/brett/Zotero/storage/ZTT854WM/Scoville and Solomon - 1978 - Variationally excited carbon monoxide in IRC +10216..pdf}
}

