@article{Birk:1989:402,
  title = {The Rotational-Torsional Spectrum of Carbodiimide: {{A}} Probe for the Unusual Dynamics},
  shorttitle = {The Rotational-Torsional Spectrum of Carbodiimide},
  author = {Birk, Manfred and Winnewisser, Manfred and Cohen, Edward A.},
  year = 1989,
  month = aug,
  journal = {Journal of Molecular Spectroscopy},
  volume = {136},
  pages = {402--445},
  issn = {0022-2852},
  doi = {10.1016/0022-2852(89)90345-7},
  urldate = {2025-04-10},
  abstract = {The rotation-torsion spectrum of carbodiimide, HNCNH, a constituent of the vapor of cyanamide, H 2NCN, was measured in the region from 15 GHz to 330 cm -1 using a high-resolution Fourier transform spectrometer, a laser single-sideband spectrometer, a millimeter-wave and a submillimeter-wave spectrometer. Aside from a small doublet splitting ({$<$}0.016 cm -1) detected for most of the transitions, the spectral pattern of a perpendicular band, expected for skew-chain molecules, was observed. The principal axis b of the inertia tensor is parallel to the C2 symmetry axis of HNCNH. The molecular constants obtained by fitting the positions of the doublet centers with Watson's Hamiltonian in S-reduction are A = 379 244.493(27)MHz, B = 10 366.9389(18)MHz, and C = 10 366.0837(25)MHz, which yield {$\kappa$} = -0.999995368(18). The small splittings were found to be due to a torsional motion. The analysis of the unusual dependence of the torsional splitting on Ka allows the calculation of the torsional energy separations {$\Delta$} Etrans and {$\Delta$} Ecis in the vibrational ground state. On the basis of these separations we can conclude that the cis and the trans barriers must have approximately the same height. The strong dependence of the torsional splittings on Ka indicates a large rotation-HNC bending interaction affecting the effective barriers Vcis and Vtrans hindering internal rotation. The permanent electric dipole moment was determined to be 1.90(5) D. From the relative intensities of the a-type rotational transitions of cyanamide and the b-type rotational-torsional transitions of carbodiimide it was found that the abundance ratio of carbodiimide to cyanamide at 380 K is \textbraceleft 1\textbraceright/\textbraceleft 115\textbraceright (14) . This work provides an extensive high precision data base for HNCNH, making a radioastronomical search for this molecule possible.},
  annotation = {ADS Bibcode: 1989JMoSp.136..402B}
}

@article{Bizzocchi:2001:110,
  title = {Submillimeter-{{Wave Spectroscopy}} of {{Phosphaalkynes}}: {{HCCCP}}, {{NCCP}}, {{HCP}}, and {{DCP}}},
  shorttitle = {Submillimeter-{{Wave Spectroscopy}} of {{Phosphaalkynes}}},
  author = {Bizzocchi, Luca and Thorwirth, Sven and M{\"u}ller, Holger S. P. and Lewen, Frank and Winnewisser, Gisbert},
  year = 2001,
  month = jan,
  journal = {Journal of Molecular Spectroscopy},
  volume = {205},
  pages = {110--116},
  issn = {0022-2852},
  doi = {10.1006/jmsp.2000.8234},
  urldate = {2025-04-10},
  abstract = {The submillimeter-wave rotational spectra of the unstable phosphorus-bearing molecules HCCCP (phosphabutadiyne) and NCCP (C-cyanophosphaethyne) have been investigated in selected frequency regions between 490 and 815 GHz using the Cologne Terahertz Spectrometer. Both molecules were studied in their ground vibrational states. Additionally, vibrational satellites within the bending states v4 = 1 and v5 = 1 were recorded for NCCP. Furthermore, the ground state rotational spectra of the 13C and 15N isotopomers of NCCP were detected in natural abundance. The new measurements allowed us to evaluate the sextic centrifugal distortion constants for each isotopomer and vibrational state investigated. The pyrolysis reactions, through which HCCCP and NCCP were produced in situ, also yielded phosphaethyne, HCP, as a by-product. Some transitions of HCP and DCP were recorded in their ground vibrational states along with v2 = 1 vibrational satellites of the former.},
  keywords = {linear molecules,phosphaalkynes,submillimeter-wave spectroscopy},
  annotation = {ADS Bibcode: 2001JMoSp.205..110B}
}

@article{Bizzocchi:2020:59,
  title = {Submillimeter and {{Far-infrared Spectroscopy}} of {{Monodeuterated Amidogen Radical}} ({{NHD}}): {{Improved Rest Frequencies}} for {{Astrophysical Observations}}},
  shorttitle = {Submillimeter and {{Far-infrared Spectroscopy}} of {{Monodeuterated Amidogen Radical}} ({{NHD}})},
  author = {Bizzocchi, Luca and Melosso, Mattia and Giuliano, Barbara Michela and Dore, Luca and Tamassia, Filippo and {Martin-Drumel}, Marie-Aline and Pirali, Olivier and Margul{\`e}s, Laurent and Caselli, Paola},
  year = 2020,
  month = apr,
  journal = {The Astrophysical Journal Supplement Series},
  volume = {247},
  pages = {59},
  publisher = {IOP},
  issn = {0067-0049},
  doi = {10.3847/1538-4365/ab765f},
  urldate = {2026-05-06},
  abstract = {Observations of ammonia in interstellar environments have revealed high levels of deuteration, and all its D-containing variants, including ND3, have been detected in cold prestellar cores and around young protostars. The observation of these deuterated isotopologues is very useful for elucidating the chemical and physical processes taking place during the very early stages of star formation, as the abundance of deuterated molecules is highly enhanced in dense and cold gas. Nitrogen hydride radicals are key species lying at the very beginning of the reaction pathway leading to the formation of NH3 and organic molecules of prebiotic interest, but relatively little is known about their D-bearing isotopologues. To date, only ND has been detected in interstellar gas. To aid the identification of further deuterated nitrogen radicals, we have thoroughly reinvestigated the rotational spectrum of NHD by employing two different instruments: a frequency-modulation submillimeter spectrometer operating in the THz region and a synchrotron-based Fourier-transform infrared spectrometer operating in the 50-240 cm-1 frequency range. NHD was produced in a plasma of NH3 and D2. A wide range of rotational energy levels have been probed thanks to the observation of high-N (up to 15) and high-Ka (up to 9) transitions. A global analysis including our new data and data from the literature has provided a comprehensive set of very accurate spectroscopic parameters. A highly reliable line catalog has been generated to assist archival data searches and future astronomical observations of NHD at submillimeter and THz regimes.},
  keywords = {2004,2082,2085,2096,847,849,867,Astrophysics - Astrophysics of Galaxies,High resolution spectroscopy,Interstellar medium,Interstellar molecules,Isotopic abundances,Laboratory astrophysics,Line positions,Spectral line lists},
  annotation = {ADS Bibcode: 2020ApJS..247...59B},
  file = {/Users/brett/Zotero/storage/99XSQVZD/Bizzocchi et al. - 2020 - Submillimeter and Far-infrared Spectroscopy of Monodeuterated Amidogen Radical (NHD) Improved Rest.pdf}
}

