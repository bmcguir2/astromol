@article{Sousa-Silva:2013:28,
  title = {A Computed Room Temperature Line List for Phosphine},
  author = {{Sousa-Silva}, Clara and Yurchenko, Sergei N. and Tennyson, Jonathan},
  year = 2013,
  month = jun,
  journal = {Journal of Molecular Spectroscopy},
  volume = {288},
  pages = {28--37},
  publisher = {Elsevier},
  issn = {0022-2852},
  doi = {10.1016/j.jms.2013.04.002},
  urldate = {2025-04-17},
  abstract = {An accurate and comprehensive room temperature rotation-vibration transition line list for phosphine (31PH3) is computed using a newly refined potential energy surface and a previously constructed ab initio electric dipole moment surface. Energy levels, Einstein A coefficients and transition intensities are computed using these surfaces and a variational approach to the nuclear motion problem as implemented in the program TROVE. A ro-vibrational spectrum is computed, covering the wavenumber range 0-8000 cm-1. The resulting line list, which is appropriate for temperatures up to 300 K, consists of a total of 137 million transitions between 5.6 million energy levels. Several of the band centres are shifted to better match experimental transition frequencies. The line list is compared to the most recent HITRAN database and other laboratorial sources. Transition wavelengths and intensities are generally found to be in good agreement with the existing experimental data, with particularly close agreement for the rotational spectrum. An analysis of the comparison between the theoretical data created and the existing experimental data is performed, and suggestions for future improvements and assignments to the HITRAN database are made.},
  keywords = {Astrophysics - Earth and Planetary Astrophysics},
  annotation = {ADS Bibcode: 2013JMoSp.288...28S},
  file = {/Users/brett/Zotero/storage/PSMVG3RU/Sousa-Silva et al. - 2013 - A computed room temperature line list for phosphine.pdf}
}

@article{Souter:1970:674,
