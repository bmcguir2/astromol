@article{Robinson:1997:1,
  title = {The Millimeter-Wave Spectrum of {{AlNC}}: Chemical Trends in Metal Isocyanide Molecules},
  shorttitle = {The Millimeter-Wave Spectrum of {{AlNC}}},
  author = {Robinson, J. S. and Apponi, A. J. and Ziurys, L. M.},
  year = 1997,
  month = oct,
  journal = {Chemical Physics Letters},
  volume = {278},
  pages = {1--8},
  issn = {0009-2614},
  doi = {10.1016/S0009-2614(97)00950-0},
  urldate = {2025-04-16},
  abstract = {The millimeter-wave spectrum of AlNC (X 1{$\Sigma$} +) has been recorded using direct absorption techniques in the range 131-536 GHz, including data for several quanta of the bending vibration and the 13C,isotopomer. The species was created by the reaction of aluminum vapor and trimethylsilyl cyanide. Twenty rotational transitions were recorded for the main isotopomer and nine for AlN 13C, as well as lines for the (01 10), (02 0o) states. Rotational and l-type doubling constants have been determined for this species, as well as bond lengths. These measurements indicate that AlNC is a linear and fairly rigid molecule, as well as being the favored isomer, in agreement with theory.},
  annotation = {ADS Bibcode: 1997CPL...278....1R}
}

@article{Rodler:1984:447,
  title = {Generation, Microwave Spectrum and Dipole Moment of Ketenimine},
  author = {Rodler, Martin and Brown, Ronald D. and Godfrey, Peter D. and Tack, Leslie M.},
  year = 1984,
  month = oct,
  journal = {Chemical Physics Letters},
  volume = {110},
  pages = {447--451},
  issn = {0009-2614},
  doi = {10.1016/0009-2614(84)87068-2},
  urldate = {2025-04-16},
  abstract = {Ketenimine (ethenimine, vinylideneamine, H 2C : C : NH) has been generated by low-pressure pyrolysis of 3-hydroxy-propionitrile and 9,10-dihydro-9,10-(iminoethylene)anthracene. Its rotational spectrum has been investigated from 12 to 200 GHz. Measurement of 35 {$\mu$} a- and {$\mu$} c-type transitions yielded the rotational constants A = 201443.69(8), B = 9663.138(2), C = 9470.127(2) MHz, the dipole moment {$\mu$} a = 0.434(1), {$\mu$} c = 1.371(6), {$\mu$} = 1.438(6) D and 14N-quadrupole coupling constants, together with six centrifugal distortion constants. All these experimental constants are in close accord with ab initio molecular-orbital calculations. The lifetime of ketenimine in our spectrometer is less than 1 s.},
  annotation = {ADS Bibcode: 1984CPL...110..447R}
}

@article{Rodler:1985:23,
  title = {Microwave Spectrum, Dipole Moment, and Structure of Anti-Vinyl Alcohol},
  author = {Rodler, M.},
  year = 1985,
  month = nov,
  journal = {Journal of Molecular Spectroscopy},
  volume = {114},
  pages = {23--30},
  issn = {0022-2852},
  doi = {10.1016/0022-2852(85)90332-7},
  urldate = {2025-04-16},
  abstract = {The rotational spectra of the anti conformer of vinyl alcohol (ethenol, H 2CCHOH) and its OD modification have been studied by microwave spectroscopy. The compounds have been generated by very-low-pressure pyrolyses of the appropriate isotopic species of 3-thietanol. In both cases the 25 measured {$\mu$}a- and {$\mu$}b-type transitions allowed the rotational constants and all five quartic centrifugal distortion constants to be determined. Stark effect measurements have yielded the electic dipole moment: {$\mu$}a = 0.547(2), {$\mu$}b = 1.702(1), and {$\mu$} = 1.788(1) D. By relative intensity measurements it has been found that the vibrational ground state of the anti conformer lies 4.5\textpm 0.6 kJ mol -1 above the syn conformer. In addition, ab initio calculations at the 6-31G {$\ast\ast$} level have been performed to obtain the structure, relative energy, and dipole moment of both rotamers.},
  annotation = {ADS Bibcode: 1985JMoSp.114...23R}
}

@article{Rodler:1986:267,
  title = {The Rotation-Inversion Spectrum of Ketenimine, {{H}}{\textsubscript{2}}{{C}}={{C}}={{NH}}},
  author = {Rodler, M. and Brown, R. D. and Godfrey, P. D. and Kleib{\"o}mer, B.},
  year = 1986,
  month = jul,
  journal = {Journal of Molecular Spectroscopy},
  volume = {118},
  pages = {267--276},
  issn = {0022-2852},
  doi = {10.1016/0022-2852(86)90240-7},
  urldate = {2025-04-16},
  abstract = {High-resolution measurements of {$\mu$}c-type transitions of ketenimine in the 4- to 7-GHz region revealed a splitting of each line caused by the inversion motion of the imino hydrogen. The inversion splitting amounts to 66 kHz. Data from ab initio molecular orbital calculations for the changes of the geometrical parameters during the inversion motion have been used to carry out semirigid bender calculations. A barrier height of 4700 \textpm{} 200 cm -1 and an equilibrium HNC angle of 115.4 \textpm{} 0.6{$^\circ$} have been derived. In addition, the microwave spectrum of the N-deuterated species has been assigned. The inversion splitting could not be resolved but the quadrupole coupling of the deuterium nucleus has been observed. Attempts to detect the inversion splitting in methanimine, H 2CNH, have been unsuccessful, suggesting a higher barrier than in ketenimine.},
  annotation = {ADS Bibcode: 1986JMoSp.118..267R},
  file = {/Users/brett/Zotero/storage/CV9WPPJF/Rodler et al. - 1986 - The rotation-inversion spectrum of ketenimine, H2C=C=NH.pdf}
}

