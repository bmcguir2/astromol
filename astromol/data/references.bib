  abstract = {This paper reports on the tentative discovery of CH3NC in Sgr Br made during May, August, and October 1986, and March 1987 observations with the IRAM 30-m telescope equipped with 2- and 3-mm SIS receivers with DSB noise temperature of 150 and 100 K. The spectra observed in Sgr B2(OH) displayed three broadened lines, identified with the frequencies of the J = 4-3, J = 5-4, and J = 7-6 transitions, characteristic of methyl isocyanide. Assuming that these lines do arise from CH3NC, the CH3NC/CH3CN abundance ratio is estimated to be about 0.05. Although the frequency of the J = 5-4 transition line is close to that of the J = 4-3 transition of NaOH, no signal was found at the frequencies of the J = 3-2, J = 5-4, and J = 6-5 transitions of NaOH.},
  keywords = {Abundance,Acetonitrile,Astronomical Spectroscopy,Astrophysics,Interstellar Matter,Line Spectra,Millimeter Waves,Molecular Clouds,Molecular Spectra,Radio Spectra},
  annotation = {ADS Bibcode: 1988A\&A...189L...1C},
  file = {/Users/brett/Zotero/storage/D5X3FXZQ/Cernicharo et al. - 1988 - Tentative detection of CH3NC towards SGR B2..pdf}
}

@article{Cernicharo:1989:L25,
  title = {Astronomical and {{Laboratory Detection}} of the {{SiC Radical}}},
  author = {Cernicharo, J. and Gottlieb, C. A. and Guelin, M. and Thaddeus, P. and Vrtilek, J. M.},
