@article{Tanaka:1997:2728,
  title = {Pulsed Discharge Nozzle {{Fourier}} Transform Microwave Spectroscopy of the Propargyl Radical ({{H}}{\textsubscript{2}}{{CCCH}})},
  author = {Tanaka, Keiichi and Sumiyoshi, Yoshihiro and Ohshima, Yasuhiro and Endo, Yasuki and Kawaguchi, Kentarou},
