@article{Snyder:2005:914,
  title = {A {{Rigorous Attempt}} to {{Verify Interstellar Glycine}}},
  author = {Snyder, L. E. and Lovas, F. J. and Hollis, J. M. and Friedel, D. N. and Jewell, P. R. and Remijan, A. and Ilyushin, V. V. and Alekseev, E. A. and Dyubko, S. F.},
  year = 2005,
