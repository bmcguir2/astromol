  abstract = {We report on the discovery of methyl acetate, CH3COOCH3, through the detection of a large number of rotational lines from each one of the spin states of the molecule: AA species (A1 or A2), EA species (E1), AE species (E2), and EE species (E3 or E4). We also report, for the first time in space, the detection of the gauche conformer of ethyl formate, CH3CH2OCOH, in the same source. The trans conformer is also detected for the first time outside the Galactic center source SgrB2. From the derived velocity of the emission of methyl acetate, we conclude that it arises mainly from the compact ridge region with a total column density of (4.2 \textpm{} 0.5) \texttimes{} 1015 cm-2. The derived rotational temperature is 150 K. The column density for each conformer of ethyl formate, trans and gauche, is (4.5 \textpm{} 1.0) \texttimes{} 1014 cm-2. Their abundance ratio indicates a kinetic temperature of 135 K for the emitting gas and suggests that gas-phase reactions could participate efficiently in the formation of both conformers in addition to cold ice mantle reactions on the surface of dust grains. This work was based on observations carried out with the IRAM 30 m telescope. IRAM is supported by INSU/CNRS (France), MPG (Germany), and IGN (Spain).},
  keywords = {Astrophysics - Astrophysics of Galaxies,ISM: abundances,ISM: individual objects: Orion KL,ISM: molecules,line: identification,molecular data},
  annotation = {ADS Bibcode: 2013ApJ...770L..13T},
  file = {/Users/brett/Zotero/storage/K4J7HMRQ/Tercero et al. - 2013 - Discovery of Methyl Acetate and Gauche Ethyl Formate in Orion.pdf}
}

@article{Tercero:2015:L1,
  title = {Searching for Trans Ethyl Methyl Ether in {{Orion KL}}{$\star$}},
  author = {Tercero, B. and Cernicharo, J. and L{\'o}pez, A. and Brouillet, N. and Kolesnikov{\'a}, L. and Motiyenko, R. A. and Margul{\`e}s, L. and Alonso, J. L. and Guillemin, J. -C.},
  year = 2015,
