}

@article{Matthews:1984:125,
  title = {A New Interstellar Molecule: Triearbon Monoxide},
  shorttitle = {A New Interstellar Molecule},
  author = {Matthews, H. E. and Irvine, W. M. and Friberg, P. and Brown, R. D. and Godfrey, P. D.},
  year = 1984,
  month = jul,
  journal = {Nature},
  volume = {310},
  pages = {125--126},
  issn = {0028-0836},
  doi = {10.1038/310125a0},
  urldate = {2025-04-15},
  abstract = {The cold dark interstellar Taurus Molecular Cloud One (TMC-1) is a rich source of acetylenic and polyacetylenic molecular species. As well as linear closed-shell molecules (H(C{$\equiv$}C)nCN) and symmetric rotors (CH3C{$\equiv$}CH, CH3CCN), several radicals (C{$\equiv$}CH, C{$\equiv$}CCN, (C{$\equiv$}C)2H) have also been identified1-5, many of which had not been studied previously in the laboratory. Whether the observed abundances can be understood in terms of purely gas-phase ion-molecule chemical schemes, which produce reasonable agreement for the simplest polyatomic species, is unclear6,7; alternative models involving the participate interstellar grains as catalysts or sources have also been suggested8,9. We now report the detection in TMC-1 of a new molecule, triearbon monoxide (C3O), whose pure rotational spectrum has only very recently been studied in the laboratory. As C3O is the first known interstellar carbon chain molecule to contain oxygen, its existence places an important new constraint on chemical schemes for cold interstellar clouds. In fact, the observed abundance of triearbon monoxide fits quite well into our model of galactochemistry.},
  keywords = {Abundance,Astrophysics,Carbon Monoxide,Hydrogen Clouds,Interstellar Gas,Molecular Clouds,Molecular Spectra,Rotational Spectra},
  annotation = {ADS Bibcode: 1984Natur.310..125M}
}

@article{Mauersberger:1990:63,
  title = {Dense Gas in Nearby Galaxies. {{III}}. {{HC}}{\textsubscript{3}}{{N}} as an Extragalactic Density Probe.},
  author = {Mauersberger, R. and Henkel, C. and Sage, L. J.},
  year = 1990,
  month = sep,
  journal = {Astronomy and Astrophysics},
  volume = {236},
  pages = {63},
  issn = {0004-6361},
  urldate = {2025-04-15},
  abstract = {Six mm-wave transitions of cyanoacetylene (HC\_3\_N) have been detected toward the nucleus of the star burst galaxy NGC 253, thus confirming an earlier tentative detection of the heaviest molecule observed outside the Galaxy. There are two separate velocity components associated with hotspots on the molecular bar. The observed line intensities have been compared with results from a large velocity gradient (LVG) model. The bulk of the gas observed in HC\_3\_N has moderate densities of order 10\textasciicircum 4\textasciicircum{} cm\textasciicircum -3\textasciicircum{} and a beam-filling factor {$>$} 10\%. The 2mm lines and the 26 - 25 line at 1.3 mm indicate that there is a second component of molecular gas with a lower filling factor but much higher excitation (n(H\_2\_) {$>$}= 10\textasciicircum 5\textasciicircum{} cm\textasciicircum -3\textasciicircum, T\_kin\_ {$>$}= 60 K). The relative abundance of HC\_3\_N toward NGC 253 is 410\textasciicircum\_9\textasciicircum, which is comparable to that in the Orion hot core and TMC 1 but is larger than the relative abundance in many other nearby ''quiescent'' clouds. The relative amount of highly excited, dense gas is larger than in the Galactic center molecular clouds.},
  keywords = {Astrophysics,Cyanoacetylene,Galactic Nuclei,Gas Density,Line Spectra,Milky Way Galaxy,Millimeter Waves,Molecular Gases,Starburst Galaxies},
  annotation = {ADS Bibcode: 1990A\&A...236...63M},
  file = {/Users/brett/Zotero/storage/PV8B4RJ9/Mauersberger et al. - 1990 - Dense gas in nearby galaxies. III. HC3N as an extragalactic density probe..pdf}
}

@article{Mauersberger:1991:307,
  title = {Dense Gas in Nearby Galaxies. {{V}}. {{Multilevel}} Studies of {{CH}}{\textsubscript{3}}{{CCH}} and {{CH}}{\textsubscript{3}}{{CN}}.},
  author = {Mauersberger, R. and Henkel, C. and Walmsley, C. M. and Sage, L. J. and Wiklind, T.},
  year = 1991,
  month = jul,
  journal = {Astronomy and Astrophysics},
  volume = {247},
  pages = {307},
  issn = {0004-6361},
  urldate = {2025-04-15},
  abstract = {The first detections of methyl acetylene (CH\_3\_CCH) and methyl cyanide (CH\_3\_CN) emission from outside our Galaxy are reported. Five mm- wave lines of CH\_3\_CCH have been measured toward the molecular hotspot 15" SW of the center of M 82; four transitions have been observed toward the center of the starburst galaxy NGC 253. CH\_3\_CCH is the most complex molecule detected outside the Galaxy. Its abundances in M 82 and NGC 253 are similar to those measured in Galactic clouds. CH\_3\_CN has been detected in at least three mm-wave transitions toward the center of NGC 253, where its abundance is `normal'. A sensitive search toward the center of M 82 shows that CH\_3\_CN is underabundant compared with Galactic clouds. These results confirm the different chemical compositions of the nuclear gas in M 82 and NGC 253. Aside of a likely difference in kinetic temperature, there must be additional effects causing the observed discrepancies; several alternatives are discussed. For both galaxies studied, densities of a few times 10\textasciicircum 4\textasciicircum{} cm\textasciicircum -3\textasciicircum{} are required to match the observed CH\_3\_CCH and CH\_3\_CN line intensity ratios. As a byproduct, mm-emission of the ring molecule C\_3\_H\_2\_ was detected toward M 82 and NGC 253. Toward the SW hotspot of M 82, the H41{$\alpha$} recombination line was measured.},
  keywords = {Acetonitrile,Acetylene,Astronomical Models,Astrophysics,Galactic Nuclei,Gas Composition,Gas Density,Intergalactic Media,Line Spectra,Methyl Compounds,Milky Way Galaxy,Millimeter Waves},
  annotation = {ADS Bibcode: 1991A\&A...247..307M},
  file = {/Users/brett/Zotero/storage/6NW8U38Z/Mauersberger et al. - 1991 - Dense gas in nearby galaxies. V. Multilevel studies of CH3CCH and CH3CN..pdf}
}

@article{Mauersberger:1991:457,
  title = {Dense Gas in Nearby Galaxies. {{IV}}. {{The}} Detection of {{N}}{\textsubscript{2}}{{H}}{\textsuperscript{+}}, {{SiO}}, {{H}}{\textsuperscript{13}}{{CO}}{\textsuperscript{+}}, {{H}}{\textsuperscript{13}}{{CN}} and {{HN}}{\textsuperscript{13}}{{C}}.},
  author = {Mauersberger, R. and Henkel, C.},
  year = 1991,
  month = may,
  journal = {Astronomy and Astrophysics},
  volume = {245},
  pages = {457},
  issn = {0004-6361},
  urldate = {2025-04-15},
  abstract = {Studying the dense molecular gas in the nuclei of nearby spirals with high infrared luminosities, first detections of extragalactic N\_2\_H\textasciicircum +\textasciicircum, SiO, H\textasciicircum 13\textasciicircum CO\textasciicircum +\textasciicircum, H\textasciicircum 13\textasciicircum CN, and HN\textasciicircum 13\textasciicircum C are reported. The J=1-0 line of N\_2\_H\textasciicircum +\textasciicircum{} was observed in the central parts of NGC 253. Maffei 2, IC 342, M 82, and NGC 6946. A map toward NGC 253 indicates that the spatial distribution of N\_2\_H\textasciicircum +\textasciicircum{} follows that of CS. Toward M 82, however, N\_2\_H\textasciicircum +\textasciicircum{} is centrally peaked, while strongest emission of other molecules arises from a circumnuclear "ring". This difference as well as the peculiar distribution of another ion, HCO\textasciicircum +\textasciicircum, is explained in terms of gas phase chemistry. The J=2-1 and 3-2 lines of the ground vibrational state of SiO (v=0) were detected toward the nuclear region of NGC 253. H\textasciicircum 13\textasciicircum CO was detected in NGC 253, IC 342, and tentatively in M 82. H\textasciicircum 13\textasciicircum CN and HN\textasciicircum 13\textasciicircum C were observed in NGC 253 alone. The integrated line intensity ratio is I(H\textasciicircum 13\textasciicircum CN)/I(HN\textasciicircum 13\textasciicircum C)=2.2+/-0.5. The SiO source toward NGC 253 is extended ({$>>$} 1 pc). The intensity of SiO emission relative to that of other high density tracing molecules approaches that in hot, dense Galactic cloud cores like e.g. Orion KL. It is much lower toward M 82, namely by factors {$>$}= 2-5. CH\_3\_OH is showing a similar behaviour. Since it has been demonstrated that the abundances of SiO and CH\_3\_OH increase with temperature, it is suggested that the molecular environment associated with the nucleus of NGC 253 is warmer than the gas of the other nuclei observed. A very effective heating mechanism, e.g. the dissipation of tidal energy, is required to heat up such a large amount of gas. The main difference between the dense circumnuclear structures in NGC 253 and M 82 is their extent, which explains the complexity of the observed spatial distributions toward M 82 and may also be the cause for the high kinetic temperature in the core of NGC 253. In contrast to known sources in the Galactic disk, galactic center clouds may be warm without being exceptionally dense. As a consequence, typical tracers for `quiescent' gas as N\_2\_H\textasciicircum +\textasciicircum{} and for `violent' gas as SiO and CH\_3\_OH may coexist in the nuclear regions of NGC 253 and the Milky Way.},
  keywords = {Astrophysics,Cosmic Gases,Cosmochemistry,Galactic Nuclei,Molecular Clouds,Nitrogen Hydrides,Silicon Oxides,Spiral Galaxies},
  annotation = {ADS Bibcode: 1991A\&A...245..457M},
  file = {/Users/brett/Zotero/storage/4KLRZQW3/Mauersberger and Henkel - 1991 - Dense gas in nearby galaxies. IV. The detection of N2H+, SiO, H13CO+, H13CN and HN13C..pdf}
}

@article{Mauersberger:1995:23,
  title = {Dense Gas in Nearby Galaxies. {{VIII}}. {{The}} Detection of {{OCS}}.},
  author = {Mauersberger, R. and Henkel, C. and Chin, Y. -N.},
  year = 1995,
  month = feb,
  journal = {Astronomy and Astrophysics},
  volume = {294},
  pages = {23--32},
  issn = {0004-6361},
  urldate = {2025-04-15},
  abstract = {The detection of extragalactic OCS, the heaviest molecule identified outside the Galaxy, is reported in three rotational transitions toward the bulge of NGC253. Toward M82, OCS has been tentatively detected. Abundances are consistent with models for warm, dense clouds which have not yet reached chemical equilibrium or with the frequent erosion of grain mantles by C-shocks. This can also explain the large abundances of complex molecules in NGC253. Densities and temperatures of the OCS emitting gas are compared with results from other molecular tracers. From model computations, OCS in the center of NGC253 is emitted by a moderately dense molecular component with n(H\_2\_)\textasciitilde 10\textasciicircum 3.4\textasciicircum cm\textasciicircum -3\textasciicircum. This component makes up the bulk of the molecular gas mass. Other molecules also reveal the presence of a much denser component with 10\textasciicircum 5-5.5\textasciicircum cm\textasciicircum -3\textasciicircum. A molecular gas mass of \textasciitilde 210\textasciicircum 8\textasciicircum Msun\_ is estimated for a 180pc sized molecular cloud toward the center of NGC253; the mean H\_2\_ density is \textasciitilde 2000cm\textasciicircum -3\textasciicircum; and the mean H\_2\_ column density, 7x10\textasciicircum 23\textasciicircum cm\textasciicircum -2\textasciicircum, corresponds to a visual extinction of 700mag. The relative OCS abundance is X(OCS)\textasciitilde 10\textasciicircum -8.9\textasciicircum. From detections of the J=2-1 and 3-2 transitions of C\textasciicircum 34\textasciicircum S, the density of the dense molecular gas toward the nuclear region of IC342 is n(H\_2\_)\textasciitilde 10\textasciicircum 4.6\textasciicircum cm\textasciicircum -3\textasciicircum. Also presented are a possible detection of the HC\_3\_N J=16-15 line toward IC342 and upper limits for the emission of the DCN J=2-1 line toward NGC253 and IC342. For NGC253, [DCN]/[HCN]{$<$}=4x10\textasciicircum -3\textasciicircum.},
  keywords = {GALAXIES,GALAXIES: ISM,IC342 RADIO LINES: GALAXIES,INDIVIDUAL: NGC253,ISM: MOLECULES,M82},
  annotation = {ADS Bibcode: 1995A\&A...294...23M},
  file = {/Users/brett/Zotero/storage/5CZ88ZIZ/Mauersberger et al. - 1995 - Dense gas in nearby galaxies. VIII. The detection of OCS..pdf}
}

