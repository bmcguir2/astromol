@article{Lovas:2006:L137,
  title = {Detection of {{Ketenimine}} ({{CH}}{\textsubscript{2}}{{CNH}}) in {{Sagittarius B2}}({{N}}) {{Hot Cores}}},
  author = {Lovas, F. J. and Hollis, J. M. and Remijan, Anthony J. and Jewell, P. R.},
  year = 2006,
  month = jul,
  journal = {The Astrophysical Journal},
  volume = {645},
  pages = {L137-L140},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1086/506324},
  urldate = {2025-04-15},
  abstract = {Ketenimine (CH2CNH) has been detected in absorption toward the star-forming region Sagittarius B2(N) with the 100 m Green Bank Telescope by means of three rotational transitions: 716-808 at 41.5 GHz, 819-909 at 23.2 GHz, and 918-100,10 at 4.9 GHz. Ketenimine has a sparse rotational spectrum below 50 GHz. From transition line strength arguments, the spectral lines found are the ones most likely to be detected, and they occur in spectral regions that have little possibility of confusion with other molecular species. Partially resolved hyperfine structure is apparent in the 4.9 GHz transition, which has energy levels \textasciitilde 50 K above the ground-state level; the absorption seen in this transition appears to be emanating from gas in close proximity to the LMH hot core that has a systemic LSR velocity of +64 km s-1. By comparison, the 41.5 and 23.2 GHz transitions have lower energy levels of \textasciitilde 33 and \textasciitilde 41 K, respectively, and show absorption against the two star-forming Sgr B2(N) hot cores with systematic LSR velocities of +64 (the LMH) and +82 km s-1. These ketenimine data show that the hot core at +82 km s-1 is cooler than the hot core at +64 km s-1. Ketenimine is likely formed directly from its isomer methyl cyanide (CH3CN) by tautomerization driven by shocks that pervade the star-forming region.},
  keywords = {ISM: Abundances,ISM: Clouds,ISM: Individual: Name: Sagittarius B2(N-LMH),ISM: Molecules,Radio Lines: ISM},
  annotation = {ADS Bibcode: 2006ApJ...645L.137L},
  file = {/Users/brett/Zotero/storage/SD8R8LG4/Lovas et al. - 2006 - Detection of Ketenimine (CH2CNH) in Sagittarius B2(N) Hot Cores.pdf}
}

@article{Lovas:2006:L37,
  title = {Hyperfine {{Structure Identification}} of {{Interstellar Cyanoallene}} toward {{TMC-1}}},
  author = {Lovas, F. J. and Remijan, Anthony J. and Hollis, J. M. and Jewell, P. R. and Snyder, L. E.},
  year = 2006,
  month = jan,
  journal = {The Astrophysical Journal},
  volume = {637},
  pages = {L37-L40},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1086/500431},
  urldate = {2025-04-15},
  abstract = {Interstellar cyanoallene (CH2CCHCN) has been detected with the 100 m Green Bank Telescope (GBT) toward the dark Taurus molecular cloud (TMC-1) by means of the 414-313, 404-303, 515-414, and 505-404 rotational transitions at 20.2, 20.6, 25.2, and 25.7 GHz, respectively. The hyperfine structure (hfs) of the 414-313 transition is resolved; the remaining transitions have hfs components that are blended but are inferred owing to line width excesses atypical of TMC-1. An analysis of these four rotational transitions yields an average column density NT=2.0(5) \texttimes 1012 cm-2 at an assumed rotational temperature of 4 K. The cyanoallene isomer methylcyanoacetylene (CH3CCCN) has previously been observed in TMC-1 and found to have a rotational temperature of \textasciitilde 4 K by other investigators. Using the GBT, the K=0 and K=1 structure of the JK=5K-4K transition of methylcyanoacetylene was resolved toward TMC-1 and a total column density of NT=4.5(4)\texttimes 1011 cm-2 was obtained for the 4 K rotational temperature. Thus, cyanoallene appears to be more abundant than methylcyanoacetylene toward TMC-1 by a factor of \textasciitilde 4.5. The implications of this result are discussed in terms of relative bonding energy differences and possible differences in formation chemistry.},
  keywords = {ISM: Abundances,ISM: Clouds,ISM: individual (Taurus molecular cloud),ISM: Molecules,Radio Lines: ISM},
  annotation = {ADS Bibcode: 2006ApJ...637L..37L},
  file = {/Users/brett/Zotero/storage/IBBAPXF4/Lovas et al. - 2006 - Hyperfine Structure Identification of Interstellar Cyanoallene toward TMC-1.pdf}
}

