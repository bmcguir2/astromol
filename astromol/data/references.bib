  title = {Interstellar Detection and Chemical Modeling of Iso-Propanol and Its Normal Isomer},
  author = {Belloche, A. and Garrod, R. T. and Zingsheim, O. and M{\"u}ller, H. S. P. and Menten, K. M.},
  year = 2022,
  month = jun,
  journal = {Astronomy and Astrophysics},
  volume = {662},
  number = {A110},
