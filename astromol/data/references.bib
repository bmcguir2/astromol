@article{Zeng:2019:L43,
  title = {First Detection of the Pre-Biotic Molecule Glycolonitrile ({{HOCH}}{\textsubscript{2}}{{CN}}) in the Interstellar Medium},
  author = {Zeng, S. and Qu{\'e}nard, D. and {Jim{\'e}nez-Serra}, I. and {Mart{\'i}n-Pintado}, J. and Rivilla, V. M. and Testi, L. and {Mart{\'i}n-Dom{\'e}nech}, R.},
  year = 2019,
  month = mar,
  journal = {Monthly Notices of the Royal Astronomical Society},
  volume = {484},
  pages = {L43-L48},
  publisher = {OUP},
  issn = {0035-8711},
  doi = {10.1093/mnrasl/slz002},
  urldate = {2025-04-17},
  abstract = {Theories of a pre-RNA world suggest that glycolonitrile (HOCH2CN) is a key species in the process of ribonucleotide assembly, which is considered as a molecular precursor of nucleic acids. In this Letter, we report the first detection of this pre-biotic molecule in the interstellar medium by using ALMA data obtained at frequencies between 86.5 GHz and 266.5 GHz toward the Solar-type protostar IRAS16293-2422 B. A total of 15 unblended transitions of HOCH2CN were identified. Our analysis indicates the presence of a cold (T\_\textbraceleft ex\textbraceright{} = 24 \textpm{} 8 K) and a warm (T\_\textbraceleft ex\textbraceright{} = 158 \textpm{} 38 K) component meaning that this molecule is present in both the inner hot corino and the outer cold envelope of IRAS16293 B. The relative abundance with respect to H2 is (6.5 \textpm{} 0.6) \texttimes{} 10-11 and {$\geq$}(6 \textpm{} 2) \texttimes{} 10-10 for the warm and cold components, respectively. Our chemical modelling seems to underproduce the observed abundance for both the warm and cold component under various values of the cosmic ray ionization rate ({$\zeta$}). Key gas phase routes for the formation of this molecule might be missing in our chemical network.},
  keywords = {Astrophysics - Astrophysics of Galaxies,Astrophysics - Solar and Stellar Astrophysics,Instrumentation: interferometers,ISM: individual: IRAS16293-2422 B,ISM: molecules,line: identification},
  annotation = {ADS Bibcode: 2019MNRAS.484L..43Z},
  file = {/Users/brett/Zotero/storage/MG38VB9P/Zeng et al. - 2019 - First detection of the pre-biotic molecule glycolonitrile (HOCH2CN) in the interstellar medium.pdf}
}

