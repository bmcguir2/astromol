@article{Demaison:1984:560,
  title = {Millimeter-{{Wave Spectrum}} of {{Ethyl Formate}}},
  author = {Demaison, J. and Boucher, D. and Burie, J. and Dubrulle, A.},
  year = 1984,
  month = jun,
  journal = {Zeitschrift Naturforschung Teil A},
  volume = {39},
  pages = {560--564},
  issn = {0932-0784},
  doi = {10.1515/zna-1984-0608},
  urldate = {2025-04-11},
  abstract = {The rotational spectrum of ethyl formate has been investigated up to 240 GHz. High J transitions of both a-type and b-type have been measured for the two isomers and fitted to a centrifugally distorted Hamiltonian including some sextic coefficients. The results of the analysis are sufficiently accurate for the prediction of all strong transitions throughout the millimeterwave range. No splitting due to the internal rotation of the methyl group was observed, which indicates that the barrier to internal rotation is of the order of 3 kcal/mole or greater.},
  annotation = {ADS Bibcode: 1984ZNatA..39..560D},
