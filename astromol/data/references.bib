@article{Guelin:1991:L21,
  title = {Astronomical Detection of the {{HCCN}} Radical. {{Toward}} a New Family of Carbon-Chain Molecules ?},
  author = {Guelin, M. and Cernicharo, J.},
  year = 1991,
  month = apr,
  journal = {Astronomy and Astrophysics},
  volume = {244},
  pages = {L21},
  issn = {0004-6361},
  urldate = {2025-04-14},
  abstract = {The detection in space of HCCN, a radical with an unusual allenic structure, is reported. HCCN is found to be a factor of two more abundant than CH3CN in the circumstellar envelope IRC+10216, but much less abundant than this stable species in the giant clouds Sgr B2 and Orion A. The beam-averaged HCCN column density is 1.2 x 10 to the 13th/sq cm in IRC+10216, = 10 to the 13th/sq cm or less in Sgr B2, and less than 5 x 10 to the 12th/sq cm in Orion A. Two related radicals, CCN and CH2CN, were not detected in IRC+10216; upper limits of 5-7 x 10 to the 13th/sq cm to their column densities are derived. HCCN seems difficult to form like HC3N and the cyanopolyynes from acetylenic ions. Its detection suggests that other members of the HC2nN family could be observed in space.},
  keywords = {Astronomical Spectroscopy,Astrophysics,Carbon Compounds,Electron Recombination,Interstellar Matter,Line Spectra,Radicals,Radio Astronomy,Stellar Atmospheres,Stellar Composition,Stellar Mass Ejection},
  annotation = {ADS Bibcode: 1991A\&A...244L..21G},
  file = {/Users/brett/Zotero/storage/VHZTFBXR/Guelin and Cernicharo - 1991 - Astronomical detection of the HCCN radical. Toward a new family of carbon-chain molecules .pdf}
}

@article{Guelin:1997:L1,
  title = {Detection of a New Linear Carbon Chain Radical: {{C}}{\textsubscript{7}}{{H}}.},
  shorttitle = {Detection of a New Linear Carbon Chain Radical},
  author = {Guelin, M. and Cernicharo, J. and Travers, M. J. and McCarthy, M. C. and Gottlieb, C. A. and Thaddeus, P. and Ohishi, M. and Saito, S. and Yamamoto, S.},
  year = 1997,
  month = jan,
  journal = {Astronomy and Astrophysics},
  volume = {317},
  pages = {L1-L4},
  issn = {0004-6361},
  urldate = {2025-04-14},
  abstract = {Following our discovery of C\_8\_H in IRC+10216 (Cernicharo \& Guelin 1996A\&A...309L..27C), we report the detection in this circumstellar envelope of another linear carbon chain radical, C\_7\_H. The microwave spectrum of C\_7\_H has been recently observed in the laboratory (Travers et al. 1996ApJ...465L..77T) and its rotational line frequencies are precisely known. With this new detection, the family of acetylenic chain radicals (C\_n\_H) observed in space is complete up to n=8. The members with even numbers of carbon atoms are consistently more abundant than the odd number members; C\_7\_H is found to be a factor of 4 less abundant than C\_8\_H and a factor of 20 less abundant than C\_5\_H.},
  keywords = {CIRCUMSTELLAR MATTER,ISM: MOLECULES,RADIO LINES: STARS,STARS: AGB,STARS: MOLECULAR DATA},
  annotation = {ADS Bibcode: 1997A\&A...317L...1G},
  file = {/Users/brett/Zotero/storage/7CKDVAEX/Guelin et al. - 1997 - Detection of a new linear carbon chain radical C_7_H..pdf}
}

@article{Guelin:1998:L1,
