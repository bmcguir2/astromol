@article{Cheung:1994:443,
  title = {Rotational {{Structure}} and {{Perturbations}} in the {{B}}{\textsuperscript{4}}{{$\Pi$- X}}{\textsuperscript{4}}{{$\Sigma$}} {\textsuperscript{-}} (1, 0) {{Band}} of {{VO}}},
  author = {Cheung, A. S. C. and Hajigeorgiou, P. G. and Huang, G. and Huang, S. Z. and Merer, A. J.},
  year = 1994,
  month = feb,
  journal = {Journal of Molecular Spectroscopy},
  volume = {163},
  pages = {443--458},
  issn = {0022-2852},
  doi = {10.1006/jmsp.1994.1039},
  urldate = {2025-04-10},
  abstract = {The (1, 0) band of the B4{$\Pi$}- X4{$\Sigma$} - transition of VO has been analyzed rotationally, from Doppler-limited discharge emission and laser excitation spectra. The B4{$\Pi$}, v = 1 level is heavily perturbed by a vibrational level of the a2{$\Sigma$} + state and, with the extra complexity caused by the 51V nuclear hyperfine structure, could be analyzed fully only by extensive wavelength-resolved laser-induced fluorescence experiments. Making use of data from the corresponding perturbations in B4{$\Pi$}, v = 0 and assuming that the vibrational dependence of the spin-orbit matrix element can be represented by a vibrational overlap integral, it has been possible to deduce the vibrational numbering of the perturbing a2{$\Sigma$} + state without having to use isotopic data. It is found that the a2{$\Sigma$} +, v = 0 level lies near 10412 cm -1, and that B4{$\Pi$}, v = 1 is perturbed by a2{$\Sigma$} +, v = 3. The a2{$\Sigma$} + state comes from the same electron configuration, (4 s{$\sigma$}) (3 d{$\delta$}) 2, as the X4{$\Sigma$} - ground state. The phases of the spin-orbit matrix elements between 4{$\Pi$} and 2{$\Sigma$} + states must be chosen consistently in order to obtain a correct understanding of the rotational perturbations. A consistent set of phases is obtained with {$<$} 2{$\Sigma$} +, F 2 \textbar{} H SO \textbar{} 4{$\Pi$} \textbraceleft 1\textbraceright/\textbraceleft 2\textbraceright, f{$>$} = {$<$} 2{$\Sigma$} +, F 1 \textbar{} H SO \textbar{} 4{$\Pi$} \textbraceleft 1\textbraceright/\textbraceleft 2\textbraceright, e{$>$} = [formula] {$<$} 2{$\Sigma$} +, F 2 \textbar{} H SO \textbar{} 4{$\Pi$} - \textbraceleft 1\textbraceright/\textbraceleft 2\textbraceright, f{$>$} = -{$<$} 2{$\Sigma$} +, F 1 \textbar{} H SO \textbar{} 4{$\Pi$} - \textbraceleft 1\textbraceright/\textbraceleft 2\textbraceright, e{$>$} = A/2, whereA = {$<$} 2{$\Sigma$}+ \textbar\textbar{} Hspin- orbit \textbar\textbar{} 4{$\Pi>$}.},
  annotation = {ADS Bibcode: 1994JMoSp.163..443C}
}

@article{Chomiak:1994:1078,
  title = {Millimetre-Wave Laboratory Detection of {{H}}{\textsubscript{2}}{{COH}}{\textsuperscript{+}}},
