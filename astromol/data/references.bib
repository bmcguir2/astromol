@article{Tenenbaum:2007:L29,
  title = {Identification of {{Phosphorus Monoxide}} ({{X}}{\textsuperscript{2}}{{$\Pi$}}{\textsubscript{r}}) in {{VY Canis Majoris}}: {{Detection}} of the {{First PO Bond}} in {{Space}}},
  shorttitle = {Identification of {{Phosphorus Monoxide}} ({{X2$\Pi$r}}) in {{VY Canis Majoris}}},
  author = {Tenenbaum, E. D. and Woolf, N. J. and Ziurys, L. M.},
  year = 2007,
  month = sep,
  journal = {The Astrophysical Journal},
  volume = {666},
  pages = {L29-L32},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1086/521361},
  urldate = {2025-04-17},
  abstract = {A new interstellar molecule, PO (X2{$\Pi$}r), has been detected toward the envelope of the oxygen-rich supergiant star VY Canis Majoris (VY CMa) using the Submillimeter Telescope of the Arizona Radio Observatory. The J=5.5--{$>$}4.5 and J=6.5--{$>$}5.5 rotational transitions of PO at 240 and 284 GHz were observed, each of which consisted of well-defined lambda-doublets. The line profiles are roughly parabolic in shape, analogous to PN, and suggest that this species arises from the spherical wind in VY CMa, as opposed to the collimated blue- and redshifted outflows. Comparison of line intensities indicates that PO arises from a confined source roughly 1" in extent, with a column density of Ntot \textasciitilde = 2.8 \texttimes{} 1015 cm-2, which corresponds to a fractional abundance of f\textasciitilde 9\texttimes 10-8, relative to H2. Consequently, PO and PN have similar concentrations in VY CMa, a result not predicted by either LTE or kinetic models of circumstellar chemistry. These phosphorus compounds may arise from shock-induced reactions in this active envelope. Phosphorus monoxide is the first interstellar molecule detected that contains a PO bond, a moiety essential in biochemical compounds. It is also the first new species to be identified in an oxygen-rich, as opposed to a carbon-rich, circumstellar envelope.},
  keywords = {Astrobiology,Astrochemistry,ISM: Molecules,Radio Lines: Stars,Stars: Circumstellar Matter,Stars: Individual: Constellation Name: VY Canis Majoris},
  annotation = {ADS Bibcode: 2007ApJ...666L..29T},
  file = {/Users/brett/Zotero/storage/A6H2GNJ5/Tenenbaum et al. - 2007 - Identification of Phosphorus Monoxide (X2Πr) in VY Canis Majoris Detection of the First PO Bond in.pdf}
}

@article{Tenenbaum:2008:L121,
  title = {A {{Search}} for {{Phosphine}} in {{Circumstellar Envelopes}}: {{PH}}{\textsubscript{3}} in {{IRC}} +10216 and {{CRL}} 2688?},
  shorttitle = {A {{Search}} for {{Phosphine}} in {{Circumstellar Envelopes}}},
  author = {Tenenbaum, E. D. and Ziurys, L. M.},
  year = 2008,
  month = jun,
  journal = {The Astrophysical Journal},
  volume = {680},
  pages = {L121},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1086/589973},
  urldate = {2025-04-17},
  abstract = {We present the results of a search for the JK = 10{$\rightarrow$} 00 transition of PH3 (phosphine) at 267 GHz toward several circumstellar envelopes using the Arizona Radio Observatory 10 m Submillimeter Telescope (SMT). In the carbon-rich shells of IRC +10216 and CRL 2688, we have detected emission lines exactly at the PH3 frequency. Toward the oxygen-rich supergiant VY Canis Majoris, only an upper limit was obtained, while in the evolved carbon-rich proto-planetary nebula CRL 618, the transition is contaminated by vibrationally excited HC3N ({$\nu$}7 = 4). The line shape in IRC +10216 appears to consist of two distinct components: a flat-topped profile with a width of \textasciitilde 28 km s-1, as is typical for this source, and a narrower feature approximately 4 km s-1 wide. The narrow component likely arises from the inner envelope (r {$<$} 8R*) where the gas has not reached the terminal expansion velocity, or it is nonthermal emission. Based on the broader component, the abundance of PH3 with respect to H2 is estimated to be 5 \texttimes{} 10-8 in a region with a radius of r {$<$} 150R*. If the narrower component is thermal, it implies a phosphine abundance of \textasciitilde 5 \texttimes{} 10-7 close to the stellar photosphere (r {$<$} 8R*). In CRL 2688, the PH3 abundance is less constrained, with plausible values ranging from 3 \texttimes{} 10-8 to 4 \texttimes{} 10-7, assuming a spherical distribution. Phosphine appears to be present in large concentrations in the inner envelope of C-rich AGB stars, and thus may function as a parent molecule for other phosphorus species.},
  keywords = {astrochemistry,circumstellar matter,ISM: molecules,radio lines: stars,stars: individual: CRL 2688 IRC +10216},
  annotation = {ADS Bibcode: 2008ApJ...680L.121T},
  file = {/Users/brett/Zotero/storage/Y2LCV9F2/Tenenbaum and Ziurys - 2008 - A Search for Phosphine in Circumstellar Envelopes PH3 in IRC +10216 and CRL 2688.pdf}
}

@article{Tenenbaum:2009:L59,
  title = {Millimeter {{Detection}} of {{AlO}} ({{X}}{\textsuperscript{2}}{{$\Sigma$}}{\textsuperscript{+}}): {{Metal Oxide Chemistry}} in the {{Envelope}} of {{VY Canis Majoris}}},
  shorttitle = {Millimeter {{Detection}} of {{AlO}} ({{X 2$\Sigma$}}+)},
  author = {Tenenbaum, E. D. and Ziurys, L. M.},
  year = 2009,
  month = mar,
  journal = {The Astrophysical Journal},
  volume = {694},
  pages = {L59-L63},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1088/0004-637X/694/1/L59},
  urldate = {2025-04-17},
  abstract = {A new circumstellar molecule, the radical AlO (X 2{$\Sigma$}+), has been detected toward the envelope of the oxygen-rich supergiant star VY Canis Majoris (VY CMa) using the Arizona Radio Observatory (ARO). The N = 7 {$\rightarrow$} 6 and 6 {$\rightarrow$} 5 rotational transitions of AlO at 268 and 230 GHz were observed at 1 mm using the ARO Submillimeter Telescope (SMT) and the N = 4 {$\rightarrow$} 3 line was detected at 2 mm using the ARO 12 m telescope. Based on the shape of the line profiles, AlO most likely arises from the dust-forming region in the spherical outflow of VY CMa, as opposed to the blue or redshifted winds, with a source size of \texttheta{} s \textasciitilde{} 0farcs5. Given this source size, the column density of AlO was found to be N tot \textasciitilde{} 2 \texttimes{} 1015 cm-2 for T rot \textasciitilde{} 230 K, with a fractional abundance, relative to H2, of \textasciitilde 10-8. Gas-phase thermodynamic equilibrium chemistry is the likely formation mechanism for AlO in VY CMa, but either shocks disrupt the condensation process into Al2O3, or chemical "freezeout" occurs. The species therefore survives further into the circumstellar envelope to a radius of r \textasciitilde{} 20 R *. The detection of AlO in VY CMa is additional evidence of an active gas-phase refractory chemistry in oxygen-rich envelopes, and suggests such objects may be fruitful sources for other new oxide identifications.},
  keywords = {astrochemistry,circumstellar matter,ISM: molecules,radio lines: stars,stars: individual: VY CMa},
  annotation = {ADS Bibcode: 2009ApJ...694L..59T}
}

@article{Tenenbaum:2010:L93,
  title = {Exotic {{Metal Molecules}} in {{Oxygen-rich Envelopes}}: {{Detection}} of {{AlOH}} ({{X}}{\textsuperscript{1}}{{$\Sigma$}}{\textsuperscript{+}}) in {{VY Canis Majoris}}},
  shorttitle = {Exotic {{Metal Molecules}} in {{Oxygen-rich Envelopes}}},
  author = {Tenenbaum, E. D. and Ziurys, L. M.},
  year = 2010,
  month = mar,
  journal = {The Astrophysical Journal},
  volume = {712},
  pages = {L93-L97},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1088/2041-8205/712/1/L93},
  urldate = {2025-04-17},
  abstract = {A new interstellar molecule, AlOH, has been detected toward the envelope of VY Canis Majoris (VY CMa), an oxygen-rich red supergiant. Three rotational transitions of AlOH were observed using the facilities of the Arizona Radio Observatory (ARO). The J = 9 {$\rightarrow$} 8 and J = 7 {$\rightarrow$} 6 lines at 1 mm were measured with the ARO Submillimeter Telescope, while the J = 5 {$\rightarrow$} 4 transition at 2 mm was observed with the ARO 12 m antenna on Kitt Peak. The AlOH spectra exhibit quite narrow line widths of 16-23 km s-1, as found for NaCl in this source, indicating that the emission arises from within the dust acceleration zone of the central circumstellar outflow. From a radiative transfer analysis, the abundance of AlOH relative to H2 was found to be \textasciitilde 1 \texttimes{} 10-7 for a source size of 0.26'' or 22 R* . In contrast, AlCl was not detected with f {$<$}= 5 \texttimes{} 10-8. AlOH is likely formed just beyond the photosphere via thermodynamic equilibrium chemistry and then disappears due to dust condensation. The AlOH/AlO abundance ratio found in VY CMa is \textasciitilde 17. Therefore, AlOH appears to be the dominant gas-phase molecular carrier of aluminum in this oxygen-rich shell. Local thermodynamic equilibrium calculations predict that the monohydroxides should be the major carriers of Al, Ca, and Mg in O-rich envelopes, as opposed to the oxides or halides. The apparent predominance of aluminum-bearing molecules in VY CMa may reflect proton addition processes in H-shell burning.},
  keywords = {astrochemistry,circumstellar matter,ISM: molecules,radio lines: stars,stars: individual: VY CMa,supergiants},
  annotation = {ADS Bibcode: 2010ApJ...712L..93T}
}

@article{Tercero:2012:A119,
  title = {Microwave and Submillimeter Spectroscopy and First {{ISM}} Detection of {\textsuperscript{18}}{{O-methyl}} Formate},
  author = {Tercero, B. and Margul{\`e}s, L. and Carvajal, M. and Motiyenko, R. A. and Huet, T. R. and Alekseev, E. A. and Kleiner, I. and Guillemin, J. C. and M{\o}llendal, H. and Cernicharo, J.},
  year = 2012,
  month = feb,
  journal = {Astronomy and Astrophysics},
  volume = {538},
  pages = {A119},
  publisher = {EDP},
  issn = {0004-6361},
  doi = {10.1051/0004-6361/201117072},
  urldate = {2025-04-17},
  abstract = {Context. Astronomical survey of interstellar molecular clouds needs a previous analysis of the spectra in the microwave and sub-mm energy range to be able to identify them. We obtained very accurate spectroscopic constants in a comprehensive laboratory analysis of rotational spectra. These constants can be used to predict transition frequencies that were not measured in the laboratory very precisely. Aims: We present an experimental study and a theoretical analysis of two 18O-methyl formate isotopologues, which were subsequently detected for the first time in Orion KL. Methods: The experimental spectra of both methyl formate isotopologues recorded in the microwave and sub-mm range from 1 to 660 GHz. Both spectra were analysed by using the rho-axis method (RAM) which takes into account the CH3 internal rotation. Results: We obtained spectroscopic constants of both 18O- methyl formate with high accuracy. Thousands of transitions were assigned and others predicted, which allowed us to detect both species in the IRAM 30 m line survey of Orion KL. Full Tables A.1 et A.2 are available at the CDS via anonymous ftp to cdsarc.u-strasbg.fr (130.79.128.5) or via http://cdsarc.u-strasbg.fr/viz-bin/qcat?J/A+A/538/A119},
  keywords = {astrochemistry,astronomical databases: miscellaneous,ISM: individual objects: Orion KL,ISM: molecules,line: identification,submillimeter: ISM},
  annotation = {ADS Bibcode: 2012A\&A...538A.119T},
  file = {/Users/brett/Zotero/storage/BR8E3XEU/Tercero et al. - 2012 - Microwave and submillimeter spectroscopy and first ISM detection of 18O-methyl formate.pdf}
}

@article{Tercero:2013:L13,
  title = {Discovery of {{Methyl Acetate}} and {{Gauche Ethyl Formate}} in {{Orion}}},
  author = {Tercero, B. and Kleiner, I. and Cernicharo, J. and Nguyen, H. V. L. and L{\'o}pez, A. and Mu{\~n}oz Caro, G. M.},
