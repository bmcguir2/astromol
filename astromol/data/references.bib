}

@article{Cernicharo:1996:L27,
  title = {Discovery of the {{C}}{\textsubscript{8}}{{H}} Radical.},
  author = {Cernicharo, J. and Guelin, M.},
  year = 1996,
  month = may,
  journal = {Astronomy and Astrophysics},
  volume = {309},
  pages = {L27-L30},
  issn = {0004-6361},
  urldate = {2025-04-10},
  abstract = {Searching for C\_7\_H and C\_8\_H in the carbon star envelope IRC+10216, we have identified 10 lines with harrnonically related frequencies and with regularly increasing intensities (3 lines in the IRAM 3mm spectral survey and 7 lines in the 7mm Nobeyama survey of Kawaguchi et al., 1995). The rest frequencies can be closely fitted with the standard expression for the energies of a linear molecule with a rotational constant B=586.676MHz, a distortion constant D=6.3Hz, and half-integer quantum numbers J. The value of B is within 0.1\% of that predicted by Pauzat et al. (1991) for the \textasciicircum 2PI ground state of C\_8\_H and the value of D typical of a linear acetylenic chain of C\_8\_H's weight. Since the half-integer J numbers are also consistent with a \textasciicircum 2PI state, we concluded that we had very probably discovered C\_8\_H. In the an accompanying Letter, McCarthy et al. report the detection of 30 lines of our new radical in an acetylene discharge and confirm they arise from C\_8\_H.},
  keywords = {CIRCUMSTELLAR MATTER,ISM: MOLECULES,RADIO LINES: STARS,STARS: AGB,STARS: MOLECULAR DATA},
  annotation = {ADS Bibcode: 1996A\&A...309L..27C},
  file = {/Users/brett/Zotero/storage/CSUEJU3Y/Cernicharo and Guelin - 1996 - Discovery of the C_8_H radical..pdf}
}

@article{Cernicharo:1997:L65,
  title = {Discovery of {{Far-Infrared Pure Rotational Transitions}} of {{CH}}{\textsuperscript{+}} in {{NGC}} 7027},
  author = {Cernicharo, J. and Liu, X. -W. and {Gonz{\'a}lez-Alfonso}, E. and Cox, P. and Barlow, M. J. and Lim, T. and Swinyard, B. M.},
  year = 1997,
  month = jul,
  journal = {The Astrophysical Journal},
  volume = {483},
  pages = {L65-L68},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1086/310729},
  urldate = {2025-04-10},
  abstract = {We report the discovery of the rotational spectrum of CH+ in the Infrared Space Observatory Long Wavelength Spectrometer (LWS) spectrum of the planetary nebula NGC 7027. The identification relies on a 1996 reanalysis of the LWS spectrum by Liu et al. and on new LWS data. The strong line at 179.62 {$\mu$}m (coinciding with the 212-101 transition of water vapor) and the lines at 119.90 and 90.03 {$\mu$}m (reported as unidentified by Liu et al.), whose frequencies are in the harmonic relation 2 : 3:4, are shown to arise from the J = 2-1, 3-2, and 4-3 rotational transitions of CH+. This identification is strengthened by the new LWS spectra of NGC 7027, which clearly show the next two rotational lines of CH+ at 72.140 and 60.247 {$\mu$}m. This is the first time that the pure rotational spectrum of CH+ has been observed. This discovery opens the possibility of probing the densest and warmest zones of photodissociation regions. We derive a rotational temperature for the CH+ lines of 150 +/- 20 K and a CH+/CO abundance ratio of 2-6 \texttimes{} 10-4. Based on observations with ISO, an ESA project with instruments funded by ESA Member States (especially the Principal Investigator countries: France, Germany, the Netherlands, and the United Kingdom) and with the participation of ISAS and NASA.},
  keywords = {Infrared: ISM: Lines and Bands,INFRARED: ISM: LINES AND BANDS,ISM: PLANETARY NEBULAE: INDIVIDUAL NGC NUMBER: NGC 7027,ISM: Planetary Nebulae: Individual: NGC Number: NGC 7027},
  annotation = {ADS Bibcode: 1997ApJ...483L..65C},
  file = {/Users/brett/Zotero/storage/8HXLS6M5/Cernicharo et al. - 1997 - Discovery of Far-Infrared Pure Rotational Transitions of CH+ in NGC 7027.pdf}
}

@article{Cernicharo:2000:L199,
  title = {Far-Infrared {{Detection}} of {{C}}{\textsubscript{3}} in {{Sagittarius B2}} and {{IRC}} +10216},
  author = {Cernicharo, Jos{\'e} and Goicoechea, Javier R. and Caux, Emmanuel},
  year = 2000,
  month = may,
  journal = {The Astrophysical Journal},
  volume = {534},
  pages = {L199-L202},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1086/312668},
  urldate = {2025-04-10},
  abstract = {We report on the detection of nine lines of the {$\nu$}2 bending mode of triatomic carbon, C3, in the direction of Sagittarius B2. The R(4) and R(2) lines of C3 have been also detected in the carbon-rich star IRC +10216. The abundances of C3 in the direction of Sgr B2 and IRC +10216 are \textasciitilde =3\texttimes 10-8 and \textasciitilde =10-6, respectively. In Sgr B2 we have also detected the 23-12 line of NH with an abundance of a few times 10-9. Polyatomic molecules will have a weak contribution from their pure rotational spectrum to the emission/absorption in the far-infrared. We suggest, however, that they could be, through their low-lying vibrational bending modes, the dominant carriers of emission/absorption in the spectrum of bright far-infrared sources. Based on observations with ISO, an ESA project with instruments funded by ESA Member States (especially the PI countries: France, Germany, the Netherlands, and the United Kingdom) and with participation of ISAS and NASA.},
  keywords = {INFRARED: ISM: LINES AND BANDS,ISM: INDIVIDUAL: NAME: SAGITTARIUS B2,ISM: MOLECULES,LINE: IDENTIFICATION,MOLECULAR DATA,RADIATIVE TRANSFER},
  annotation = {ADS Bibcode: 2000ApJ...534L.199C},
  file = {/Users/brett/Zotero/storage/TBJGRC2E/Cernicharo et al. - 2000 - Far-infrared Detection of C3 in Sagittarius B2 and IRC +10216.pdf}
}

@article{Cernicharo:2001:L123,
  title = {Infrared {{Space Observatory}}'s {{Discovery}} of {{C}}{\textsubscript{4}}{{H}}{\textsubscript{2}}, {{C}}{\textsubscript{6}}{{H}}{\textsubscript{2}}, and {{Benzene}} in {{CRL}} 618},
  author = {Cernicharo, Jos{\'e} and Heras, Ana M. and Tielens, A. G. G. M. and Pardo, Juan R. and Herpin, Fabrice and Gu{\'e}lin, Michel and Waters, L. B. F. M.},
  year = 2001,
  month = jan,
  journal = {The Astrophysical Journal},
  volume = {546},
  pages = {L123-L126},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1086/318871},
  urldate = {2025-04-10},
  abstract = {We report on the detection with the Infrared Space Observatory (ISO), for the first time in the circumstellar medium, of the polyacetylenic chains C4H2 and C6H2 and of benzene (C6H6) in the direction of the proto-planetary nebula CRL 618. Surprisingly, the abundances of di- and triacetylene are only a factor of 2-4 lower than that of C2H2. Benzene is \textasciitilde =40 times less abundant than acetylene. We suggest that the chemistry in CRL 618 has been strongly modified by the UV photons coming from the hot central star and by the shocks associated with its high-velocity winds. All the infrared bands arise from a region with kinetic temperatures between 200 and 250 K, probably the photodissociation region associated with the dense torus that surrounds the central star. C4H2 and C6H2 have also been detected in CRL 2688, so it seems that C-rich proto-planetary nebulae are the best organic chemistry factories in space.},
  keywords = {Infrared: General,ISM: Molecules,Line: Profiles,Stars: Circumstellar Matter,Stars: Individual: Alphanumeric: CRL 2688,Stars: Individual: Alphanumeric: CRL 618,Stars: Individual: Alphanumeric: NGC 7027},
  annotation = {ADS Bibcode: 2001ApJ...546L.123C},
  file = {/Users/brett/Zotero/storage/VFLG27GR/Cernicharo et al. - 2001 - Infrared Space Observatory's Discovery of C4H2, C6H2, and Benzene in CRL 618.pdf}
}

@article{Cernicharo:2004:L145,
  title = {Detection of the {{Linear Radical HC}}{\textsubscript{4}}{{N}} in {{IRC}} +10216},
  author = {Cernicharo, J. and Gu{\'e}lin, M. and Pardo, J. R.},
  year = 2004,
  month = nov,
  journal = {The Astrophysical Journal},
  volume = {615},
  pages = {L145-L148},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1086/426439},
  urldate = {2025-04-10},
  abstract = {We report the detection of the linear radical HC4N in the C-rich envelope of IRC +10216. After HCCN, HC4N is the second member of the allenic chain family HC2nN observed in space. The column density of HC4N is found to be 1.5\texttimes 1012 cm-2. The abundance ratio HC2N/HC4N is 9, a factor of 2 larger than the decrement observed for the cyanopolyynes (HC2n+1N/HC2n+3N). Linear HC4N has a 3{$\Sigma$} electronic ground state and is one of the three low-energy isomeric forms of this molecule. We have searched for the bent and ringed HC4N isomers but could only derive an upper limit to their column densities: {$<$}=3\texttimes 1012 cm-2 (at 3 {$\sigma$}).},
  keywords = {Astrochemistry,Astrophysics,ISM: Molecules,Line: Identification,Stars: AGB and Post-AGB,Stars: Individual: Alphanumeric: IRC +10216},
  annotation = {ADS Bibcode: 2004ApJ...615L.145C},
  file = {/Users/brett/Zotero/storage/H5UP2R9K/Cernicharo et al. - 2004 - Detection of the Linear Radical HC4N in IRC +10216.pdf}
}

@article{Cernicharo:2007:L37,
  title = {Astronomical Detection of {{C}}{\textsubscript{4}}{{H}}{\textsuperscript{-}}, the Second Interstellar Anion},
  author = {Cernicharo, J. and Gu{\'e}lin, M. and Ag{\'u}ndez, M. and Kawaguchi, K. and McCarthy, M. and Thaddeus, P.},
  year = 2007,
  month = may,
  journal = {Astronomy and Astrophysics},
  volume = {467},
  pages = {L37-L40},
  issn = {0004-6361},
  doi = {10.1051/0004-6361:20077415},
  urldate = {2025-04-10},
  abstract = {Aims:Following the recent detection of C6H- in the laboratory and in space we have succeeded in studying the microwave spectrum of C4H\textasciicircum -. We report here the first detection in space of this negative ion. Methods: We have observed in the envelope of the carbon star IRC +10216 five lines corresponding to the J = 9-8, 11-10, 12-11, 14-13 and 15-14 rotational transitions of C4H\textasciicircum -. The C4H- lines have a cusped shape, denoting that this ion is formed in the outer part of the envelope, like its neutral counterpart C4H. Results: The abundance of C4H- in IRC+10216 is 1/6 of the abundance of C6H- and 1/4200 of that of C4H. Conclusions: The detection of C4H\textasciicircum -, after that of C6H\textasciicircum -, confirms the theoretical prediction that C-chain anions are abundant in interstellar clouds and yields a first measurement of the electron radiative attachment rates. This work was based on observations carried out with the IRAM 30-m telescope. IRAM is supported by INSU/CNRS (France), MPG (Germany) and IGN (Spain).},
  keywords = {astrochemistry,line: identification,radio lines: stars,stars: AGB and post-AGB,stars: carbon,stars: individual: IRC+10216},
  annotation = {ADS Bibcode: 2007A\&A...467L..37C},
  file = {/Users/brett/Zotero/storage/RW4PE5ND/Cernicharo et al. - 2007 - Astronomical detection of C4H^-, the second interstellar anion.pdf}
}

@article{Cernicharo:2008:L83,
  title = {Detection of {{C}}{\textsubscript{5}}{{N}}{\textsuperscript{-}} and {{Vibrationally Excited C}}{\textsubscript{6}}{{H}} in {{IRC}} +10216},
  author = {Cernicharo, J. and Gu{\'e}lin, M. and Ag{\'u}ndez, M. and McCarthy, M. C. and Thaddeus, P.},
  year = 2008,
  month = dec,
  journal = {The Astrophysical Journal},
  volume = {688},
  pages = {L83},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1086/595583},
  urldate = {2025-04-10},
  abstract = {We report the detection in the envelope of the C-rich star IRC +10216 of four series of lines with harmonically related frequencies: B1389, B1390, B1394, and B1401. The four series must arise from linear molecules with mass and size close to those of C6H and C5N. Three of the series have half-integer rotational quantum numbers; we assign them to the 2{$\Delta$} and 2{$\Sigma$}- vibronic states of C6H in its lowest ({$\nu$}11) bending mode. The fourth series, B1389, has integer J with no evidence of fine or hyperfine structure; it has a rotational constant of 1388.860(2) MHz and a centrifugal distortion constant of 33(1) Hz; it is almost certainly the C5N- anion. Based on observations carried out with the IRAM 30 m telescope. IRAM is supported by INSU/CNRS (France), MPG (Germany), and IGN (Spain).},
  keywords = {Astrophysics,circumstellar matter,ISM: molecules,radio lines: ISM,stars: AGB and post-AGB,stars: individual: IRC +10216},
  annotation = {ADS Bibcode: 2008ApJ...688L..83C},
  file = {/Users/brett/Zotero/storage/Y47S5RYX/Cernicharo et al. - 2008 - Detection of C5N- and Vibrationally Excited C6H in IRC +10216.pdf}
}

@article{Cernicharo:2011:L3,
  title = {Probing the Dust Formation Region in {{IRC}} +10216 with the High Vibrational States of Hydrogen Cyanide},
  author = {Cernicharo, J. and Ag{\'u}ndez, M. and Kahane, C. and Gu{\'e}lin, M. and Goicoechea, J. R. and Marcelino, N. and De Beck, E. and Decin, L.},
  year = 2011,
  month = may,
  journal = {Astronomy and Astrophysics},
  volume = {529},
  pages = {L3},
  issn = {0004-6361},
  doi = {10.1051/0004-6361/201116717},
  urldate = {2025-04-10},
  abstract = {We report the detection in IRC +10216 of 63 rotational transitions of HCN, most of them with quantum numbers J = 3-2, pertaining to 28 different vibrational states with energies up to 10 700 K ({$\nu$}1+3{$\nu$}2+{$\nu$}3). Some of the transitions were also observed for the rare isotopologue H13CN. The observations were carried out with the IRAM 30-m telescope. The HCN lines with level energies above 5000 K arise within 1.5 stellar radius from the photosphere. Their intensities imply a vibrational temperature of Tvib {$\simeq$} 2400 K and a fractional HCN abundance relative to H2, x(HCN) = 5-7 \texttimes{} 10-5. These high-energy levels are mainly populated by photospheric radiation, and their vibrational temperature yields a direct measurement of the stellar photospheric temperature. The lines with energy levels between 2000 and 5000 K yield Tvib {$\simeq$} 1300 K and x(HCN) {$\simeq$} 0.8-2 \texttimes{} 10-5. They are radiatively excited and arise from a shell extending between 1.5 and 5 stellar radii. Finally, the lines from the low-energy vibrational states ({$<$}2000 K) trace a larger region of the envelope (5-28 stellar radii) with Tvib = 400-600 K and x(HCN) = 4-6 \texttimes{} 10-6. They are strongly affected by mid and near-infrared pumping. The line widths increase from 5 km s-1 near the 2400 K photosphere, to 19 km s-1 in the warm 400 K shell. This provides a unique insight into the physical conditions of the gas acceleration and dust formation region. This work was based on observations carried out with the IRAM 30-m telescope. IRAM is supported by INSU/CNRS (France), MPG (Germany) and IGN (Spain).Table 1 is available in electronic form at http://www.aanda.org},
  keywords = {astrochemistry,circumstellar matter,line: identification,molecular processes,stars: AGB and post-AGB,stars: individual: IRC +10216},
  annotation = {ADS Bibcode: 2011A\&A...529L...3C},
  file = {/Users/brett/Zotero/storage/F8PD9456/Cernicharo et al. - 2011 - Probing the dust formation region in IRC +10216 with the high vibrational states of hydrogen cyanide.pdf}
}

@article{Cernicharo:2012:L43,
  title = {Discovery of the {{Methoxy Radical}}, {{CH}}{\textsubscript{3}}{{O}}, toward {{B1}}: {{Dust Grain}} and {{Gas-phase Chemistry}} in {{Cold Dark Clouds}}},
  shorttitle = {Discovery of the {{Methoxy Radical}}, {{CH3O}}, toward {{B1}}},
  author = {Cernicharo, J. and Marcelino, N. and Roueff, E. and Gerin, M. and {Jim{\'e}nez-Escobar}, A. and Mu{\~n}oz Caro, G. M.},
  year = 2012,
  month = nov,
  journal = {The Astrophysical Journal},
  volume = {759},
  pages = {L43},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1088/2041-8205/759/2/L43},
  urldate = {2025-04-10},
  abstract = {We report on the discovery of the methoxy radical (CH3O) toward the cold and dense core B1-b based on the observation, with the IRAM 30 m radio telescope, of several lines at 3 and 2 mm wavelengths. Besides this new molecular species we also report on the detection of many lines arising from methyl mercaptan (CH3SH), formic acid (HCOOH), propynal (HCCCHO), acetaldehyde (CH3CHO), dimethyl ether (CH3OCH3), methyl formate (CH3OCOH), and the formyl radical (HCO). The column density of all these species is sime1012 cm-2, corresponding to abundances of sime10-11. The similarity in abundances for all these species strongly suggest that they are formed on the surface of dust grains and ejected to the gas phase through non-thermal desorption processes, most likely cosmic rays or secondary photons. Nevertheless, laboratory experiments indicate that the CH3O isomer released to the gas phase is CH2OH rather than the methoxy one. Possible gas-phase formation routes to CH3O from OH and methanol are discussed. This work was based on observations carried out with the IRAM 30 m telescope. IRAM is supported by INSU/CNRS (France), MPG (Germany), and IGN (Spain).},
  keywords = {ISM: abundances,ISM: molecules,line: identification,molecular data},
  annotation = {ADS Bibcode: 2012ApJ...759L..43C}
}

@article{Cernicharo:2013:L10,
  title = {Detection of the {{Ammonium Ion}} in {{Space}}},
  author = {Cernicharo, J. and Tercero, B. and Fuente, A. and Domenech, J. L. and Cueto, M. and Carrasco, E. and Herrero, V. J. and Tanarro, I. and Marcelino, N. and Roueff, E. and Gerin, M. and Pearson, J.},
  year = 2013,
  month = jul,
  journal = {The Astrophysical Journal},
  volume = {771},
  pages = {L10},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1088/2041-8205/771/1/L10},
  urldate = {2025-04-10},
  abstract = {We report on the detection of a narrow feature at 262816.73 MHz toward Orion and the cold prestellar core B1-bS which we attribute to the 10-00 line of the deuterated ammonium ion, NH3D+. The observations were performed with the IRAM 30 m radio telescope. The carrier has to be a light molecular species as it is the only feature detected over 3.6 GHz of bandwidth. The hyperfine structure is not resolved, indicating a very low value for the electric quadrupolar coupling constant of nitrogen which is expected for NH3D+ as the electric field over the N nucleus is practically zero. Moreover, the feature is right at the predicted frequency for the 10-00 transition of the ammonium ion, 262817 \textpm{} 6 MHz (3{$\sigma$}), using rotational constants derived from new infrared data obtained in our laboratory in Madrid. The estimated column density is (1.1 \textpm{} 0.2) \texttimes{} 1012 cm-2. Assuming a deuterium enhancement similar to that of NH2D, we derive N(NH\_4\textasciicircum +) \textasciitilde = 2.6 \texttimes{} 1013 cm-2, i.e., an abundance for ammonium of a few 10-11. This work was based on observations carried out with the IRAM 30 m telescope. IRAM is supported by INSU/CNRS (France), MPG (Germany), and IGN (Spain)},
  keywords = {Astrophysics - Astrophysics of Galaxies,ISM: abundances,ISM: individual objects: B1-bS,ISM: molecules,line: identification,molecular data},
  annotation = {ADS Bibcode: 2013ApJ...771L..10C},
  file = {/Users/brett/Zotero/storage/T58T9VQK/Cernicharo et al. - 2013 - Detection of the Ammonium Ion in Space.pdf}
}

@article{Cernicharo:2013:L25,
  title = {Unveiling the {{Dust Nucleation Zone}} of {{IRC}}+10216 with {{ALMA}}},
  author = {Cernicharo, J. and Daniel, F. and {Castro-Carrizo}, A. and Agundez, M. and Marcelino, N. and Joblin, C. and Goicoechea, J. R. and Gu{\'e}lin, M.},
  year = 2013,
  month = dec,
  journal = {The Astrophysical Journal},
  volume = {778},
  pages = {L25},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1088/2041-8205/778/2/L25},
  urldate = {2025-04-10},
  abstract = {We report the detection in IRC+10216 of lines of HNC J = 3 - 2 pertaining to nine excited vibrational states with energies up to \textasciitilde 5300 K. The spectrum, observed with ALMA, also shows a surprising large number of narrow, unidentified lines that arise in the vicinity of the star. The HNC data are interpreted through a 1D-spherical non-local radiative transfer model, coupled to a chemical model that includes chemistry at thermochemical equilibrium for the innermost regions and reaction kinetics for the external envelope. Although unresolved by the current early ALMA data, the radius inferred for the emitting region is \textasciitilde 0.''06 (i.e., \textasciitilde = 3 stellar radii), similar to the size of the dusty clumps reported by IR studies of the innermost region (r {$<$} 0.''3). The derived abundance of HNC relative to H2 is 10-8 {$<$} {$\chi$}(HNC) {$<$}10-6, and drops quickly where the gas density decreases and the gas chemistry is dominated by reaction kinetics. Merging HNC data with that of molecular species present throughout the inner envelope, such as vibrationally excited HCN, SiS, CS, or SiO, should allow us to characterize the physical and chemical conditions in the dust formation zone.},
  keywords = {Astrophysics - Astrophysics of Galaxies,circumstellar matter,line: identification,molecular processes,stars: AGB and post-AGB,stars: individual: IRC +10216},
  annotation = {ADS Bibcode: 2013ApJ...778L..25C},
  file = {/Users/brett/Zotero/storage/S5U53FWQ/Cernicharo et al. - 2013 - Unveiling the Dust Nucleation Zone of IRC+10216 with ALMA.pdf}
}

@article{Cernicharo:2014:40,
  title = {Tentative {{Detection}} of the {{Nitrosylium Ion}} in {{Space}}},
  author = {Cernicharo, J. and Bailleux, S. and Alekseev, E. and Fuente, A. and Roueff, E. and Gerin, M. and Tercero, B. and {Trevi{\~n}o-Morales}, S. P. and Marcelino, N. and Bachiller, R. and Lefloch, B.},
  year = 2014,
  month = nov,
  journal = {The Astrophysical Journal},
  volume = {795},
  pages = {40},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1088/0004-637X/795/1/40},
  urldate = {2025-04-10},
  abstract = {We report the tentative detection in space of the nitrosylium ion, NO+. The observations were performed toward the cold dense core Barnard 1-b. The identification of the NO+ J = 2-1 line is supported by new laboratory measurements of NO+ rotational lines up to the J = 8-7 transition (953207.189 MHz), which leads to an improved set of molecular constants: B 0 = 59597.1379(62) MHz, D 0 = 169.428(65) kHz, and eQq 0(N) = -6.72(15) MHz. The profile of the feature assigned to NO+ exhibits two velocity components at 6.5 and 7.5 km s-1, with column densities of 1.5 \texttimes{} 1012 and 6.5 \texttimes{} 1011 cm-2, respectively. New observations of NO and HNO, also reported here, allow us to estimate the following abundance ratios: X(NO)/X(NO+) \textasciitilde = 511, and X(HNO)/X(NO+) \textasciitilde = 1. This latter value provides important constraints on the formation and destruction processes of HNO. The chemistry of NO+ and other related nitrogen-bearing species is investigated by the means of a time-dependent gas phase model which includes an updated chemical network according to recent experimental studies. The predicted abundance for NO+ and NO is found to be consistent with the observations. However, that of HNO relative to NO is too high. No satisfactory chemical paths have been found to explain the observed low abundance of HNO. HSCN and HNCS are also reported here with an abundance ratio of \textasciitilde = 1. Finally, we have searched for NNO, NO2, HNNO+, and NNOH+, but only upper limits have been obtained for their column density, except for the latter for which we report a tentative 3{$\sigma$} detection. This work was based on observations carried out with the IRAM 30 m telescope. IRAM is supported by INSU/CNRS (France), MPG (Germany), and IGN (Spain).},
  keywords = {Astrophysics - Astrophysics of Galaxies,ISM: clouds,ISM: individual objects: B1-b,line: identification,molecular data,radio lines: ISM},
  annotation = {ADS Bibcode: 2014ApJ...795...40C},
  file = {/Users/brett/Zotero/storage/NLBF8JW8/Cernicharo et al. - 2014 - Tentative Detection of the Nitrosylium Ion in Space.pdf}
}

