@article{Gerin:2010:L110,
  title = {Interstellar {{OH}}{\textsuperscript{+}}, {{H}}{\textsubscript{2}}{{O}}{\textsuperscript{+}} and {{H}}{\textsubscript{3}}{{O}}{\textsuperscript{+}} along the Sight-Line to {{G10}}.6-0.4},
