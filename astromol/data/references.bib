@article{Botschwina:1998:3108,
  title = {The Isocyanopolyynes {{HC4NC}} and {{HC6NC}}: {{Microwave}} Spectra and Ab Initio Calculations},
  shorttitle = {The Isocyanopolyynes {{HC4NC}} and {{HC6NC}}},
  author = {Botschwina, P. and Heyl, {\"A}. and Chen, W. and McCarthy, M. C. and Grabow, J. -U. and Travers, M. J. and Thaddeus, P.},
  year = 1998,
  month = aug,
  journal = {Journal of Chemical Physics},
  volume = {109},
  pages = {3108--3115},
  publisher = {AIP},
  issn = {0021-9606},
  doi = {10.1063/1.476515},
  urldate = {2025-04-10},
  abstract = {Rotational spectra of HC4NC and HC6NC, linear molecules of interest to interstellar cloud chemistry, were recorded by Fourier transform microwave spectroscopy, and the ground state rotational constants were determined to be 1401.18227(7) and 582.5203(1) MHz. Nitrogen quadrupole hyperfine structure could be observed for HC4NC. On the basis of coupled cluster calculations including connected triple substitutions accurate equilibrium structures (uncertainty in bond lengths ca. 0.0005 A\r{}) could be established for both species. The equilibrium dipole moments, predicted to be -3.25 and -3.49 D for HC4NC and HC6NC, respectively, exhibit large correlation effects of 30\% and 33\%.},
  keywords = {31.15.Ar,31.15.Dv,31.30.Gs,33.15.Bh,33.15.Dj,33.15.Kr,33.15.Mt,33.15.Pw,33.20.Bx,33.20.Sn,95.30.Ft,95.30.Ky,98.38.Bn,98.38.Dq,Ab initio calculations,Atomic and molecular data spectra and spectral parameters,Atomic molecular and chemical and grain processes,Coupled-cluster theory,Electric and magnetic moments polarizability and magnetic susceptibility,Fine and hyperfine structure,General molecular conformation and symmetry,Hyperfine interactions and isotope effects Jahn-Teller effect,Interatomic distances and angles,Molecular and chemical processes and interactions,Molecular clouds H2 clouds dense clouds and dark clouds,Radio-frequency and microwave spectra,Rotation vibration and vibration-rotation constants,Rotational analysis,stereochemistry},
  annotation = {ADS Bibcode: 1998JChPh.109.3108B}
}

@article{Botschwina:2008:044305,
  title = {Carbon Chains of Type {{C}}{\textsubscript{2n+1}}{{N}}{\textsuperscript{-}} (N=2-6): {{A}} Theoretical Study of Potential Interstellar Anions},
  shorttitle = {Carbon Chains of Type {{C2n}}+{{1N-}} (N=2-6)},
  author = {Botschwina, Peter and Oswald, Rainer},
  year = 2008,
  month = jul,
  journal = {Journal of Chemical Physics},
  volume = {129},
  pages = {044305--044305},
  publisher = {AIP},
  issn = {0021-9606},
  doi = {10.1063/1.2949093},
  urldate = {2025-04-10},
  abstract = {Linear anions of type C2n+1N- (n=2-6), which are expected to be good candidates for experimental investigation by microwave spectroscopy and radio astronomy, were studied by means of the coupled cluster variant CCSD(T). Making use of corrections taken over from HC3N/C3N- and HC5N, accurate equilibrium structures (\textasciitilde 0.0005 A\r{} accuracy in bond lengths) have been established for all five anions. The electric dipole moments increase strongly with increasing chain length. For C13N-, a very large equilibrium dipole moment of 16.53 D (with respect to center-of-mass coordinate system, negative end of dipole at terminal carbon site) is predicted. The lowest vertical detachment energies, leading to 2{$\Sigma$} states of the radicals for C3N- and C5N- and to 2{$\Pi$} states in the case of the larger anions, are calculated to lie in the range of 4.40-4.63 eV. The ground-state rotational and quartic centrifugal distortion constants of C5N- are predicted to be 1389.4 MHz and 33.8 Hz, respectively. All anions studied appear to be fairly normal semirigid linear molecules. Throughout, good agreement with available matrix isolation IR spectroscopic data is obtained and many predictions of spectroscopic properties are made.},
  keywords = {31.15.bw,33.15.Bh,33.15.Dj,33.15.Kr,33.15.Ry,98.58.Bz,Atomic molecular chemical and grain processes,Clusters: electronic properties equilibrium geometries coupled-cluster theory,Electric and magnetic moments polarizability and magnetic susceptibility,General molecular conformation and symmetry,Interatomic distances and angles,Ionization potentials electron affinities molecular core binding energy,stereochemistry},
  annotation = {ADS Bibcode: 2008JChPh.129d4305B}
}

