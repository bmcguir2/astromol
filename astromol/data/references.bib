  publisher = {AIP},
  issn = {0021-9606},
  doi = {10.1063/1.449411},
  urldate = {2025-04-16},
  abstract = {The molecular ion H3O(+) is predicted to be an important component of the gas phase of interstellar clouds where it is calculated to be one of the most abundant molecular ions. Its detection would provide an indirect method of determining the abundance of the crucial species H2O. This fundamental molecule has no convenient low-lying transitions in the microwave or millimeter regions of the spectrum which can be excited under the normal low temperature conditions present in the interstellar medium. It is believed that the P(2,1) transition of H3O(+) in absorption at a frequency of 307 192.41 (5) MHz has been detected. The H3O(+) ion was produced in a magnetically enhanced negative glow discharge source.},
  keywords = {Absorption Spectra,Atomic and Molecular Physics,Electron Transitions,Infrared Spectroscopy,Interstellar Matter,Line Spectra,Methane,Molecular Clouds,Molecular Ions,Molecular Spectra,Submillimeter Waves},
  annotation = {ADS Bibcode: 1985JChPh..83.1428P}
}

@article{Plummer:1986:2427,
  title = {The Millimeter and Submillimeter Spectrum of {{CF}}{\textsuperscript{+}}},
