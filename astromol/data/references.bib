@article{Zhou:2020:125,
  title = {Detection of Hydroxyacetone in Protostar {{IRAS}} 16293-2422 {{B}}},
  author = {Zhou, Yan and Quan, Dong-Hui and Zhang, Xia and Qin, Sheng-Li},
  year = 2020,
  month = aug,
  journal = {Research in Astronomy and Astrophysics},
  volume = {20},
  pages = {125},
  publisher = {IOP},
  issn = {1674-4527},
  doi = {10.1088/1674-4527/20/8/125},
  urldate = {2025-04-17},
  abstract = {Hydroxyacetone (CH3COCH2OH) is one of the smallest molecules that contain both hydroxyl and carbonyl group on neighboring carbon atoms. This steric configuration is characteristic of saccharides and determines their biochemical activity. The attempt to search for hydroxyacetone toward the massive star formation region Sagittarius B2(N) was unsuccessful. Here we report the first detection of CH3COCH2OH in the solar-type protostar IRAS 16293-2422 B, using the Atacama Large Millimeter Array science verification data at Band 4. In a total of 11 unblended transitions of CH3COCH2OH with upper level energies ranging from 86 to 246 K are identified. From our local thermodynamic equilibrium analysis, we derived that the rotational temperature of CH3COCH2OH is 160\textpm 21 K and the column density is (1.2\textpm 1.0) \texttimes 1016 cm-2, which results in a fractional abundance of 7\texttimes 10-10 with respect to molecular hydrogen. In this work, we present the identification of CH3COCH2OH in IRAS 16293-2422 B and propose a simple formation mechanism. The unambiguous identification of hydroxyacetone may provide the basis for future study of the origin and evolution of saccharides in the interstellar medium.},
  keywords = {ISM: abundances,ISM: individual (IRAS 16293-2422B),ISM: molecules},
  annotation = {ADS Bibcode: 2020RAA....20..125Z}
}

@article{Ziurys:1986:L31,
  title = {{{HCNH}}{\textsuperscript{+}}: {{A New Interstellar Molecular Ion}}},
  shorttitle = {{{HCNH}} +},
  author = {Ziurys, L. M. and Turner, B. E.},
  year = 1986,
  month = mar,
  journal = {The Astrophysical Journal},
  volume = {302},
  pages = {L31},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1086/184631},
  urldate = {2025-04-17},
  abstract = {The first interstellar detection of HCNH(+) is reported. The J = 1-0, 2-1, and 3-2 rotational transitions of this molecule at 74, 148, and 222 GHz have been observed toward Sgr B2. Using a large velocity gradient model calculation, the column density of HCNH(+) is found to be about 4 x 10 to the 14th/sq cm, about one order of magnitude less than that estimated for HCO(+) and HCN in this source. Such a column density implies a fractional abundance of at least one to several orders of magnitude larger than predicted by numerous ion-molecule models. Coupled with a relatively low abundance of HCN and a small HNC/HCN ratio, this suggests that HCNH(+) is not channeled into HCN or HNC as rapidly as thought.},
  keywords = {Abundance,Astrophysics,Computational Astrophysics,Hydrocyanic Acid,Interstellar Chemistry,Interstellar Matter,INTERSTELLAR: ABUNDANCES,INTERSTELLAR: MOLECULES,Molecular Ions,MOLECULAR PROCESSES,Molecular Rotation},
  annotation = {ADS Bibcode: 1986ApJ...302L..31Z},
  file = {/Users/brett/Zotero/storage/F2YAF45K/Ziurys and Turner - 1986 - HCNH + A New Interstellar Molecular Ion.pdf}
}

@article{Ziurys:1987:L81,
  title = {Detection of {{Interstellar PN}}: {{The First Phosphorus-bearing Species Observed}} in {{Molecular Clouds}}},
  shorttitle = {Detection of {{Interstellar PN}}},
  author = {Ziurys, L. M.},
  year = 1987,
  month = oct,
  journal = {The Astrophysical Journal},
  volume = {321},
  pages = {L81},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1086/185010},
  urldate = {2025-04-17},
  abstract = {Phosphorus nitride (PN) has been detected in the interstellar medium. The J = 2-1, 3-2, 5-4, and 6-5 rotational lines of this species have been observed toward Orion-KL, and the J = 2-1 transition in Sgr B2 and W51. The PN line profiles in Orion indicate that the molecule's emission arises from the 'plateau' or 'doughnut' region associated with the outflow from IRc2. The species is thus primarily present in hot, dense gas. Column densities derived for PN toward Orion-KL are (3-4) x 10 to the 13th/sq cm, but may be as high as 10 to the 14th/sq cm, if the species is located in a 10-arcsec region. These column densities imply a fractional abundance for PN in the Orion 'plateau' of (1-4) x 10 to the -10th. Such a large abundance for PN is not predicted by quiescent cloud ion-molecule chemistry and suggests that high-temperature processes are responsible for the synthesis of PN in the KL outflow.},
  keywords = {Astronomical Spectroscopy,Astrophysics,Filter Wheel Infrared Spectrometers,Interstellar Chemistry,Interstellar Matter,INTERSTELLAR: ABUNDANCES,INTERSTELLAR: MOLECULES,Molecular Clouds,Nitrides,Orion Constellation,Phosphorus Compounds},
  annotation = {ADS Bibcode: 1987ApJ...321L..81Z},
  file = {/Users/brett/Zotero/storage/H8YJQP47/Ziurys - 1987 - Detection of Interstellar PN The First Phosphorus-bearing Species Observed in Molecular Clouds.pdf}
}

@article{Ziurys:1994:706,
  title = {New {{Detections}} of {{Interstellar HNO}} at 2 and 1.2 {{Millimeters}}: {{More N-O Bonds}}},
  shorttitle = {New {{Detections}} of {{Interstellar HNO}} at 2 and 1.2 {{Millimeters}}},
  author = {Ziurys, L. M. and Hollis, J. M. and Snyder, L. E.},
  year = 1994,
  month = aug,
  journal = {The Astrophysical Journal},
  volume = {430},
  pages = {706},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1086/174442},
  urldate = {2025-04-17},
  abstract = {The 202 to 101 and 303 to 202 transitions of HNO at 163 and 244 GHz have been detected toward several molecular clouds. In conjunction with previous measurements of the 101 to 000 line at 81 GHz, these observations secure the identification of interstellar HNO. The 202 to 101 transition of this species has been detected toward NGC 2024, Sgr B2 (NW), W51M, and Dr 21 (OH), while the 303 to 202 line at 1.2 mm was observed only in NGC 2024. Typical column densities of HNO observed toward these sources are Ntot approximately 1012 to 1014/sq cm, corresponding to fractional abundances of fHNO approximately 10-11 to 10-10. These values imply NO/HNO ratios of approximately 100 to 800. Both the HNO fractional abundances and NO/HNO ratios are in reasonable agreement with predictions of ion-molecule-type models of interstellar chemistry, provided early-time calculations are used. Such behavior contrasts with that of other nitrogen compounds, whose observed abundances are best duplicated by steady-state calculations. The chemistries of HNO and NO are thus likely to be related. These observations also suggest that interstellar N-O bonds may be more common than previously thought.},
  keywords = {Abundance,Astrophysics,Cosmology,Interstellar Chemistry,Interstellar Matter,ISM: MOLECULES,Line Spectra,LINE: IDENTIFICATION,Molecular Clouds,Nitrogen Oxides,Radio Emission,RADIO LINES: ISM,Spectrum Analysis},
  annotation = {ADS Bibcode: 1994ApJ...430..706Z},
  file = {/Users/brett/Zotero/storage/V7NJ7IP4/Ziurys et al. - 1994 - New Detections of Interstellar HNO at 2 and 1.2 Millimeters More N-O Bonds.pdf}
}

@article{Ziurys:1994:729,
  title = {Exotic {{Fluoride Molecules}} in {{IRC}} +10216: {{Confirmation}} of {{AlF}} and {{Searches}} for {{MgF}} and {{CaF}}},
  shorttitle = {Exotic {{Fluoride Molecules}} in {{IRC}} +10216},
  author = {Ziurys, L. M. and Apponi, A. J. and Phillips, T. G.},
  year = 1994,
  month = oct,
  journal = {The Astrophysical Journal},
  volume = {433},
  pages = {729},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1086/174682},
  urldate = {2025-04-17},
  abstract = {Three new rotational transitions of aluminum fluoride (AlF) at 0.8 and 1.2 mm have been observed. The J = 10-9, J = 8-7, and J = 7-6 lines of AlF at 230, 263, and 329 GHz, respectively, were seen toward IRC +10216 using the Caltech Submillimter Observatory (CSO). Combined with the earlier data obtained for this species at IRAM at 2 and 3 mm, these measurements confirm the presence of the metal halide in this carbon-rich circumstellar shell. Analysis of the CSO and IRAM data suggests that AlF arises from a source with a diameter of thetas approximately = 5-10 sec and hence is present chiefly in the inner envelope of IRC +10216. In this region, the molecule has a column density of (0.3-1.1) x 1015/sq cm, which indicates a fractional abundance of at least approximately 10-9, relative to H2. Searches for the metal fluoride species CaF and MgF have also been conducted toward IRC +10216, but with negative results. The column density upper limits for MgF and CaF are Ntot less than (1-4) x 1014/sq cm. Relative abundances of these metal fluoride molecules can be understood in terms of chemical thermodynamic equilibrium. The presence of AlF in IRC +10216 also indicates that large quantities of fluorine must be present in the inner stellar envelope, suggesting that this element may be produced not primarily in explosive nucleosynthesis but rather in helium shell flashes, as indicated also by HF spectroscopy of red giant stars.},
  keywords = {10216,Abundance,Aluminum Fluorides,Astrophysics,Calcium Fluorides,Chemical Equilibrium,Hydrogen,LINE: IDENTIFICATION,Magnesium Fluorides,Nuclear Fusion,Optical Transition,Radio Astronomy,RADIO LINES: STARS,Radio Spectra,Radio Telescopes,Spectrum Analysis,STARS: CIRCUMSTELLAR MATTER,STARS: INDIVIDUAL ALPHANUMERIC: IRC,Stellar Envelopes},
  annotation = {ADS Bibcode: 1994ApJ...433..729Z},
  file = {/Users/brett/Zotero/storage/3K7JL4GV/Ziurys et al. - 1994 - Exotic Fluoride Molecules in IRC +10216 Confirmation of AlF and Searches for MgF and CaF.pdf}
}

@article{Ziurys:1994:L181,
  title = {Detection of {{Interstellar N 2O}}: {{A New Molecule Containing}} an {{N-O Bond}}},
  shorttitle = {Detection of {{Interstellar N 2O}}},
  author = {Ziurys, L. M. and Apponi, A. J. and Hollis, J. M. and Snyder, L. E.},
  year = 1994,
  month = dec,
  journal = {The Astrophysical Journal},
  volume = {436},
  pages = {L181},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1086/187662},
  urldate = {2025-04-17},
  abstract = {A new interstellar molecule, N2O, known as nitrous oxide or 'laughing gas,' has been detected using the NRAO 12 m telescope. The J = 3 - 2, 4 - 3, 5 - 4, and 6 - 5 rotational transitions of this species at 75, 100, 125, and 150 GHz, respectively, were observed toward Sgr B2(M). The column density derived for N2O in this source is Ntot approx. 1015/sq. cm, which corresponds to a fractional abundance of approx. 10-9, relative to H2. This value implies abundance ratios of N2O/NO approx. 0.1 and N2O/HNO approx. 3 in the Galactic center. Such ratios are in excellent agreement with predictions of ion-molecule models of interstellar chemistry using early-time calculations and primarily neutral-neutral reactions. N2O is the third interstellar molecule detected thus far containing an N-O bond. Such bonds cannot be so rare as previously thought.},
  keywords = {Astrophysics,Atmospheric Density,Chemical Bonds,GALAXY: CENTER,Interstellar Gas,ISM: ABUNDANCES,ISM: MOLECULES,LINE: IDENTIFICATION,Molecular Clouds,Nitrous Oxides,Organic Chemistry,Star Formation,Telescopes,Temperature},
  annotation = {ADS Bibcode: 1994ApJ...436L.181Z},
  file = {/Users/brett/Zotero/storage/MSB8HKXX/Ziurys et al. - 1994 - Detection of Interstellar N 2O A New Molecule Containing an N-O Bond.pdf}
}

@article{Ziurys:1995:L47,
  title = {Detection of {{MgCN}} in {{IRC}} +10216: {{A New Metal-bearing Free Radical}}},
  shorttitle = {Detection of {{MgCN}} in {{IRC}} +10216},
  author = {Ziurys, L. M. and Apponi, A. J. and Guelin, M. and Cernicharo, J.},
  year = 1995,
  month = may,
  journal = {The Astrophysical Journal},
  volume = {445},
  pages = {L47},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1086/187886},
  urldate = {2025-04-17},
  abstract = {A new metal-containing molecule, MgCN, has been detected toward the late-type star IRC + 10216, using the NRAO 12 m and IRAM 30 m telescopes. The N = 11 approaches 10, 10 approaches 9, and 9 approaches 8 transitions of this species which has a 2Sigma+ ground state, have been observed in the outer envelope of this object at 3 mm. For the N = 11 approaches 10 transitions, the two spin-rotation components are clearly resolved and conclusively identify this new radical. These measurements imply a column of density for MgCN of Ntot approximately 1012/sq cm in the outer shell, which corresponds to a fractional abundance of f approximately 7x10-10. This molecule, the metastable isomer of MgNC, is the third metal-bearing species thus far identified in the outer shell of IRC + 10216, and its detection implies a ratio of MgNC/MgCN approximately 22/1. MgCN may be formed through a reaction scheme involving magnesium and HNC or CN, both prominent outer shell molecules, or through synthesis on grains.},
  keywords = {10216,Abundance,Astrophysics,Carbon Compounds,Free Radicals,Interstellar Matter,ISM: ABUNDANCES,ISM: MOLECULES,Isomers,Late Stars,LINE: IDENTIFICATION,Magnesium Compounds,Metallicity,Nitrogen Compounds,RADIO LINES: STARS,Reaction Products,STARS: INDIVIDUAL ALPHANUMERIC: IRC,Stellar Envelopes},
  annotation = {ADS Bibcode: 1995ApJ...445L..47Z},
  file = {/Users/brett/Zotero/storage/4QGT963U/Ziurys et al. - 1995 - Detection of MgCN in IRC +10216 A New Metal-bearing Free Radical.pdf}
}

@article{Ziurys:1995:L73,
  title = {Confirmation of {{Interstellar HOC}} +: {{Reevaluating}} the [{{HCO}}{\textsuperscript{+}}]/[{{HOC}}{\textsuperscript{+}}] {{Abundance Ratio}}},
  shorttitle = {Confirmation of {{Interstellar HOC}} +},
  author = {Ziurys, L. M. and Apponi, A. J.},
  year = 1995,
  month = dec,
  journal = {The Astrophysical Journal},
  volume = {455},
  pages = {L73},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1086/309811},
  urldate = {2025-04-17},
  abstract = {The identification of interstellar HOC+ has been confirmed through new observations of this species at 3, 2, and 1.2 mm using the NRAO 12 m telescope. Toward Sgr B2 (OH), the J = 2 --{$>$} 1 and J = 3 --{$>$} 2 lines of this ion at 179 and 268 GHz were detected for the first time. In addition, the J = 1 --{$>$} 0 line of HOC+ at 89 GHz was observed toward several new sources, including Orion-KL. In conjunction with past observations of the J = 1 --{$>$} 0 transition toward Sgr B2 (OH), these data clearly establish the presence of this species in the interstellar medium. The column density toward Sgr B2 (OH) is estimated to be Ntot \textasciitilde{} 3 x 1012 cm-2, which corresponds to a fractional abundance relative to H2 of f \textasciitilde{} 10-12. Measurements of HCO+ were also carried out toward Sgr B2 (OH), resulting in an abundance ratio of [HCO+]/[HOC+] \textasciitilde{} 140--360 at gas densities of n(H2) {$>$} 105 cm-3. This ratio contradicts past predictions of ion-molecule models by several orders of magnitude and suggests that the reaction HOC+ + H2 --{$>$} HCO+ + H2 is not as fast as previously thought.},
  keywords = {GALAXY: CENTER,ISM: ABUNDANCES,ISM: MOLECULES,LINE: IDENTIFICATION},
  annotation = {ADS Bibcode: 1995ApJ...455L..73Z},
  file = {/Users/brett/Zotero/storage/Y2N3FW7J/Ziurys and Apponi - 1995 - Confirmation of Interstellar HOC + Reevaluating the [HCO +][HOC +] Abundance Ratio.pdf}
}

@article{Ziurys:2002:L45,
  title = {More {{Metal Cyanide Species}}: {{Detection}} of {{AlNC}} ({{X}}{\textsuperscript{1}}{{$\Sigma$}}{\textsuperscript{+}}) toward {{IRC}} +10216},
  shorttitle = {More {{Metal Cyanide Species}}},
  author = {Ziurys, L. M. and Savage, C. and Highberger, J. L. and Apponi, A. J. and Gu{\'e}lin, M. and Cernicharo, J.},
