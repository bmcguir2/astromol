  doi = {10.1088/2041-8205/808/1/L3},
  urldate = {2025-04-10},
  abstract = {We present Atacama Large Millimeter/submillimeter Array (ALMA) observations from the 2014 Long Baseline Campaign in dust continuum and spectral line emission from the HL Tau region. The continuum images at wavelengths of 2.9, 1.3, and 0.87 mm have unprecedented angular resolutions of 0.{${''}$} 075 (10 AU) to 0.{${''}$} 025 (3.5 AU), revealing an astonishing level of detail in the circumstellar disk surrounding the young solar analog HL Tau, with a pattern of bright and dark rings observed at all wavelengths. By fitting ellipses to the most distinct rings, we measure precise values for the disk inclination (46\textbackslash buildrel\textbraceleft\textbackslash circ\textbraceright\textbackslash over\textbraceleft.\textbraceright{} 72+/- 0\textbackslash buildrel\textbraceleft\textbackslash circ\textbraceright\textbackslash over\textbraceleft.\textbraceright{} 05) and position angle (+138\textbackslash buildrel\textbraceleft\textbackslash circ\textbraceright\textbackslash over\textbraceleft.\textbraceright{} 02+/- 0\textbackslash buildrel\textbraceleft\textbackslash circ\textbraceright\textbackslash over\textbraceleft.\textbraceright{} 07). We obtain a high-fidelity image of the 1.0 mm spectral index ({$\alpha$}), which ranges from {$\alpha$} {$\sim$} 2.0 in the optically thick central peak and two brightest rings, increasing to 2.3-3.0 in the dark rings. The dark rings are not devoid of emission, and we estimate a grain emissivity index of 0.8 for the innermost dark ring and lower for subsequent dark rings, consistent with some degree of grain growth and evolution. Additional clues that the rings arise from planet formation include an increase in their central offsets with radius and the presence of numerous orbital resonances. At a resolution of 35 AU, we resolve the molecular component of the disk in HCO+ (1-0) which exhibits a pattern over LSR velocities from 2-12 km s-1 consistent with Keplerian motion around a {$\sim$}1.3 \textbraceleft M\textbraceright{$\odot$} star, although complicated by absorption at low blueshifted velocities. We also serendipitously detect and resolve the nearby protostars XZ Tau (A/B) and LkH{$\alpha$}358 at 2.9 mm. .},
  keywords = {Astrophysics - Solar and Stellar Astrophysics,LkH358,protoplanetary disks,stars: formation,stars: individual: HL Tau,submillimeter: planetary systems,techniques: interferometric,XZ Tau},
  annotation = {ADS Bibcode: 2015ApJ...808L...3A},
  file = {/Users/brett/Zotero/storage/37KMTU9E/ALMA Partnership et al. - 2015 - The 2014 ALMA Long Baseline Campaign First Results from High Angular Resolution Observations toward.pdf}
}

@article{Altman:1984:3911,
  title = {Observation of the Infrared Nu 2 Band ({{CH}} Stretch) of Protonated Hydrogen Cyanide {{HCNH}} +},
  author = {Altman, R. S. and Crofton, M. W. and Oka, T.},
  year = 1984,
  month = apr,
  journal = {Journal of Chemical Physics},
  volume = {80},
  pages = {3911--3912},
  publisher = {AIP},
  issn = {0021-9606},
  doi = {10.1063/1.447173},
  urldate = {2025-03-27},
  abstract = {Crofton and Oka (1983) have conducted a study on the infrared spectrum of the nu-3 band of NH4(+), and have called for theoretical predictions of the vibrational frequencies of other ions, taking into account protonated hydrogen cyanide H2CN(+), protonated methane, and protonated acetylene. In response to this call, three theorists have provided predictions of the vibrational frequencies of the HCNH(+) ion. The present investigation is concerned with the first successful observation of the infrared vibration-rotation spectrum of the fundamental nu-2 band (CH stretch) of this molecular ion. The values of the constants obtained experimentally are in excellent agreement with the theoretically obtained data. This agreement shows the quality and value of the ab initio calculations which are now possible.},
  keywords = {Atomic and Molecular Physics,Hydrocyanic Acid,Infrared Spectra,Molecular Rotation,Molecular Structure,Rotational Spectra,Vibrational Spectra},
  annotation = {ADS Bibcode: 1984JChPh..80.3911A}
}

@article{Amano:1969:97,
  title = {Hyperfine Interactions and {{$\Lambda$-type}} Doubling in the Microwave Spectrum of the {{NS}} Radical},
  author = {Amano, Takayoshi and Saito, Shuji and Hirota, Eizi and Morino, Yonezo},
  year = 1969,
  month = jan,
  journal = {Journal of Molecular Spectroscopy},
  volume = {32},
  pages = {97--107},
  issn = {0022-2852},
  doi = {10.1016/0022-2852(69)90145-3},
  urldate = {2025-03-27},
  abstract = {Strong absorption lines due to free NS radicals have been observed by means of Stark modulated microwave spectrometers, in the discharge products of a mixture of nitrogen and sulfur dichloride or sulfur monochloride. The rotational transitions J = \textbraceleft 3\textbraceright/\textbraceleft 2\textbraceright{} \textleftarrow{} \textbraceleft 1\textbraceright/\textbraceleft 2\textbraceright{} in the 2{$\Pi$}\textbraceleft 1\textbraceright/\textbraceleft 2\textbraceright{} state as well as J = \textbraceleft 5\textbraceright/\textbraceleft 2\textbraceright{} \textleftarrow{} \textbraceleft 3\textbraceright/\textbraceleft 2\textbraceright{} both in the 2{$\Pi$}\textbraceleft 1\textbraceright/\textbraceleft 2\textbraceright{} and 2{$\Pi$}\textbraceleft 3\textbraceright/\textbraceleft 2\textbraceright{} states are analyzed to investigate the {$\Lambda$}-type doubling and the hyperfine interactions in two isotopic species 14N 32S and 14N 34S. The parity considerations lead to negative sign of the {$\Lambda$}-type doubling parameter {$\alpha$}p, which indicates that the dominant perturbing state is a 2{$\Sigma$} - state not identified yet. Relative magnitudes of hyperfine constants of NS are very similar to those of NO, although their absolute values in the former are consistently smaller than in the latter. The rotational constant B0 = 23156.01 \textpm{} 0.16 MHz obtained in the present analysis, combined with {$\alpha$}eB from the {$\gamma$}-band analysis, gives an accurate equilibrium internuclear distance r e = 1.4938 \textpm{} 0.0002 \AA. The electric dipole moment is determined to be 1.81 \textpm{} 0.02 Debye in the 2{$\Pi$}\textbraceleft 1\textbraceright/\textbraceleft 2\textbraceright{} state by the Stark effect measurements.},
  annotation = {ADS Bibcode: 1969JMoSp..32...97A}
}

