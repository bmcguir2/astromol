@article{Martin:1979:L7,
  title = {Detection of Extragalactic Ammonia.},
  author = {Martin, R. N. and Ho, P. T. P.},
  year = 1979,
  month = apr,
  journal = {Astronomy and Astrophysics},
  volume = {74},
  pages = {L7-L9},
  issn = {0004-6361},
  urldate = {2025-04-15},
  abstract = {The 100-m telescope of the Max Planck Institute for Radio Astronomy has been used to detect the J, K 1, 1 transition of NH3 toward the galaxies IC 342 and NGC 253. Ammonia is now the seventh molecule that has been observed in external galaxies. The detection in IC 342 is toward the nucleus and has a strength corresponding to a beam-diluted brightness temperature of 0.025 + or - 0.008 K. The line width and radial velocity agree well with the CO results of Morris and Lo (1978) toward this source. In NGC 253 the detection is toward a position 40 arcsec W and 15 arcsec S of the nucleus with a beam-diluted antenna temperature of 0.18 + or - 0.04 K; this detection also agrees with CO observations. Negative results were obtained toward the nuclei of M51, Maffei 2, and NGC 1068.},
  keywords = {Absorption Spectra,Ammonia,Ammonia:Galaxies,Astrophysics,Electron Transitions,Galactic Structure,Galaxies:Molecules,Interstellar Chemistry,Interstellar Gas,Molecular Oscillations,Spectral Line Width},
