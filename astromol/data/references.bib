@article{Suenram:1989:L103,
  title = {Laboratory {{Measurement}} of the 1{\textsubscript{01}}-0{\textsubscript{00}} {{Transition}} and {{Electric Dipole Moment}} of {{SiC}} 2},
  author = {Suenram, R. D. and Lovas, F. J. and Matsumura, K.},
