}

@article{Carroll:2015:15,
  title = {The {{Search}} for a {{Complex Molecule}} in a {{Selected Hot Core Region}}: {{A Rigorous Attempt}} to {{Confirm Trans-ethyl Methyl Ether}} toward {{W51}} E1/E2},
  shorttitle = {The {{Search}} for a {{Complex Molecule}} in a {{Selected Hot Core Region}}},
  author = {Carroll, P. Brandon and McGuire, Brett A. and Blake, Geoffrey A. and Apponi, A. J. and Ziurys, L. M. and Remijan, Anthony},
  year = 2015,
  month = jan,
  journal = {The Astrophysical Journal},
  volume = {799},
  pages = {15},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1088/0004-637X/799/1/15},
  urldate = {2025-04-10},
  abstract = {An extensive search has been conducted to confirm transitions of trans-ethyl methyl ether (tEME, C2H5OCH3), toward the high-mass star forming region W51 e1/e2 using the 12 m Telescope of the Arizona Radio Observatory at wavelengths from 2 mm and 3 mm. In short, we cannot confirm the detection of tEME toward W51 e1/e2 and our results call into question the initial identification of this species by Fuchs et al. Additionally, re-evaluation of the data from the original detection indicates that tEME is not present toward W51 e1/e2 in the abundance reported by Fuchs and colleagues. Typical peak-to-peak noise levels for the present observations of W51 e1/e2 were between 10 and 30 mK, yielding an upper limit of the tEME column density of {$<$}=1.5 \texttimes{} 1015 cm-2. This would make tEME at least a factor of two times less abundant than dimethyl ether (CH3OCH3) toward W51 e1/e2. We also performed an extensive search for this species toward the high-mass star forming region Sgr B2(N-LMH) with the National Radio Astronomy Observatory 100 m Green Bank Telescope. No transitions of tEME were detected and we were able to set an upper limit to the tEME column density of {$<$}=4 \texttimes{} 1014 cm-2 toward this source. Thus, we are able to show that tEME is not a new molecular component of the interstellar medium and that an exacting assessment must be carried out when assigning transitions of new molecular species to astronomical spectra to support the identification of large organic interstellar molecules.},
  keywords = {astrochemistry,Astrophysics - Astrophysics of Galaxies,ISM: clouds,ISM: individual objects: W51 e1/e2 Sagittarius B2(N),ISM: molecules},
  annotation = {ADS Bibcode: 2015ApJ...799...15C},
  file = {/Users/brett/Zotero/storage/MNXA4UXP/Carroll et al. - 2015 - The Search for a Complex Molecule in a Selected Hot Core Region A Rigorous Attempt to Confirm Trans.pdf}
}

