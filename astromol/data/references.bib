@article{Boogert:2015:541,
  title = {Observations of the Icy Universe.},
  author = {Boogert, A. C. Adwin and Gerakines, Perry A. and Whittet, Douglas C. B.},
  year = 2015,
  month = aug,
  journal = {Annual Review of Astronomy and Astrophysics},
  volume = {53},
  pages = {541--581},
  issn = {0066-4146},
  doi = {10.1146/annurev-astro-082214-122348},
  urldate = {2025-04-10},
  abstract = {Freeze-out of the gas-phase elements onto cold grains in dense interstellar and circumstellar media builds up ice mantles consisting of molecules that are mostly formed in situ (H2O, NH3, CO2, CO, CH3OH, and more). This review summarizes the detected infrared spectroscopic ice features and compares the abundances across Galactic, extragalactic, and Solar System environments. A tremendous amount of information is contained in the ice band profiles. Laboratory experiments play a critical role in the analysis of the observations. Strong evidence is found for distinct ice formation stages, separated by CO freeze-out at high densities. The ice bands have proven to be excellent probes of the thermal history of their environment. The evidence for the long-held idea that processing of ices by energetic photons and cosmic rays produces complex molecules is weak. Recent state-of-the-art observations show promise for much progress in this area with planned infrared facilities.},
  keywords = {Astrophysics - Astrophysics of Galaxies,Astrophysics - Earth and Planetary Astrophysics,Astrophysics - Solar and Stellar Astrophysics},
  annotation = {ADS Bibcode: 2015ARA\&A..53..541B},
  file = {/Users/brett/Zotero/storage/WBSW9H68/Boogert et al. - 2015 - Observations of the icy universe..pdf}
}

@article{Booth:2019:L31,
  title = {The {{First Detection}} of {\textsuperscript{13}}{{C}}{\textsuperscript{17}}{{O}} in a {{Protoplanetary Disk}}: {{A Robust Tracer}} of {{Disk Gas Mass}}},
  shorttitle = {The {{First Detection}} of {{13C17O}} in a {{Protoplanetary Disk}}},
  author = {Booth, Alice S. and Walsh, Catherine and Ilee, John D. and Notsu, Shota and Qi, Chunhua and Nomura, Hideko and Akiyama, Eiji},
  year = 2019,
  month = sep,
  journal = {The Astrophysical Journal},
  volume = {882},
  pages = {L31},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.3847/2041-8213/ab3645},
  urldate = {2025-04-10},
  abstract = {Measurements of the gas mass are necessary to determine the planet formation potential of protoplanetary disks. Observations of rare CO isotopologues are typically used to determine disk gas masses; however, if the line emission is optically thick this will result in an underestimated disk mass. With the Atacama Large Millimeter/submillimeter Array we have detected the rarest stable CO isotopologue, \textbraceleft\textbraceright 13\textbraceleft\textbraceleft\textbraceleft C\textbraceright\textbraceright\textbraceright 17\textbraceleft\textbraceleft O\textbraceright\textbraceright, in a protoplanetary disk for the first time. We compare our observations with the existing detections of \textbraceleft\textbraceright 12\textbraceleft CO\textbraceright, \textbraceleft\textbraceright 13\textbraceleft CO\textbraceright, \textbraceleft\textbraceleft\textbraceleft C\textbraceright\textbraceright\textbraceright 18\textbraceleft\textbraceleft O\textbraceright\textbraceright, and \textbraceleft\textbraceleft\textbraceleft C\textbraceright\textbraceright\textbraceright 17\textbraceleft\textbraceleft O\textbraceright\textbraceright{} in the HD 163296 disk. Radiative transfer modeling using a previously benchmarked model, and assuming interstellar isotopic abundances, significantly underestimates the integrated intensity of the \textbraceleft\textbraceright 13\textbraceleft\textbraceleft\textbraceleft C\textbraceright\textbraceright\textbraceright 17\textbraceleft\textbraceleft O\textbraceright\textbraceright{} J = 3-2 line. Reconciliation between the observations and the model requires a global increase in CO gas mass by a factor of 3.5. This is a factor of 2-6 larger than previous gas mass estimates using \textbraceleft\textbraceleft\textbraceleft C\textbraceright\textbraceright\textbraceright 18\textbraceleft\textbraceleft O\textbraceright\textbraceright. We find that \textbraceleft\textbraceleft\textbraceleft C\textbraceright\textbraceright\textbraceright 18\textbraceleft\textbraceleft O\textbraceright\textbraceright{} emission is optically thick within the snow line, while the \textbraceleft\textbraceright 13\textbraceleft\textbraceleft\textbraceleft C\textbraceright\textbraceright\textbraceright 17\textbraceleft\textbraceleft O\textbraceright\textbraceright{} emission is optically thin and is thus a robust tracer of the bulk disk CO gas mass.},
  keywords = {1241,1300,1647,75,Astrochemistry,Astrophysics - Astrophysics of Galaxies,Astrophysics - Earth and Planetary Astrophysics,Astrophysics - Solar and Stellar Astrophysics,Planet formation,Protoplanetary disks,Submillimeter astronomy},
  annotation = {ADS Bibcode: 2019ApJ...882L..31B},
  file = {/Users/brett/Zotero/storage/SP85RJ5P/Booth et al. - 2019 - The First Detection of 13C17O in a Protoplanetary Disk A Robust Tracer of Disk Gas Mass.pdf}
}

