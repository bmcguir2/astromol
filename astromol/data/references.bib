@article{Welty:2013:1107,
  title = {Detection of Interstellar {{C}}{\textsubscript{2}} and {{C}}{\textsubscript{3}} in the {{Small Magellanic Cloud}}},
  author = {Welty, Daniel E. and Howk, J. Christopher and Lehner, Nicolas and Black, John H.},
  year = 2013,
  month = jan,
  journal = {Monthly Notices of the Royal Astronomical Society},
  volume = {428},
