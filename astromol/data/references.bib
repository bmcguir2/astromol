@article{Gudeman:1982:1344,
  title = {Experimental Detection of {{HOC}}{\textsuperscript{+}} by Microwave Spectroscopy},
  author = {Gudeman, C. S. and Woods, R. C.},
  year = 1982,
  month = may,
  journal = {Physical Review Letters},
  volume = {48},
  pages = {1344--1348},
  publisher = {APS},
  issn = {0031-9007},
  doi = {10.1103/PhysRevLett.48.1344},
  urldate = {2025-04-14},
  abstract = {A definitive spectroscopic observation of HOC(+) is reported. The region from 88,200 to 89,800 MHz was searched and four lines of HCO(+) were found, one of which is discussed here. A statistically significant Doppler shift was not measurable for this weak line, but a pressure-broadening parameter was found and it was determined that the line contained no nitrogen. Isotopic mixing showed the line to come from molecules containing one H, one C, and one O atom. The ion line was readily observed and final frequencies were measured. Principal axis coordinates were calculated for all three atoms. The microwave frequencies and gamma-sub-s structures were in essentially perfect harmony with theoretical predictions, confirming the assignment of these spectra beyond any reasonable doubt.},
  keywords = {33.20.Bx,35.20.Dp,52.80.Hc,98.40.Ct,Atomic and Molecular Physics,Carbon 13,CARBON 13,Chemical Bonds,CHEMICAL BONDS,Configuration Interaction,CONFIGURATION INTERACTION,corona,Doppler Effect,DOPPLER EFFECT,Glow,Hydrogen Ions,HYDROGEN IONS,Interstellar Chemistry,INTERSTELLAR CHEMISTRY,Interstellar Matter,INTERSTELLAR MATTER,Isomers,ISOMERS,Metastable State,METASTABLE STATE,Microwave Spectra,MICROWAVE SPECTRA,Molecular Ions,MOLECULAR IONS,Oxygen 18,OXYGEN 18,Radio-frequency and microwave spectra,Self Consistent Fields,SELF CONSISTENT FIELDS},
  annotation = {ADS Bibcode: 1982PhRvL..48.1344G}
}

