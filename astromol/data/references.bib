@article{Green:1976:479,
  title = {Theoretical Investigation of Protonated Carbon Dioxide},
  author = {Green, Sheldon and Schor, Heloiza and Siegbahn, Per and Thaddeus, Patrick},
  year = 1976,
  month = nov,
  journal = {Chemical Physics},
  volume = {17},
  pages = {479--485},
  issn = {0301-0104},
  doi = {10.1016/S0301-0104(76)80011-0},
  urldate = {2025-04-14},
  abstract = {The equilibrium structure of CO 2H + has been obtained from self-consistent field and configuration interaction wave-functions. Only one stable form has been found, a linear O-C-O chain with the hydrogen bonded to oxygen and slightly off axis, in analogy with known isoelectronic species. A second structure protonated at carbon, which has been inferred from mass spectrometric studies, is found to be unstable with respect to spontaneous rearrangement. The proton affinity of CO 2 is calculated to be 136 kcal/mole, in reasonable agreement with the most recent experimental value.},
  annotation = {ADS Bibcode: 1976CP.....17..479G}
}

@article{Grim:1991:473,
  title = {Detection of Solid Methanol toward {{W 33A}}.},
  author = {Grim, R. J. A. and Baas, F. and Geballe, T. R. and Greenberg, J. M. and Schutte, W. A.},
  year = 1991,
  month = mar,
  journal = {Astronomy and Astrophysics},
  volume = {243},
  pages = {473},
  issn = {0004-6361},
  urldate = {2025-04-14},
  abstract = {A recently detected absorption feature at 3.53 microns in the spectrum of W33A has been assigned to methanol (CH3OH). Its optical depth implies that methanol is the second most abundant molecule (7 percent relative to H2O) in the grain mantles in the line of sight toward W33A observed to date. Laboratory experiments have shown that the implied abundance is difficult to explain by UV irradiation of the dust grains alone. Grain surface reactions or condensation directly out of the gas phase must also play roles, but the relative contributions of the various processes are difficult to estimate. The optical depth of the 3.53-micron feature constrains the contribution of methanol to the 6.8-micron feature in W33A to be 10 percent or less, requiring the contribution of at least one other compound to this feature, while the estimated contribution to the 4.9-micron absorption band is even smaller. Only a small contribution of formaldehyde (H2CO) is consistent with the observed 3.53-micron band profile. In contrast to methanol, formaldehyde can be produced readily by photochemical reactions within the ice mantle.},
  keywords = {Absorption Spectra,Abundance,Astronomical Spectroscopy,Astrophysics,Early Stars,Infrared Spectra,Interstellar Matter,Methyl Alcohol,Photochemical Reactions},
  annotation = {ADS Bibcode: 1991A\&A...243..473G},
  file = {/Users/brett/Zotero/storage/Z8SDT62T/Grim et al. - 1991 - Detection of solid methanol toward W 33A..pdf}
}

