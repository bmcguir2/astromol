@article{Kuan:2003:848,
  title = {Interstellar {{Glycine}}},
  author = {Kuan, Yi-Jehng and Charnley, Steven B. and Huang, Hui-Chun and Tseng, Wei-Ling and Kisiel, Zbigniew},
  year = 2003,
  month = aug,
  journal = {The Astrophysical Journal},
  volume = {593},
  pages = {848--867},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1086/375637},
  urldate = {2025-04-15},
  abstract = {We have searched for interstellar conformer I glycine (NH2CH2COOH), the simplest amino acid, in the hot molecular cores Sgr B2(N-LMH), Orion KL, and W51 e1/e2. An improved search strategy for intrinsically weak molecular lines, involving multisource observations, has been developed and implemented. In total, 82 spectral frequency bands, in the millimeter-wave region, were observed over a 4 yr period; 27 glycine lines were detected in 19 different spectral bands in one or more sources. The rotational temperatures derived from ``rotation diagrams'' are 75+29-16 K for Sgr B2(N-LMH), 141+76-37 K for Orion KL, and 121+71-32 K for W51 e1/e2. The total column densities inferred are 4.16+3.22-1.82\texttimes 1014 cm-2 for Sgr B2, 4.37+1.79-1.27\texttimes 1014 cm-2 for Orion, and 2.09+1.22-0.77\texttimes 1014 cm-2 for W51. Production of interstellar glycine by both gas-phase ion-molecule reactions and by ultraviolet photolysis of molecular ices is briefly discussed. The discovery of interstellar glycine strengthens the thesis that interstellar organic molecules could have played a pivotal role in the prebiotic chemistry of the early Earth.},
  keywords = {Astrobiology,ISM: Abundances,ISM: Individual: Alphanumeric: W51 e1/e2,ISM: Individual: Name: Orion Kleinmann-Low,ISM: Individual: Name: Sagittarius B2(N-LMH),ISM: Molecules,Line: Identification,Radio Lines: ISM},
  annotation = {ADS Bibcode: 2003ApJ...593..848K},
  file = {/Users/brett/Zotero/storage/BDBXA3H9/Kuan et al. - 2003 - Interstellar Glycine.pdf}
}

