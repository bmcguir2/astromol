@article{Matsuura:2002:L133,
  title = {Very {{Large Telescope Spectra}} of {{Carbon Stars}} in the {{Large Magellanic Cloud}} and {{Their Metallicity Dependence}}},
  author = {Matsuura, M. and Zijlstra, Albert A. and {van Loon}, J. {\relax Th}. and Yamamura, I. and Markwick, A. J. and Woods, Paul M. and Waters, L. B. F. M.},
  year = 2002,
  month = dec,
  journal = {The Astrophysical Journal},
  volume = {580},
  pages = {L133-L136},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1086/345680},
  urldate = {2025-04-15},
  abstract = {Very Large Telescope (VLT) L-band spectra of six carbon stars in the Large Magellanic Cloud are presented. The stars show absorption bands at 3.1 {$\mu$}m (HCN and C2H2), and 3.8 {$\mu$}m, which is probably due to C2H2. Two LMC stars show strong 3.5 {$\mu$}m HCN absorption. The equivalent widths of the 3.1 {$\mu$}m and 3.8 {$\mu$}m bands are systematically larger in LMC carbon stars than in carbon stars in the solar neighborhood. Moreover, the ratio of the equivalent widths of the 3.8 and 3.1 {$\mu$}m bands is much larger in the LMC, suggesting a higher ratio of n(C2H2)/n(HCN). The stronger absorption bands are in contrast to the assumption that if the elemental abundances are scaled from the carbon star's abundances in the solar neighbor, the abundances of these molecules are less at lower metallicity. We argue for a systematically larger C/O ratio in LMC carbon stars. In the Galactic carbon stars n(C)/n(O)\textasciitilde 1.05-1.1 on average; our chemical model shows that the stronger molecular bands in the LMC carbon stars could be explained with n(C)/n(O){$>$}1.2. The higher C/O ratio can also explain the higher ratio of n(C2H2)/n(HCN) in LMC stars than in the solar neighborhood. Based on observations obtained at the European Southern Observatory, Chile (proposal 68.D-0660).},
  keywords = {Galaxies: Magellanic Clouds,Infrared: Stars,Stars: Abundances,Stars: AGB and Post-AGB,Stars: Atmospheres,Stars: Carbon},
  annotation = {ADS Bibcode: 2002ApJ...580L.133M},
  file = {/Users/brett/Zotero/storage/WFDDA5CP/Matsuura et al. - 2002 - Very Large Telescope Spectra of Carbon Stars in the Large Magellanic Cloud and Their Metallicity Dep.pdf}
}

@article{Matthews:1983:149,
  title = {The Detection of Vinyl Cyanide in {{TMC-1}}.},
  author = {Matthews, H. E. and Sears, T. J.},
  year = 1983,
  month = sep,
  journal = {The Astrophysical Journal},
  volume = {272},
  pages = {149--153},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1086/161271},
  urldate = {2025-04-15},
  abstract = {Observations of four rotational transitions of vinyl cyanide (CH2CHCN) at wavelengths 3 cm and 1.5 cm are reported. The molecule has been detected in the dense dark cloud TMC-1 for the first time and the observed relative intensities of the hyperfine components are consistent with those expected under LTE conditions. The CH2CHCN column density in TMC-1 is three trillion/sq cm. Upper limits are reported for a number of other sources.},
  keywords = {Abundance,Acrylonitriles,Astrophysics,Electron Transitions,Hyperfine Structure,Interstellar Chemistry,Interstellar Matter,Line Spectra,Molecular Clouds,Molecular Rotation},
