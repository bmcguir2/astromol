  title = {First {{Astronomical Detection}} of the {{Cumulene Carbon Chain Molecule H}}{\textsubscript{2}}{{C}}{\textsubscript{6}} in  {{TMC-1}}},
  author = {Langer, W. D. and Velusamy, T. and Kuiper, T. B. H. and Peng, R. and McCarthy, M. C. and Travers, M. J. and Kov{\'a}cs, A. and Gottlieb, C. A. and Thaddeus, P.},
