  urldate = {2025-04-10},
  abstract = {Recent low-temperature laboratory measurements and astronomical observations have proved that the fullerene cation \textbraceleft\textbraceleft\textbraceleft C\textbraceright\textbraceright\textbraceright 60+ is responsible for four diffuse interstellar bands (DIBs). These absorptions correspond to the strongest bands of the lowest electronic transition. The gas phase spectrum below 10 \textbraceleft\textbraceleft K\textbraceright\textbraceright{} is reported here for the full wavelength range encompassed by the electronic transition. The absorption spectrum of \textbraceleft\textbraceleft\textbraceleft C\textbraceright\textbraceright\textbraceright 70+, with its origin band at 7959.2 \textbraceleft\textbraceleft\textbackslash mathringA \textbraceright\textbraceright, has been obtained under similar laboratory conditions. Observations made toward the reddened star \textbraceleft HD\textbraceright{} 183143 were used in a specific search for the absorption of these fullerene cations in diffuse clouds. In the case of \textbraceleft\textbraceleft\textbraceleft C\textbraceright\textbraceright\textbraceright 60+, one further band in the astronomical spectrum at 9348.5 \textbackslash mathringA is identified, increasing the total number of assigned DIBs to five. Numerous other \textbraceleft\textbraceleft\textbraceleft C\textbraceright\textbraceright\textbraceright 60+ absorptions in the laboratory spectrum are found to lie below the astronomical detection limit. Special emphasis is placed on the laboratory determination of absolute absorption cross-sections. For \textbraceleft\textbraceleft\textbraceleft C\textbraceright\textbraceright\textbraceright 60+ this directly yields a column density, N(\textbraceleft\textbraceleft\textbraceleft C\textbraceright\textbraceright\textbraceright 60+), of 2\texttimes{} \textbraceleft 10\textbraceright 13 \textbraceleft\textbraceleft\textbraceleft cm\textbraceright\textbraceright\textbraceright -2 in diffuse clouds, without the need to rely on theoretical oscillator strengths. The intensity of the \textbraceleft\textbraceleft\textbraceleft C\textbraceright\textbraceright\textbraceright 70+ electronic transition in the range 7000-8000 \AA{} is spread over many features of similar strength. Absorption cross-section measurements indicate that even for a similar column density, the individual absorption bands of \textbraceleft\textbraceleft\textbraceleft C\textbraceright\textbraceright\textbraceright 70+ will be too weak to be detected in the astronomical spectra, which is confirmed giving an upper limit of 2 \textbraceleft\textbraceleft m\textbackslash mathringA \textbraceright\textbraceright{} to the equivalent width. Based on observations obtained at the Canada-France-Hawaii Telescope (CFHT) which is operated by the National Research Council of Canada, the Institut National des Sciences de l'Univers of the Centre National de la Recherche Scientifique of France, and the University of Hawaii.},
  keywords = {ISM: molecules},
  annotation = {ADS Bibcode: 2016ApJ...822...17C},
  file = {/Users/brett/Zotero/storage/EPHKRWEV/Campbell et al. - 2016 - Gas Phase Absorption Spectroscopy of C+60 and C+70 in a Cryogenic Ion Trap Comparison with Astronom.pdf}
}

