}

@article{Martin:2003:L465,
  title = {First Detections of Extragalactic {{SO}}{\textsubscript{2}}, {{NS}} and {{NO}}},
  author = {Mart{\'i}n, S. and Mauersberger, R. and {Mart{\'i}n-Pintado}, J. and {Garc{\'i}a-Burillo}, S. and Henkel, C.},
  year = 2003,
  month = dec,
  journal = {Astronomy and Astrophysics},
  volume = {411},
  pages = {L465-L468},
  issn = {0004-6361},
  doi = {10.1051/0004-6361:20031442},
  urldate = {2025-04-15},
  abstract = {We report the first detections of SO2, NS and NO in an extragalactic source, the nucleus of the starburst galaxy NGC 253. Five SO2 transitions, three groups of hyperfine components of NO and five of NS were detected. All three species show large abundances averaged over the inner 200 pc of NGC 253. With a relative abundance of a few 10-7, the emission of the NO molecule is similar or even larger than that found in Galactic star forming regions. The derived relative molecular abundances for each molecule have been compared with those of prototypical Galactic molecular clouds. These results seem to confirm that large scale shocks dominate the chemistry of these molecules in the nucleus of NGC 253, ruling out a chemistry dominated by PDRs for the bulk of the gas.},
  keywords = {Astrophysics,galaxies: abundances,galaxies: individual: NGC 253,galaxies: ISM,galaxies: starburst,ISM: molecules},
