  issn = {0004-637X},
  doi = {10.1086/148817},
  urldate = {2025-04-14},
  abstract = {Following the failure of attempts to find the interstellar radio line of CH near 10 cm using the frequency predicte by Douglas and Elliott, a new interferometric investigation of the A2A-X2ll (0,0) band of CH at 4300 A was carried out to determine the frequency of the ground-level A-doubling transition. This objective has been achieved in two ways: (1) a prediction from A doubling in excited rotational lines using the van Vleck theory, and (2) a direct measurement of the A doubling in the J = 21 state. The former agrees with the Douglas and Elliott result, while the latter is 400 Mc/s less. Owing to the increased resolution of the present experiment over that of Douglas and Elliott, we can show that the second (direct) measurement is to be preferred. Hence, the van Vleck theory does not apply to the J = 2' state. The radio line is centered at Mc/s and not Mc/s as stated by Douglas and Elliott Small A doubling in the A state was found, and a more accurate determination of the fine-structure interaction constant of the 211 state was made.},
  annotation = {ADS Bibcode: 1966ApJ...145..707G},
  file = {/Users/brett/Zotero/storage/T95BUNSD/Goss - 1966 - A New Determination of the Frequency of the Interstellar Radio Line of CH.pdf}
}

