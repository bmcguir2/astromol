  journal = {The Astrophysical Journal},
  volume = {742},
  pages = {L21},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1088/2041-8205/742/2/L21},
  urldate = {2025-04-16},
  abstract = {We report the first detection of hydrogen fluoride (HF) toward a high-redshift quasar. Using the Caltech Submillimeter Observatory, we detect the HF J = 1-0 transition in absorption toward the Cloverleaf, a broad absorption line quasi-stellar object at z = 2.56. The detection is statistically significant at the \textasciitilde 6{$\sigma$} level. We estimate a lower limit of 4 \texttimes{} 1014 cm-2 for the HF column density and using a previous estimate of the hydrogen column density, we obtain a lower limit of 1.7 \texttimes{} 10-9 for the HF abundance. This value suggests that, assuming a Galactic N(HF)/N H ratio, HF accounts for at least \textasciitilde 10\% of the fluorine in the gas phase along the line of sight to the Cloverleaf quasar. This observation corroborates the prediction that HF should be a good probe of the molecular gas at high redshift. Measurements of the HF abundance as a function of redshift are urgently needed to better constrain the fluorine nucleosynthesis mechanism(s).},
  keywords = {astrochemistry,Astrophysics - Cosmology and Extragalactic Astrophysics,cosmology: observations,ISM: individual objects: Cloverleaf,ISM: molecules},
  annotation = {ADS Bibcode: 2011ApJ...742L..21M},
  file = {/Users/brett/Zotero/storage/FMC64Z92/Monje et al. - 2011 - Discovery of Hydrogen Fluoride in the Cloverleaf Quasar at z = 2.56.pdf}
}

@article{Monje:2013:81,
  title = {Hydrogen {{Chloride}} in {{Diffuse Interstellar Clouds}} along the {{Line}} of {{Sight}} to {{W31C}} ({{G10}}.6-0.4)},
