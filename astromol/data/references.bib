@article{Lee:2021:L11,
  title = {Discovery of {{Interstellar}} Trans-Cyanovinylacetylene ({{HC}} {$\equiv$} {{CCH}} = {{CHC}} {$\equiv$} {{N}}) and Vinylcyanoacetylene ({{H}}{\textsubscript{2}}{{C}} = {{CHC}}{\textsubscript{3}}{{N}}) in {{GOTHAM Observations}} of {{TMC-1}}},
  author = {Lee, Kin Long Kelvin and Loomis, Ryan A. and Burkhardt, Andrew M. and Cooke, Ilsa R. and Xue, Ci and Siebert, Mark A. and Shingledecker, Christopher N. and Remijan, Anthony and Charnley, Steven B. and McCarthy, Michael C. and McGuire, Brett A.},
  year = 2021,
  month = feb,
  journal = {The Astrophysical Journal},
  volume = {908},
  pages = {L11},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.3847/2041-8213/abdbb9},
  urldate = {2025-04-15},
  abstract = {We report the discovery of two unsaturated organic species, trans-(E)-cyanovinylacetylene and vinylcyanoacetylene, using the second data release of the GOTHAM deep survey toward TMC-1 with the 100 m Green Bank Telescope. For both detections, we performed velocity stacking and matched filter analyses using Markov Chain Monte Carlo simulations, and for trans-(E)-cyanovinylacetylene, three rotational lines were observed at low signal-to-noise ({$\sim$}3{$\sigma$}). From this analysis, we derive column densities of 2 \texttimes{} 1011 and 3 \texttimes{} 1011 cm-2 for vinylcyanoacetylene and trans-(E)-cyanovinylacetylene, respectively, and an upper limit of {$<$}2 \texttimes{} 1011 cm-2 for trans-(Z)-cyanovinylacetylene. Comparisons with G3//B3LYP semiempirical thermochemical calculations indicate abundances of the [H3C5N] isomers are not consistent with their thermodynamic stability, and instead their abundances are mainly driven by dynamics. We provide a discussion on how these species may be formed in TMC-1, with reference to related molecules like vinyl cyanide (CH2 = CHC {$\equiv$} N). As part of this discussion, we performed the same analysis for ethyl cyanide (CH3CH2C {$\equiv$} N), the hydrogenation product of CH2 = CHC {$\equiv$} N. This analysis provides evidence---at 4.2{$\sigma$} significance---of an upper limit to the column density of {$<$}4 \texttimes{} 1011 cm-2; an order of magnitude lower than previous upper limits toward this source.},
  keywords = {1072,2076,224,75,849,Astrochemistry,Astrophysics - Astrophysics of Galaxies,Chemical abundances,Interstellar molecules,Molecular clouds,Molecule formation},
  annotation = {ADS Bibcode: 2021ApJ...908L..11L},
  file = {/Users/brett/Zotero/storage/ZFCU486P/Lee et al. - 2021 - Discovery of Interstellar trans-cyanovinylacetylene (HC ≡ CCH = CHC ≡ N) and vinylcyanoacetylene (H2.pdf}
}

@article{Lee:2021:L2a,
  title = {Interstellar {{Detection}} of 2-Cyanocyclopentadiene, {{C}}{\textsubscript{5}}{{H}}{\textsubscript{5}}{{CN}}, a {{Second Five-membered Ring}} toward {{TMC-1}}},
  author = {Lee, Kin Long Kelvin and Changala, P. Bryan and Loomis, Ryan A. and Burkhardt, Andrew M. and Xue, Ci and Cordiner, Martin A. and Charnley, Steven B. and McCarthy, Michael C. and McGuire, Brett A.},
  year = 2021,
  month = mar,
  journal = {The Astrophysical Journal},
  volume = {910},
  pages = {L2},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.3847/2041-8213/abe764},
  urldate = {2025-04-15},
  abstract = {Using radio observations with the Green Bank Telescope, evidence has now been found for a second five-membered ring in the dense cloud Taurus Molecular Cloud-1 (TMC-1). Based on additional observations of an ongoing, large-scale, high-sensitivity spectral line survey (GOTHAM) at centimeter wavelengths toward this source, we have used a combination of spectral stacking, Markov Chain Monte Carlo (MCMC), and matched filtering techniques to detect 2-cyanocyclopentadiene, a low-lying isomer of 1-cyanocyclopentadiene, which was recently discovered there by the same methods. The new observational data also yield a considerably improved detection significance for the more stable isomer and evidence for several individual transitions between 23-32 GHz. Through our MCMC analysis, we derive cospatial, total column densities of 8.3 \texttimes{} 1011 and 1.9 \texttimes{} 1011 cm-2 for 1- and 2-cyanocyclopentadiene, respectively, corresponding to a ratio of {$\sim$}4.4 favoring the former. The derived abundance ratios point toward a common formation pathway---most likely being cyanation of cyclopentadiene by analogy to benzonitrile.},
  keywords = {2095,75,Astrochemistry,Astrophysics - Astrophysics of Galaxies,ISM,molecules},
  annotation = {ADS Bibcode: 2021ApJ...910L...2L},
  file = {/Users/brett/Zotero/storage/BEBP9KS9/Lee et al. - 2021 - Interstellar Detection of 2-cyanocyclopentadiene, C5H5CN, a Second Five-membered Ring toward TMC-1.pdf}
}

