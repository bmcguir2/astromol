@article{Cernicharo:2016:L4,
  title = {A Rigorous Detection of Interstellar {{CH}}{\textsubscript{3}}{{NCO}}: {{An}} Important Missing Species in Astrochemical Networks},
  shorttitle = {A Rigorous Detection of Interstellar {{CH3NCO}}},
  author = {Cernicharo, J. and Kisiel, Z. and Tercero, B. and Kolesnikov{\'a}, L. and Medvedev, I. R. and L{\'o}pez, A. and Fortman, S. and Winnewisser, M. and {de Lucia}, F. C. and Alonso, J. L. and Guillemin, J. -C.},
  year = 2016,
  month = feb,
  journal = {Astronomy and Astrophysics},
  volume = {587},
  pages = {L4},
  publisher = {EDP},
  issn = {0004-6361},
  doi = {10.1051/0004-6361/201527531},
  urldate = {2025-04-10},
  abstract = {The recent analysis of the composition of the frozen surface of comet 67P/Churyumov-Gerasimenko has revealed a significant number of complex organic molecules. Methyl isocyanate (CH3NCO) is one of the more abundant species detected on the comet surface. In this work we report extensive characterization of its rotational spectrum resulting in a list of 1269 confidently assigned laboratory lines and its detection in space towards the Orion clouds where 399 lines of the molecule have been unambiguously identified. We find that the limited mm-wave laboratory data reported prior to our work require some revision. The abundance of CH3NCO in Orion is only a factor of ten below those of HNCO and CH3CN. Unlike the molecular abundances in the coma of comets, which correlate with those of warm molecular clouds, molecular abundances in the gas phase in Orion are only weakly correlated with those measured on the comet surface. We also compare our abundances with those derived recently for this molecule towards Sgr B2 (Halfen et al. 2015, ApJ, 812, L5). A more accurate abundance of CH3NCO is provided for this cloud based on our extensive laboratory work. This paper makes use of the following ALMA data: ADS/JAO.ALMA\#2011.0.00009.SV. ALMA is a partnership of ESO (representing its member states), NSF (USA), and NINS (Japan) with NRC (Canada), NSC, and ASIAA (Taiwan), and KASI (Republic of Korea), in cooperation with the Republic of Chile. The Joint ALMA Observatory is operated by ESO, AUI/NRAO, and NAOJ. This work was also based on observations carried out with the IRAM 30-meter telescope. IRAM is supported by INSU/CNRS (France), MPG (Germany), and IGN (Spain).Full Table A.6 is only available at the CDS via anonymous ftp to http://cdsarc.u-strasbg.fr (ftp://130.79.128.5) or via http://cdsarc.u-strasbg.fr/viz-bin/qcat?J/A+A/587/L4},
  keywords = {ISM: abundances,ISM: clouds,ISM: individual objects: Orion KL,ISM: molecules,methods: laboratory: molecular,molecular data},
  annotation = {ADS Bibcode: 2016A\&A...587L...4C},
  file = {/Users/brett/Zotero/storage/C7RLMW6G/Cernicharo et al. - 2016 - A rigorous detection of interstellar CH3NCO An important missing species in astrochemical networks.pdf}
}

@article{Cernicharo:2017:L5,
  title = {Discovery of Methyl Silane and Confirmation of Silyl Cyanide in {{IRC}} +10216},
  author = {Cernicharo, J. and Ag{\'u}ndez, M. and Velilla Prieto, L. and Gu{\'e}lin, M. and Pardo, J. R. and Kahane, C. and Marka, C. and Kramer, C. and Navarro, S. and {Quintana-Lacaci}, G. and Fonfr{\'i}a, J. P. and Marcelino, N. and Tercero, B. and Moreno, E. and Massalkhi, S. and {Santander-Garc{\'i}a}, M. and McCarthy, M. C. and Gottlieb, C. A. and Alonso, J. L.},
  year = 2017,
  month = oct,
  journal = {Astronomy and Astrophysics},
  volume = {606},
  pages = {L5},
  issn = {0004-6361},
  doi = {10.1051/0004-6361/201731672},
  urldate = {2025-04-10},
  abstract = {We report the discovery in space of methyl silane, CH3SiH3, from observations of ten rotational transitions between 80 and 350 GHz (Ju from 4 to 16) with the IRAM 30 m radio telescope. The molecule was observed in the envelope of the C-star IRC +10216. The observed profiles and our models for the expected emission of methyl silane suggest that the it is formed in the inner zones of the circumstellar envelope, 1-40 R{$\ast$}, with an abundance of (0.5-1) \texttimes{} 10-8 relative to H2. We also observed several rotational transitions of silyl cyanide (SiH3CN), confirming its presence in IRC +10216 in particular, and in space in general. Our models indicate that silyl cyanide is also formed in the inner regions of the envelope, around 20 R{$\ast$}, with an abundance relative to H2 of 6 \texttimes{} 10-10. The possible formation mechanisms of both species are discussed. We also searched for related chemical species but only upper limits could be obtained. This work was based on observations carried out with the IRAM 30-m telescope. IRAM is supported by INSU/CNRS (France), MPG (Germany), and IGN (Spain).},
  keywords = {astrochemistry,stars: AGB and post-AGB,stars: carbon,stars: individual: IRC+10216},
  annotation = {ADS Bibcode: 2017A\&A...606L...5C},
  file = {/Users/brett/Zotero/storage/EFARVCHM/Cernicharo et al. - 2017 - Discovery of methyl silane and confirmation of silyl cyanide in IRC +10216.pdf}
}

@article{Cernicharo:2018:L22,
  title = {Discovery of the {{Ubiquitous Cation NS}}{\textsuperscript{+}} in {{Space Confirmed}} by {{Laboratory Spectroscopy}}},
  author = {Cernicharo, J. and Lefloch, B. and Ag{\'u}ndez, M. and Bailleux, S. and Margul{\`e}s, L. and Roueff, E. and Bachiller, R. and Marcelino, N. and Tercero, B. and Vastel, C. and Caux, E.},
  year = 2018,
  month = feb,
  journal = {The Astrophysical Journal},
  volume = {853},
  pages = {L22},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.3847/2041-8213/aaa83a},
  urldate = {2025-04-10},
  abstract = {We report the detection in space of a new molecular species that has been characterized spectroscopically and fully identified from astrophysical data. The observations were carried out with the IRAM 30 m telescope. The molecule is ubiquitous as its J=2\textbackslash to 1 transition has been found in cold molecular clouds, prestellar cores, and shocks. However, it is not found in the hot cores of Orion-KL and in the carbon-rich evolved star IRC+10216. Three rotational transitions in perfect harmonic relation J\textbackslash prime =2/3/5 have been identified in the prestellar core B1b. The molecule has a 1{$\Sigma$} electronic ground state and its J=2\textbackslash to 1 transition presents the hyperfine structure characteristic of a molecule containing a nucleus with spin 1. A careful analysis of possible carriers shows that the best candidate is NS+. The derived rotational constant agrees within 0.3\%-0.7\% with ab initio calculations. NS+ was also produced in the laboratory to unambiguously validate the astrophysical assignment. The observed rotational frequencies and determined molecular constants confirm the discovery of the nitrogen sulfide cation in space. The chemistry of NS+ and related nitrogen-bearing species has been analyzed by means of a time-dependent gas-phase model. The model reproduces well the observed NS/NS+ abundance ratio, in the range 30-50, and indicates that NS+ is formed by reactions of the neutral atoms N and S with the cations SH+ and NH+, respectively.},
  keywords = {Astrophysics - Astrophysics of Galaxies,ISM: clouds,line: identification,molecular data,radio lines: ISM},
  annotation = {ADS Bibcode: 2018ApJ...853L..22C},
  file = {/Users/brett/Zotero/storage/L5VQKRZR/Cernicharo et al. - 2018 - Discovery of the Ubiquitous Cation NS+ in Space Confirmed by Laboratory Spectroscopy.pdf}
}

@article{Cernicharo:2019:A34,
  title = {Broad-Band High-Resolution Rotational Spectroscopy for Laboratory Astrophysics},
  author = {Cernicharo, J. and Gallego, J. D. and {L{\'o}pez-P{\'e}rez}, J. A. and Tercero, F. and Tanarro, I. and Beltr{\'a}n, F. and {de Vicente}, P. and Lauwaet, K. and Alem{\'a}n, B. and Moreno, E. and Herrero, V. J. and Dom{\'e}nech, J. L. and Ram{\'i}rez, S. I. and Berm{\'u}dez, C. and Pel{\'a}ez, R. J. and {Patino-Esteban}, M. and {L{\'o}pez-Fern{\'a}ndez}, I. and {Garc{\'i}a-{\'A}lvaro}, S. and {Garc{\'i}a-Carre{\~n}o}, P. and Cabezas, C. and Malo, I. and Amils, R. and Sobrado, J. and {Diez-Gonz{\'a}lez}, C. and Hernand{\'e}z, J. M. and Tercero, B. and Santoro, G. and Mart{\'i}nez, L. and Castellanos, M. and Vaquero Jim{\'e}nez, B. and Pardo, J. R. and Barbas, L. and {L{\'o}pez-Fern{\'a}ndez}, J. A. and Aja, B. and Leuther, A. and {Mart{\'i}n-Gago}, J. A.},
  year = 2019,
  month = jun,
  journal = {Astronomy and Astrophysics},
  volume = {626},
  pages = {A34},
  publisher = {EDP},
  issn = {0004-6361},
  doi = {10.1051/0004-6361/201935197},
  urldate = {2025-04-14},
  abstract = {We present a new experimental set-up devoted to the study of gas phase molecules and processes using broad-band high spectral resolution rotational spectroscopy. A reactor chamber is equipped with radio receivers similar to those used by radio astronomers to search for molecular emission in space. The whole range of the Q (31.5-50 GHz) and W bands (72-116.5 GHz) is available for rotational spectroscopy observations. The receivers are equipped with 16 \texttimes{} 2.5 GHz fast Fourier transform spectrometers with a spectral resolution of 38.14 kHz allowing the simultaneous observation of the complete Q band and one-third of the W band. The whole W band can be observed in three settings in which the Q band is always observed. Species such as CH3CN, OCS, and SO2 are detected, together with many of their isotopologues and vibrationally excited states, in very short observing times. The system permits automatic overnight observations, and integration times as long as 2.4 \texttimes{} 105 s have been reached. The chamber is equipped with a radiofrequency source to produce cold plasmas, and with four ultraviolet lamps to study photochemical processes. Plasmas of CH4, N2, CH3CN, NH3, O2, and H2, among other species, have been generated and the molecular products easily identified by the rotational spectrum, and via mass spectrometry and optical spectroscopy. Finally, the rotational spectrum of the lowest energy conformer of CH3CH2NHCHO (N-ethylformamide), a molecule previously characterized in microwave rotational spectroscopy, has been measured up to 116.5 GHz, allowing the accurate determination of its rotational and distortion constants and its search in space. Tables C.1 and C.2 are only available at the CDS via anonymous ftp to http://cdsarc.u-strasbg.fr (ftp://130.79.128.5) or via http://cdsarc.u-strasbg.fr/viz-bin/qcat?J/A+A/626/A34},
  keywords = {line: identification,methods: laboratory: molecular,molecular data,molecular processes,plasmas},
  annotation = {ADS Bibcode: 2019A\&A...626A..34C},
  file = {/Users/brett/Zotero/storage/JW799D5N/Cernicharo et al. - 2019 - Broad-band high-resolution rotational spectroscopy for laboratory astrophysics.pdf}
}

@article{Cernicharo:2019:L2,
  title = {Discovery of Two New Magnesium-Bearing Species in {{IRC}}+10216: {{MgC}}{\textsubscript{3}}{{N}} and {{MgC}}{\textsubscript{4}}{{H}}},
  shorttitle = {Discovery of Two New Magnesium-Bearing Species in {{IRC}}+10216},
  author = {Cernicharo, J. and Cabezas, C. and Pardo, J. R. and Ag{\'u}ndez, M. and Berm{\'u}dez, C. and {Velilla-Prieto}, L. and Tercero, F. and {L{\'o}pez-P{\'e}rez}, J. A. and Gallego, J. D. and Fonfr{\'i}a, J. P. and {Quintana-Lacaci}, G. and Gu{\'e}lin, M. and Endo, Y.},
  year = 2019,
  month = oct,
  journal = {Astronomy and Astrophysics},
  volume = {630},
  pages = {L2},
  issn = {0004-6361},
  doi = {10.1051/0004-6361/201936372},
  urldate = {2025-04-10},
  abstract = {We report on the detection of two series of harmonically related doublets in IRC +10216. From the observed frequencies, the rotational constant of the first series is B = 1380.888 MHz and that of the second series is B = 1381.512 MHz. The two series correspond to two species with a 2{$\Sigma$} electronic ground state. After considering all possible candidates, and based on quantum chemical calculations, the first series is assigned to MgC3N and the second to MgC4H. For the latter species, optical spectroscopy measurements support its identification. Unlike diatomic metal-containing molecules, the line profiles of the two new molecules indicate that they are formed in the outer layers of the envelope, as occurs for MgNC and other polyatomic metal-cyanides. We also confirm the detection of MgCCH that was previously reported from the observation of two doublets. The relative abundance of MgC3N with respect to MgNC is close to one while that of MgC4H relative to MgCCH is about ten. The synthesis of these magnesium cyanides and acetylides in IRC +10216 can be explained in terms of a two-step process initiated by the radiative association of Mg+ with large cyanopolyynes and polyynes followed by the dissociative recombination of the ionic complexes. Based on observations carried out with the IRAM 30 m telescope and the Yebes 40 m telescope. IRAM is supported by INSU/CNRS (France), MPG (Germany) and IGN (Spain). The 40 m radiotelescope at Yebes Observatory is operated by the Spanish Geographic Institute (IGN, Ministerio de Fomento).},
  keywords = {astrochemistry,circumstellar matter,line: identification,molecular data,stars: carbon,stars: individual: IRC+10216},
  annotation = {ADS Bibcode: 2019A\&A...630L...2C},
  file = {/Users/brett/Zotero/storage/62T33P58/Cernicharo et al. - 2019 - Discovery of two new magnesium-bearing species in IRC+10216 MgC3N and MgC4H.pdf}
}

@article{Cernicharo:2019:L4,
  title = {Discovery of the First {{Ca-bearing}} Molecule in Space: {{CaNC}}},
  shorttitle = {Discovery of the First {{Ca-bearing}} Molecule in Space},
  author = {Cernicharo, J. and {Velilla-Prieto}, L. and Ag{\'u}ndez, M. and Pardo, J. R. and Fonfr{\'i}a, J. P. and {Quintana-Lacaci}, G. and Cabezas, C. and Berm{\'u}dez, C. and Gu{\'e}lin, M.},
  year = 2019,
  month = jul,
  journal = {Astronomy and Astrophysics},
  volume = {627},
  pages = {L4},
  issn = {0004-6361},
  doi = {10.1051/0004-6361/201936040},
  urldate = {2025-04-10},
  abstract = {We report on the detection of calcium isocyanide, CaNC, in the carbon-rich evolved star IRC+10216. We derived a column density for this species of (2 \textpm{} 0.5) \texttimes{} 1011 cm-2. Based on the observed line profiles and the modelling of its emission through the envelope, the molecule has to be produced in the intermediate and outer layers of the circumstellar envelope where other metal-isocyanides have previously been found in this source. The abundance ratio of CaNC relative to MgNC and FeCN is {$\simeq$}1/60 and {$\simeq$}1, respectively. We searched for the species CaF, CaCl, CaC, CaCCH, and CaCH3 for which accurate frequency predictions are available. Only upper limits have been obtained for these molecules. This work was based on observations carried out with the IRAM 30 m telescope. IRAM is supported by INSU/CNRS (France), MPG (Germany) and IGN (Spain).},
  keywords = {astrochemistry,Astrophysics - Astrophysics of Galaxies,Astrophysics - Solar and Stellar Astrophysics,circumstellar matter,line: identification,molecular data,Physics - Chemical Physics,stars: carbon,stars: individual: IRC+10216},
  annotation = {ADS Bibcode: 2019A\&A...627L...4C},
  file = {/Users/brett/Zotero/storage/2NMYB53V/Cernicharo et al. - 2019 - Discovery of the first Ca-bearing molecule in space CaNC.pdf}
}

@article{Cernicharo:2020:L17,
  title = {Discovery of {{HC}}{\textsubscript{3}}{{O}}{\textsuperscript{+}} in Space: {{The}} Chemistry of {{O-bearing}} Species in {{TMC-1}}},
  shorttitle = {Discovery of {{HC3O}}+ in Space},
  author = {Cernicharo, J. and Marcelino, N. and Ag{\'u}ndez, M. and Endo, Y. and Cabezas, C. and Berm{\'u}dez, C. and Tercero, B. and {de Vicente}, P.},
  year = 2020,
  month = oct,
  journal = {Astronomy and Astrophysics},
  volume = {642},
  pages = {L17},
  issn = {0004-6361},
  doi = {10.1051/0004-6361/202039351},
  urldate = {2025-04-10},
  abstract = {Using the Yebes 40m and IRAM 30m radio telescopes, we detected a series of harmonically related lines with a rotational constant B0 = 4460.590 \textpm{} 0.001 MHz and a distortion constant D0 = 0.511 \textpm{} 0.005 kHz towards the cold dense core TMC-1. High-level-of-theory ab initio calculations indicate that the best possible candidate is protonated tricarbon monoxide, HC3O+. We have succeeded in producing this species in the laboratory and observed its Ju - Jl = 2-1 and 3-2 rotational transitions. Hence, we report the discovery of HC3O+ in space based on our observations, theoretical calculations, and laboratory experiments. We derive an abundance ratio N(C3O)/N(HC3O+) {$\sim$} 7. The high abundance of the protonated form of C3O is due to the high proton affinity of the neutral species. The chemistry of O-bearing species is modelled, and predictions are compared to the derived abundances from our data for the most prominent O-bearing species in TMC-1. Based on observations carried out with the Yebes 40m telescope (projects 19A003 and 20A014) and the Institut de Radioastronomie Millim\'etrique (IRAM) 30m telescope. The 40m radio telescope at Yebes Observatory is operated by the Spanish Geographic Institute (IGN, Ministerio de Transportes, Movilidad y Agenda Urbana); IRAM is supported by INSU/CNRS (France), MPG (Germany), and IGN (Spain).},
  keywords = {astrochemistry,Astrophysics - Astrophysics of Galaxies,ISM: individual objects: TMC-1,ISM: molecules,line: identification,molecular data},
  annotation = {ADS Bibcode: 2020A\&A...642L..17C},
  file = {/Users/brett/Zotero/storage/63J76SK6/Cernicharo et al. - 2020 - Discovery of HC3O+ in space The chemistry of O-bearing species in TMC-1.pdf}
}

@article{Cernicharo:2020:L8,
  title = {Discovery of {{HC}}{\textsubscript{4}}{{NC}} in {{TMC-1}}: {{A}} Study of the Isomers of {{HC}}{\textsubscript{3}}{{N}}, {{HC}}{\textsubscript{5}}{{N}}, and {{HC}}{\textsubscript{7}}{{N}}},
  shorttitle = {Discovery of {{HC4NC}} in {{TMC-1}}},
  author = {Cernicharo, J. and Marcelino, N. and Ag{\'u}ndez, M. and Berm{\'u}dez, C. and Cabezas, C. and Tercero, B. and Pardo, J. R.},
  year = 2020,
  month = oct,
  journal = {Astronomy and Astrophysics},
  volume = {642},
  pages = {L8},
  issn = {0004-6361},
  doi = {10.1051/0004-6361/202039274},
  urldate = {2025-04-10},
  abstract = {We present a study of the isocyano isomers of the cyanopolyynes HC3N, HC5N, and HC7N in TMC-1 and IRC+10216 carried out with the Yebes 40m radio telescope. This study has enabled us to report the detection, for the first time in space, of HCCCCNC in TMC-1 and to give upper limits for HC6NC in the same source. In addition, the deuterated isotopologues of HCCNC and HNCCC were detected, along with all 13C substitutions of HCCNC, also for the first time in space. The abundance ratios of HC3N and HC5N, with their isomers, are very different in TMC-1 and IRC+10216, namely, N(HC5N)/N(HC4NC) is {$\sim$}300 and {$\geq$}2100, respectively. We discuss the chemistry of the metastable isomers of cyanopolyynes in terms of the most likely formation pathways and by comparing observational abundance ratios between different sources. Based on observations carried out with the Yebes 40m telescope (projects 19A003, 19A010, 20A014). The 40m radiotelescope at Yebes Observatory is operated by the Spanish Geographic Institute (IGN, Ministerio de Transportes, Movilidad y Agenda Urbana).},
  keywords = {Astrophysics - Astrophysics of Galaxies,ISM: individual objects: TMC-1,ISM: molecules,line: identification,molecular data,stars: individual: IRC+10216},
  annotation = {ADS Bibcode: 2020A\&A...642L...8C},
  file = {/Users/brett/Zotero/storage/6YQ7LZ9X/Cernicharo et al. - 2020 - Discovery of HC4NC in TMC-1 A study of the isomers of HC3N, HC5N, and HC7N.pdf}
}

