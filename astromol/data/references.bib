@article{Amano:2008:244305,
  title = {Extended Negative Glow and ``hollow Anode'' Discharges for Submillimeter-Wave Observation of {{CN-}}, {{C2H-}}, and {{C4H-}}},
  author = {Amano, T.},
  year = 2008,
  month = dec,
