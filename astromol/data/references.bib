@article{Lockwood:2014:L29,
  title = {Near-{{IR Direct Detection}} of {{Water Vapor}} in {{Tau Bo\"otis}} b},
  author = {Lockwood, Alexandra C. and Johnson, John A. and Bender, Chad F. and Carr, John S. and Barman, Travis and Richert, Alexander J. W. and Blake, Geoffrey A.},
  year = 2014,
  month = mar,
  journal = {The Astrophysical Journal},
  volume = {783},
  pages = {L29},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1088/2041-8205/783/2/L29},
  urldate = {2025-04-15},
  abstract = {We use high dynamic range, high-resolution L-band spectroscopy to measure the radial velocity (RV) variations of the hot Jupiter in the {$\tau$} Bo\"otis planetary system. The detection of an exoplanet by the shift in the stellar spectrum alone provides a measure of the planet's minimum mass, with the true mass degenerate with the unknown orbital inclination. Treating the {$\tau$} Boo system as a high flux ratio double-lined spectroscopic binary permits the direct measurement of the planet's true mass as well as its atmospheric properties. After removing telluric absorption and cross-correlating with a model planetary spectrum dominated by water opacity, we measure a 6{$\sigma$} detection of the planet at Kp = 111 \textpm{} 5 km s-1, with a 1{$\sigma$} upper limit on the spectroscopic flux ratio of 10-4. This RV leads to a planetary orbital inclination of i = 45\textasciicircum\textbraceleft +3\textbraceright\_\textbraceleft -4\textbraceright{$^\circ$} and a mass of M\_\textbraceleft P\textbraceright{} = 5.90\textasciicircum\textbraceleft +0.35\textbraceright\_\textbraceleft -0.20\textbraceright\textbackslash,M\_Jup. We report the first detection of water vapor in the atmosphere of a non-transiting hot Jupiter, {$\tau$} Boo b.},
  keywords = {Astrophysics - Earth and Planetary Astrophysics,planets and satellites: atmospheres,techniques: spectroscopic},
  annotation = {ADS Bibcode: 2014ApJ...783L..29L},
  file = {/Users/brett/Zotero/storage/H4AQABDU/Lockwood et al. - 2014 - Near-IR Direct Detection of Water Vapor in Tau Boötis b.pdf}
}

