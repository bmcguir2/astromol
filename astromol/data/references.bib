@article{Suzuki:1986:911,
  title = {Detection of the Interstellar {{C}}{\textsubscript{6}}{{H}} Radical},
  author = {Suzuki, Hiroko and Ohishi, Masatoshi and Kaifu, Norio and Ishikawa, Shin-Ichi and Kasuga, Takashi},
  year = 1986,
  month = jan,
  journal = {Publications of the Astronomical Society of Japan},
  volume = {38},
  pages = {911--917},
  publisher = {OUP},
  issn = {0004-6264},
  urldate = {2025-04-17},
  abstract = {The authors have detected three doublets at 23.6, 40.2, and 43.0 GHz from TMC-1. They have identified these lines as the J = 17/2 - 15/2, J = 29/2 - 27/2, and J = 31/2 - 29/2 transitions of a new interstellar radical in the 2{$\Pi$}3/2 state. The molecular constants of the radical have been determined. On the basis of the rotational constant obtained and the doublet hyperfine structure for the {$\Lambda$}-type components of the J = 17/2 - 15/2 transition, the authors have concluded that the radical responsible for the spectral lines detected is C6H. The relative abundances of CnH (n = 2 - 6) are also discussed.},
  keywords = {Astronomical Spectroscopy,Astrophysics,Hydrocarbons,Interstellar Chemistry,Interstellar Matter,Line Spectra,Molecular Chains,Molecular Clouds,Molecular Energy Levels,Radicals},
  annotation = {ADS Bibcode: 1986PASJ...38..911S},
